        </div>

        <div class="tm-story-blocks">
          <div class="tm-story-row">
            <div class="tm-story-media">
              <span class="tm-story-badge">Deep Barrier Seal</span>
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/spp_shopify20260902180016_763ec67413b8b02e5219b8b03d2dbddb_5fb90228-b7ce-4264-ac29-6d5184bb3d27.jpg?v=1793736111" alt="Moisture Barrier Protection" class="tm-story-img" width="600" height="400" loading="lazy">
