{% comment %}
  TRYMALORA - HOW IT WORKS & PRODUCT STORYTELLING (SECTIONS XIV.B & XV)
  Dynamic per product: Alternating editorial rows + 3-step setup band.
{% endcomment %}

<style>
  .tm-hiw-section {
    padding: 72px 0;
    background: var(--zv-pdp-bg, #FFF8F5);
    border-top: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-hiw-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 56px;
  }

  .tm-hiw-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-tint, #F8E4EB);
    color: var(--zv-pdp-accent, #B0476E);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .tm-hiw-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.18;
    letter-spacing: -0.6px;
    margin: 0 0 14px;
  }

  @media screen and (min-width: 768px) {
    .tm-hiw-title {
      font-size: 40px;
    }
  }

  .tm-hiw-subtitle {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  .tm-story-blocks {
    display: flex;
    flex-direction: column;
    gap: 64px;
    margin-bottom: 72px;
  }

  .tm-story-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media screen and (min-width: 860px) {
    .tm-story-row {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
    .tm-story-row.reverse {
      direction: rtl;
    }
    .tm-story-row.reverse > * {
      direction: ltr;
    }
  }

  .tm-story-media {
    position: relative;
    border-radius: var(--zv-radius-lg, 16px);
    overflow: hidden;
    background: #FFFFFF;
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    box-shadow: 0 8px 30px rgba(43, 27, 36, 0.06);
  }

  .tm-story-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-cta, #6B1E46);
    color: #FFFFFF;
  }

  .tm-story-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .tm-story-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--zv-pdp-accent, #B0476E);
    margin-bottom: 8px;
  }

  .tm-story-heading {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.25;
    letter-spacing: -0.4px;
    margin: 0 0 14px;
  }

  @media screen and (min-width: 768px) {
    .tm-story-heading {
      font-size: 30px;
    }
  }

  .tm-story-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0 0 20px;
  }

  .tm-story-checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tm-story-checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
  }

  .tm-story-check-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--zv-pdp-ok-tint, #E5F2EA);
    color: var(--zv-pdp-ok, #3F8F6B);
    font-size: 13px;
    font-weight: 900;
    flex-shrink: 0;
  }

  /* 3-Step Setup Band */
  .tm-setup-band {
    background: var(--zv-pdp-surface, #FBEDE8);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-radius: var(--zv-radius-lg, 16px);
    padding: 40px 32px;
    box-shadow: 0 4px 20px rgba(43, 27, 36, 0.04);
  }

  .tm-setup-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    text-align: center;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 8px;
  }

  .tm-setup-sub {
    font-size: 14px;
    text-align: center !important;
    color: var(--zv-pdp-muted, #7A6670);
    margin: 0 auto 32px auto !important;
    max-width: 600px;
    display: block;
  }

  .tm-setup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    text-align: center;
  }

  .tm-setup-num {
    width: 40px;
    height: 40px;
    line-height: 40px;
    border-radius: 50%;
    background: var(--zv-pdp-cta, #6B1E46);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 800;
    margin: 0 auto 12px;
  }

  .tm-setup-step-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 6px;
  }

  .tm-setup-step-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }
</style>

<section class="tm-hiw-section" id="tmHowItWorks">
  <div class="zv-container" style="max-width: 1140px; margin: 0 auto; padding: 0 24px;">

    {% case product.handle %}
      {% when 'car-metal-rust-repair-paste' %}
