{% comment %}
  TRYMALORA - PRODUCT PAGE V2 BUY BOX HERO (ROUND 2: SHOPSIDEK T01 VISUAL MATCH)
  Tasks 1-12: Typography hierarchy (Fraunces + Inter), Warm blush/plum palette,
  Review row above title, Live viewers pill, Kaching-style bundle cards,
  Two-line CTA button, 3-step delivery stepper, Mini review card,
  Native payment icons without container header, Refined minimal accordions.
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}
{{ 'zavelyn-v4-pdp.css' | asset_url | stylesheet_tag }}

{% assign variant_tier_1 = nil %}
{% assign variant_tier_2 = nil %}
{% assign variant_tier_3 = nil %}

{% if product.variants.size > 0 %}
  {% for v in product.variants %}
    {% assign t_title = v.title | downcase %}
    {% if t_title contains '1 set' or t_title contains 'starter' or t_title contains 'single' %}
      {% assign variant_tier_1 = v %}
    {% elsif t_title contains '2 set' or t_title contains 'duo' or t_title contains 'double' %}
      {% assign variant_tier_2 = v %}
    {% elsif t_title contains '3 set' or t_title contains 'family' or t_title contains 'triple' or t_title contains 'arena' %}
      {% assign variant_tier_3 = v %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign prod_title = product.title | default: "Infrared Laser Battle Set" %}

{% case product.handle %}
  {% when 'car-metal-rust-repair-paste' %}
    {% assign prod_hero_desc = "High-viscosity paste formula penetrates micro-pores, halts active corrosion, and creates a durable waterproof barrier on car metal." %}
  {% when 'metal-chrome-polish-restorer-paste' %}
    {% assign prod_hero_desc = "Heavy-duty chrome polishing cream that eliminates oxidation, road grime, and water spots to restore a brilliant mirror shine." %}
  {% when 'mini-dual-purpose-travel-styling-iron' %}
    {% assign prod_hero_desc = "Compact 2-in-1 ceramic styling iron engineered for effortless silky straight strands and bouncy curls at home or on the go." %}
  {% when 'tile-refinishing-paint-restoration-kit' %}
    {% assign prod_hero_desc = "Waterproof high-gloss tile and tub refinishing paint that covers deep stains and renews outdated tiles without replacement." %}
  {% when 'metallic-silver-anti-rust-renovation-coating' %}
    {% assign prod_hero_desc = "Water-based high-gloss metallic silver coating that converts rust and shields metal gates, pipes, and railings from weathering." %}
  {% when 'ear-cleaner' %}
    {% assign prod_hero_desc = "Veterinarian-formulated botanical ear wash that dissolves deep wax buildup, neutralizes yeast odor, and stops frantic head shaking in under 2 minutes." %}
  {% when 'eyvelle-steam-therapy' %}
    {% assign prod_hero_desc = "Ophthalmologist-recommended ultrasonic warm nano-steam therapy that gently unblocks meibomian oil glands, restores natural tear film, and eliminates dry, burning, tired eyes in just 5 minutes." %}
  {% when 'christmas-lantern-welcome-gnome' %}
    {% assign prod_hero_desc = "Charming handcrafted woodland gnome with a warm-white illuminated star lantern, festive knitted hat, and lush evergreen boughs that bring cozy holiday magic to your home." %}
  {% else %}
    {% assign prod_hero_desc = "Turn ordinary playtime into an interactive adventure with infrared battles, projected targets, and exciting sound effects." %}
{% endcase %}

{% if product.handle == 'metallic-silver-anti-rust-renovation-coating' %}
  {% assign default_v = product.variants[0] %}
  {% assign t1_id = default_v.id %}
  {% assign t1_price = default_v.price | default: 9995 %}
  {% assign t1_compare = t1_price %}
  {% assign t2_v = product.variants[1] %}
  {% assign t2_id = t2_v.id %}
  {% assign t2_price = t2_v.price | default: 5997 %}
  {% assign t2_compare = t2_price %}
  {% assign t3_v = product.variants[2] %}
  {% assign t3_id = t3_v.id %}
  {% assign t3_price = t3_v.price | default: 1999 %}
  {% assign t3_compare = t3_price %}
{% elsif product.handle == 'ear-cleaner' %}
  {% assign ear_v1 = product.variants[0] %}
  {% assign ear_v2 = product.variants[1] %}
  {% assign ear_v3 = product.variants[2] %}
  {% assign default_v = ear_v2 | default: product.variants[0] %}
  {% assign t1_id = default_v.id %}
  {% assign t1_price = 5668 %}
  {% assign t1_compare = 13996 %}
  {% assign t1_savings = 8328 %}
  {% assign t2_id = ear_v3.id %}
  {% assign t2_price = ear_v3.price | default: 11197 %}
  {% assign t2_compare = 27992 %}
  {% assign t3_id = ear_v1.id %}
  {% assign t3_price = ear_v1.price | default: 3499 %}
  {% assign t3_compare = 6999 %}
{% elsif product.handle == 'eyvelle-steam-therapy' %}
  {% assign eye_v1 = product.variants[0] %}
  {% assign eye_v2 = product.variants[1] %}
  {% assign eye_v3 = product.variants[2] %}
  {% assign default_v = eye_v2 | default: product.variants[0] %}
  {% assign t1_id = default_v.id %}
  {% assign t1_price = default_v.price | default: 6998 %}
  {% assign t1_compare = default_v.compare_at_price | default: 17000 %}
  {% assign t1_savings = t1_compare | minus: t1_price %}
  {% assign t2_id = eye_v3.id %}
  {% assign t2_price = eye_v3.price | default: 9497 %}
  {% assign t2_compare = 25500 %}
  {% assign t3_id = eye_v1.id %}
  {% assign t3_price = eye_v1.price | default: 3999 %}
  {% assign t3_compare = 8500 %}
{% elsif product.handle == 'christmas-lantern-welcome-gnome' %}
  {% assign gnome_v1 = product.variants[0] %}
  {% assign gnome_v2 = product.variants[1] %}
  {% assign gnome_v3 = product.variants[2] %}
  {% assign default_v = gnome_v2 | default: product.variants[0] %}
  {% assign t1_id = default_v.id %}
  {% assign t1_price = default_v.price | default: 11998 %}
  {% assign t1_compare = default_v.compare_at_price | default: 27996 %}
  {% assign t1_savings = t1_compare | minus: t1_price %}
  {% assign t2_id = gnome_v3.id %}
  {% assign t2_price = gnome_v3.price | default: 15998 %}
  {% assign t2_compare = 41994 %}
  {% assign t3_id = gnome_v1.id %}
  {% assign t3_price = gnome_v1.price | default: 6999 %}
  {% assign t3_compare = 13998 %}
{% elsif product.handle != 'kids-infrared-battle-blaster-set-with-target-projector' and product.variants.size > 0 %}
  {% assign default_v = product.selected_or_first_available_variant %}
  {% assign t1_id = default_v.id %}
  {% assign t1_price = default_v.price %}
  {% assign t1_compare = default_v.compare_at_price | default: default_v.price %}
  {% assign t2_id = default_v.id %}
  {% assign t2_price = default_v.price %}
  {% assign t2_compare = default_v.compare_at_price | default: default_v.price %}
  {% assign t3_id = default_v.id %}
  {% assign t3_price = default_v.price %}
  {% assign t3_compare = default_v.compare_at_price | default: default_v.price %}
{% else %}
  {% assign t1_id = variant_tier_1.id | default: "67297621934451" %}
  {% assign t1_price = variant_tier_1.price | default: 12900 %}
  {% assign t1_compare = variant_tier_1.compare_at_price | default: 25800 %}
  {% assign t2_id = variant_tier_2.id | default: "67297622131059" %}
  {% assign t2_price = variant_tier_2.price | default: 24510 %}
  {% assign t2_compare = 51600 %}
  {% assign t3_id = variant_tier_3.id | default: "67297622163827" %}
  {% assign t3_price = variant_tier_3.price | default: 32895 %}
  {% assign t3_compare = 77400 %}
{% endif %}

{% assign t1_savings = t1_compare | minus: t1_price %}
{% assign t2_savings = t2_compare | minus: t2_price %}
{% assign t3_savings = t3_compare | minus: t3_price %}

{% assign base_price_dollars = t1_price | divided_by: 100.0 %}
{% assign threshold_setting = section.settings.merchandising_threshold | default: 50 %}
{% assign order_setting = section.settings.bundle_order_override | default: 'auto' %}

{% if order_setting == 'ascending' %}
  {% assign is_ascending = true %}
{% elsif order_setting == 'descending' %}
  {% assign is_ascending = false %}
{% else %}
  {% if base_price_dollars >= threshold_setting %}
    {% assign is_ascending = true %}
  {% else %}
    {% assign is_ascending = false %}
  {% endif %}
{% endif %}

<section 
  class="zv-pdp-hero" 
  id="zvBuyBox"
  data-initial-variant-id="{{ t1_id }}"
  data-initial-price="{{ t1_price }}"
  data-initial-compare="{{ t1_compare }}"
>
  <div class="zv-container" style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
    <div class="zv-pdp-grid">

      <!-- LEFT COLUMN: STICKY GALLERY (SHOPSIDEK T01 PROPORTIONS) -->
      <div class="zv-pdp-gallery-col">
        <div class="zv-pdp-main-media">
          {% assign image_badge = "TOP RATED · KIDS & FAMILY" %}
          {% case product.handle %}
            {% when 'car-metal-rust-repair-paste' %}
              {% assign image_badge = "TOP RATED · AUTO CARE" %}
            {% when 'metal-chrome-polish-restorer-paste' %}
              {% assign image_badge = "TOP RATED · AUTO CARE" %}
            {% when 'mini-dual-purpose-travel-styling-iron' %}
              {% assign image_badge = "TOP RATED · BEAUTY CARE" %}
            {% when 'tile-refinishing-paint-restoration-kit' %}
              {% assign image_badge = "TOP RATED · HOME RESTORATION" %}
            {% when 'tile-refinishing-paint-restoration-kit-draft' %}
              {% assign image_badge = "TOP RATED · HOME RESTORATION" %}
            {% when 'metallic-silver-anti-rust-renovation-coating' %}
              {% assign image_badge = "TOP RATED · HOME & REPAIR" %}
            {% when 'ear-cleaner' %}
              {% assign image_badge = "TOP RATED · PET HEALTH & CARE" %}
            {% when 'eyvelle-steam-therapy' %}
              {% assign image_badge = "TOP RATED · EYE HEALTH & WELLNESS" %}
            {% when 'christmas-lantern-welcome-gnome' %}
              {% assign image_badge = "TOP RATED · HOLIDAY & HOME" %}
          {% endcase %}
          <span class="zv-pdp-save-badge">{{ image_badge }}</span>

          {% if product.handle contains 'tile-refinishing' %}
            <video 
              id="zvMainVideo" 
              class="zv-pdp-video" 
              src="https://cdn.shopify.com/videos/c/o/v/22d393cbbfef4b1fa48284f0595279e4.mp4" 
              playsinline 
              muted 
              controls 
              style="display:none;"
            ></video>
          {% elsif product.handle == 'eyvelle-steam-therapy' %}
            <video 
              id="zvMainVideo" 
              class="zv-pdp-video" 
              src="https://cdn.shopify.com/videos/c/o/v/a7ddafb14ed04e9a96204a0a0bbffc50.mp4" 
              playsinline 
              muted 
              controls 
              loop
              style="display:none;"
            ></video>
          {% endif %}

          {% if product.featured_image %}
            {% assign main_img_url = product.featured_image | image_url: width: 1024 %}
            {% if main_img_url contains '75187355-b515-479c-b765-d8223db49fa6' and product.images.size > 1 %}
              {% assign main_img_url = product.images[1] | image_url: width: 1024 %}
            {% endif %}
            <img 
              id="zvMainImg" 
              src="{{ main_img_url }}" 
              alt="{{ prod_title | escape }}" 
              class="zv-pdp-main-img"
              width="600"
              height="600"
              loading="eager"
            >
          {% else %}
            <img 
              id="zvMainImg" 
              src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" 
              alt="{{ prod_title | escape }}" 
              class="zv-pdp-main-img"
              width="600"
              height="600"
              loading="eager"
            >
          {% endif %}
        </div>

        <!-- Thumbnails -->
        <div class="zv-pdp-thumbs">
          {% if product.images.size > 1 %}
            {% assign first_thumb = true %}
            {% for img in product.images %}
              {% assign img_url_str = img | image_url %}
              {% unless img_url_str contains '75187355-b515-479c-b765-d8223db49fa6' %}
                <div class="zv-pdp-thumb {% if first_thumb %}active{% endif %}" data-src="{{ img | image_url: width: 1024 }}">
                  <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | escape }}" width="80" height="80" loading="lazy">
                </div>
                {% if first_thumb and product.handle contains 'tile-refinishing' %}
                  <div class="zv-pdp-thumb video-thumb" data-is-video="true" data-video-src="https://cdn.shopify.com/videos/c/o/v/22d393cbbfef4b1fa48284f0595279e4.mp4">
                    <img src="{{ img | image_url: width: 160 }}" alt="Tile Refinishing Video Application" width="80" height="80" loading="lazy">
                    <span class="zv-thumb-video-icon">
                      <svg viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
                    </span>
                  </div>
                {% elsif first_thumb and product.handle == 'eyvelle-steam-therapy' %}
                  <div class="zv-pdp-thumb video-thumb" data-is-video="true" data-video-src="https://cdn.shopify.com/videos/c/o/v/a7ddafb14ed04e9a96204a0a0bbffc50.mp4">
                    <img src="https://cdn.shopify.com/s/files/1/0759/4072/4979/files/Woman_Eyvelle_Steam_5.webp" alt="Eyvelle Steam Therapy Live Video Demonstration" width="80" height="80" loading="lazy">
                    <span class="zv-thumb-video-icon">
                      <svg viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
                    </span>
                  </div>
                {% endif %}
                {% assign first_thumb = false %}
              {% endunless %}
            {% endfor %}
          {% else %}
            <div class="zv-pdp-thumb active" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" alt="Target Projector and Blasters" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png" alt="Dynamic Target Training" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png" alt="Multiplayer Battle Mode" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_e96c06fafc655ed1c5a79a0092569a05_bad627ce-b9fb-4776-a2d7-d7b05627f978.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_e96c06fafc655ed1c5a79a0092569a05_bad627ce-b9fb-4776-a2d7-d7b05627f978.png" alt="Tactical Blaster Details" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_862c2dbbf724bdf5df0e5e1d41358221_bf119adc-cdd4-4354-9562-5d9331655a01.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_862c2dbbf724bdf5df0e5e1d41358221_bf119adc-cdd4-4354-9562-5d9331655a01.jpg" alt="Indoor Action Arena" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_2ea8000740ee44a3bd5efaf5393b4a39_9a3d2c37-afea-4c82-9305-1162ca8663bf.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_2ea8000740ee44a3bd5efaf5393b4a39_9a3d2c37-afea-4c82-9305-1162ca8663bf.jpg" alt="Three Step Setup" width="80" height="80" loading="lazy">
            </div>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT COLUMN: BUY BOX (SHOPSIDEK T01 EDITORIAL FLOW) -->
      <div class="zv-pdp-info-col">

        <!-- 1. Trustpilot Verified Review Rating Row (ABOVE product title) -->
        {% if section.settings.show_rating %}
          <a class="zv-pdp-rating-row zv-trustpilot-row" href="#tmFaqSection" aria-label="Trustpilot Rating">
            <span class="zv-tp-brand">
              <svg class="zv-tp-icon" viewBox="0 0 24 24" fill="#00B67A" width="16" height="16" aria-hidden="true">
                <path d="M12 2l2.9 8.2H23l-6.5 5 2.5 8-7-4.9-7 4.9 2.5-8L1 10.2h8.1z"/>
              </svg>
              <span class="zv-tp-name">Trustpilot</span>
            </span>
            <div class="zv-tp-star-boxes" aria-label="5 out of 5 stars">
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
            </div>
            <span class="zv-tp-score"><strong>{{ section.settings.rating_score | default: "4.9" }}</strong> / 5.0</span>
            <span class="zv-tp-sep">&middot;</span>
            {% assign prod_reviews_count = section.settings.rating_count | default: "2,418" %}
            {% if product.handle == 'metallic-silver-anti-rust-renovation-coating' %}
              {% assign prod_reviews_count = "6,268" %}
            {% elsif product.handle == 'ear-cleaner' %}
              {% assign prod_reviews_count = "5,420" %}
            {% elsif product.handle == 'eyvelle-steam-therapy' %}
              {% assign prod_reviews_count = "1,615" %}
            {% elsif product.handle == 'christmas-lantern-welcome-gnome' %}
              {% assign prod_reviews_count = "2,840" %}
            {% endif %}
            <span class="zv-tp-count">({{ prod_reviews_count }} {{ section.settings.rating_label | default: "verified reviews" }})</span>
          </a>
        {% endif %}

        <!-- 2. Product Title (Fraunces Serif, Dominant & Elegant) -->
        <h1 class="zv-pdp-title">{{ prod_title }}</h1>

        <!-- 3. Short Description / Promise -->
        <p class="zv-pdp-lead">
          {{ prod_hero_desc }}
        </p>

        <!-- 4. Benefit Bullets with Relevant Icons -->
        <ul class="zv-pdp-benefits">
          {% case product.handle %}
            {% when 'car-metal-rust-repair-paste' %}
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>High-Viscosity Formula Penetrates Micro-Pores &amp; Locks Out Moisture</span>
              </li>
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg>
                <span>Restores Surface Integrity &amp; Halts Active Corrosion</span>
              </li>
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Direct Brush-On Application With Fast-Drying Protective Layer</span>
              </li>
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="4"></circle><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path></svg>
                <span>Universal Multi-Color Finish Matches Automotive Body &amp; Trim</span>
              </li>
            {% when 'metal-chrome-polish-restorer-paste' %}
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>Removes Heavy Oxidation, Water Spots &amp; Surface Tarnishing</span>
              </li>
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path></svg>
                <span>Restores Mirror-Like Chrome Luster Without Scratches</span>
              </li>
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <span>Includes Dedicated Application Brush for Crevices &amp; Lug Nuts</span>
              </li>
              <li>
                <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Long-Lasting Hydrophobic Barrier Repels Grime &amp; Road Salt</span>
              </li>
