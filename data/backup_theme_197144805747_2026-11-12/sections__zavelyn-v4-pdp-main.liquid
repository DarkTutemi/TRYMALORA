<!-- STICKY ATC BAR ON SCROLL -->
<div class="zv-sticky-bar" id="zvStickyBar" role="region" aria-label="Quick Add to Cart">
  <div class="zv-sticky-prod-info">
    <img src="{{ product.featured_image | image_url: width: 100 | default: 'https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg' }}" alt="{{ prod_title | escape }}" class="zv-sticky-thumb" width="44" height="44">
    <div>
      <div class="zv-sticky-name">{{ prod_title }}</div>
      <div class="zv-sticky-price" id="zvStickyPrice">{{ t1_price | money }}</div>
    </div>
  </div>
  <button type="button" class="zv-btn-atc" id="zvStickyBtn" style="min-height: 48px; padding: 8px 24px;">
    <span class="zv-atc-main" id="zvStickyBtnLabel">ADD TO CART &middot; {{ t1_price | money }}</span>
  </button>
</div>

<script type="application/json" id="zvTileVariantMatrix">
  {
    {% for v in product.variants %}
      "{{ v.title }}": {
        "id": "{{ v.id }}",
        "price": {{ v.price }},
        "compareAt": {{ v.compare_at_price | default: v.price }},
        "available": {{ v.available }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

<script src="{{ 'zavelyn-v4-pdp.js' | asset_url }}" defer></script>

