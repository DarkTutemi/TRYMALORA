<section class="uo-reviews-section">
  <div class="uo-wrap">
    {%- if section.settings.enable_review_app and section.settings.review_app_snippet != blank -%}
      <div class="uo-reviews-app-container">
        <h2 class="uo-heading-serif" style="text-align:center;margin-bottom:24px;">{{ section.settings.title }}</h2>
        {{ section.settings.review_app_snippet }}
      </div>
    {%- else -%}
      <div class="uo-reviews-grid">
        <!-- Left Column: Intro -->
        <div class="uo-reviews-intro">
          <span class="uo-eyebrow" style="display:inline-block;margin-bottom:8px;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--uo-plum);">CRAFTSMANSHIP & DESIGN</span>
          <h2 class="uo-heading-serif">{{ section.settings.title }}</h2>
          <p>{{ section.settings.subhead }}</p>
        </div>

        <!-- Right: 3 Product Standards Cards -->
        <div class="uo-reviews-cards">
          <!-- Standard 1 -->
          <div class="uo-review-card">
            <div>
              <div class="uo-review-quote" style="color:var(--uo-plum);font-size:14.5px;margin-bottom:8px;">Full-Spine™ Architecture</div>
              <div class="uo-review-body">
                A continuous front-to-back coverage concept with contoured sides designed for nighttime movement.
              </div>
            </div>
            <div class="uo-reviewer-info" style="margin-top:16px;border-top:1px solid #F0E6EA;padding-top:12px;">
              <span style="font-size:11.5px;font-weight:700;color:var(--uo-charcoal);text-transform:uppercase;letter-spacing:0.06em;">Design Standard 01</span>
            </div>
          </div>

          <!-- Standard 2 -->
          <div class="uo-review-card">
            <div>
              <div class="uo-review-quote" style="color:var(--uo-plum);font-size:14.5px;margin-bottom:8px;">CloudFlex™ Soft Touch</div>
              <div class="uo-review-body">
                Soft-touch fabric selection is intended to balance comfort and flexibility while resting.
              </div>
            </div>
            <div class="uo-reviewer-info" style="margin-top:16px;border-top:1px solid #F0E6EA;padding-top:12px;">
              <span style="font-size:11.5px;font-weight:700;color:var(--uo-charcoal);text-transform:uppercase;letter-spacing:0.06em;">Sensory Standard 02</span>
            </div>
          </div>

          <!-- Standard 3 -->
          <div class="uo-review-card">
            <div>
              <div class="uo-review-quote" style="color:var(--uo-plum);font-size:14.5px;margin-bottom:8px;">WashGuard™ Durability</div>
              <div class="uo-review-body">
                Designed to be rinsed, gently washed and reused; actual wash-life performance remains subject to sample testing.
              </div>
            </div>
            <div class="uo-reviewer-info" style="margin-top:16px;border-top:1px solid #F0E6EA;padding-top:12px;">
              <span style="font-size:11.5px;font-weight:700;color:var(--uo-charcoal);text-transform:uppercase;letter-spacing:0.06em;">Longevity Standard 03</span>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ultra Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Thoughtfully Engineered For Restful Nights"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Designed around the feeling of comfort and the details that matter during nighttime wear."
    },
    {
      "type": "checkbox",
      "id": "enable_review_app",
      "label": "Enable 3rd-Party Review App Embed",
      "default": false,
      "info": "Check when authentic reviews are collected via Judge.me, Loox, or Shopify Reviews"
    },
    {
      "type": "liquid",
      "id": "review_app_snippet",
      "label": "Review App Liquid / HTML Snippet"
    }
  ],
  "presets": [
    {
      "name": "Ultra Reviews"
    }
  ]
}
{% endschema %}
