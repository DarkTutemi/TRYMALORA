<section class="uo-pillars-section" id="ultra-technology">
  <div class="uo-wrap">
    <div class="uo-pillars-header">
      <span class="uo-eyebrow">{{ section.settings.eyebrow | default: 'ENGINEERING INNOVATION' }}</span>
      <h2 class="uo-heading-serif uo-pillars-title">{{ section.settings.title | default: 'The Seven Pillars of ULTRA OVERNIGHT™' }}</h2>
      <p class="uo-pillars-subhead">{{ section.settings.subhead | default: 'Thoughtfully engineered for overnight protection, lasting comfort, and real peace of mind.' }}</p>
    </div>

    <p class="uo-claims-note">Development concepts only. Construction details and performance are subject to factory and laboratory validation.</p>
    <div class="uo-pillars-grid">
      <!-- Pillar 1: VelaLock™ Core -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            <rect x="9" y="11" width="6" height="5" rx="1"></rect>
          </svg>
        </div>
        <div class="uo-pillar-name">VelaLock™ Core</div>
        <div class="uo-pillar-benefit">Absorbent Core Concept</div>
        <p class="uo-pillar-desc">Proposed multi-layer absorbent core intended to capture and retain fluid; capacity and rewet performance await independent testing.</p>
      </div>

      <!-- Pillar 2: SpineHalo™ Shield -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c0 6-3 12-8 16-5-4-8-10-8-16z"></path>
          </svg>
        </div>
        <div class="uo-pillar-name">SpineHalo™ Shield</div>
        <div class="uo-pillar-benefit">True Front-to-Back Coverage</div>
        <p class="uo-pillar-desc">Continuous absorbent shield spans from the pelvic line across the full seat to the top of the waistband, keeping sheets secure all night.</p>
      </div>

      <!-- Pillar 3: SeraSeal™ Contour -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8l-4 4 4 4"></path>
            <path d="M6 8l4 4-4 4"></path>
          </svg>
        </div>
        <div class="uo-pillar-name">SeraSeal™ Contour</div>
        <div class="uo-pillar-benefit">Adaptive Side Leak Barrier</div>
        <p class="uo-pillar-desc">Anatomically contoured leg openings with double-stitch channeling that flex with restless tossing, turning, and side-sleeping positions.</p>
      </div>

      <!-- Pillar 4: AeriDry™ Touch -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </div>
        <div class="uo-pillar-name">AeriDry™ Touch</div>
        <div class="uo-pillar-benefit">Fast Moisture-Wicking Comfort</div>
        <p class="uo-pillar-desc">Proposed soft-touch top fabric designed around moisture transfer and skin comfort. Material specifications and wicking rates are pending tests.</p>
      </div>

      <!-- Pillar 5: OdorVeil™ -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </div>
        <div class="uo-pillar-name">OdorVeil™</div>
        <div class="uo-pillar-benefit">Natural Odor Neutralization</div>
        <p class="uo-pillar-desc">Breathable non-toxic mineral infusion neutralizes moisture-related odors naturally without synthetic perfumes or skin irritants.</p>
      </div>

      <!-- Pillar 6: CloudFlex™ Knit -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
          </svg>
        </div>
        <div class="uo-pillar-name">CloudFlex™ Knit</div>
        <div class="uo-pillar-benefit">Buttery Second-Skin Softness</div>
        <p class="uo-pillar-desc">Ultra-fine modal and elastane weave delivers gentle 4-way stretch, offering a feather-light hug without rolling, digging, or bulk.</p>
      </div>

      <!-- Pillar 7: WashGuard™ -->
      <div class="uo-pillar-card">
        <div class="uo-pillar-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="3"></rect>
            <circle cx="12" cy="13" r="5"></circle>
            <circle cx="6" cy="6" r="1"></circle>
          </svg>
        </div>
        <div class="uo-pillar-name">WashGuard™</div>
        <div class="uo-pillar-benefit">Long-Lasting Reusability</div>
        <p class="uo-pillar-desc">Reinforced bonded laminations engineered to withstand cold machine washing and repeated nighttime cycles without losing softness.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ultra Seven Pillars",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ENGINEERING INNOVATION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Seven Pillars of ULTRA OVERNIGHT™"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheadline",
      "default": "Thoughtfully engineered for overnight protection, lasting comfort, and real peace of mind."
    }
  ],
  "presets": [
    {
      "name": "Ultra Seven Pillars"
    }
  ]
}
{% endschema %}

