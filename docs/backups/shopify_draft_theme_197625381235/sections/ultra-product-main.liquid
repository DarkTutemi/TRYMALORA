{%- liquid
  assign current_product = nil
  assign current_variant = nil
  assign has_real_product = false
  assign can_purchase = false

  if product != blank and product.handle == 'full-spine-ultra-overnight'
    assign current_product = product
    assign has_real_product = true
    assign current_variant = current_product.selected_or_first_available_variant
    if current_variant == blank
      assign current_variant = current_product.variants.first
    endif
    if current_variant != blank and current_variant.price > 0 and current_variant.available and current_product.published_at != blank
      assign can_purchase = true
    endif
  endif
-%}

<section class="uo-pdp-section">
  <div class="uo-wrap">
    <div class="uo-pdp-grid">
      <!-- Left: Gallery -->
      <div class="uo-gallery-wrap">
        <!-- Vertical Thumbnails -->
        <div class="uo-thumbnails-col">
          {%- if has_real_product and current_product.images.size > 1 -%}
            {%- for image in current_product.images limit: 4 -%}
              <button type="button" class="uo-thumb-btn {% if forloop.first %}is-active{% endif %}" data-image-src="{{ image | image_url: width: 800 }}" aria-label="Thumbnail {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: current_product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="uo-thumb-btn is-active" data-image-src="{{ 'ultra-pdp-main.jpg' | asset_url }}" aria-label="Thumbnail 1">
              <img src="{{ 'ultra-thumb-front.jpg' | asset_url }}" alt="Front View" loading="eager">
            </button>
            <button type="button" class="uo-thumb-btn" data-image-src="{{ 'ultra-thumb-box.jpg' | asset_url }}" aria-label="Thumbnail 2">
              <img src="{{ 'ultra-thumb-box.jpg' | asset_url }}" alt="Packaging Box" loading="lazy">
            </button>
            <button type="button" class="uo-thumb-btn" data-image-src="{{ 'ultra-thumb-texture.jpg' | asset_url }}" aria-label="Thumbnail 3">
              <img src="{{ 'ultra-thumb-texture.jpg' | asset_url }}" alt="Fabric Texture" loading="lazy">
            </button>
            <button type="button" class="uo-thumb-btn" data-image-src="{{ 'ultra-thumb-lifestyle.jpg' | asset_url }}" aria-label="Thumbnail 4">
              <img src="{{ 'ultra-thumb-lifestyle.jpg' | asset_url }}" alt="Lifestyle Sleep" loading="lazy">
            </button>
          {%- endif -%}
        </div>

        <!-- Main Featured Image -->
        <div class="uo-main-image-wrap">
          <img 
            src="{% if has_real_product and current_product.featured_image %}{{ current_product.featured_image | image_url: width: 800 }}{% else %}{{ 'ultra-pdp-main.jpg' | asset_url }}{% endif %}" 
            alt="{% if has_real_product and current_product.featured_image %}{{ current_product.title | escape }}{% else %}Concept product visualization for FULL-SPINE ULTRA OVERNIGHT™{% endif %}" 
            class="uo-main-image"
            width="500" 
            height="500"
            loading="eager"
          >
        </div>
      </div>

      <!-- Right: Buy Box -->
      <div class="uo-buybox">
        <div class="uo-product-category">OVERNIGHT PERIOD UNDERWEAR</div>
        <h1 class="uo-heading-serif uo-product-title">
          {%- if has_real_product -%}
            {{ current_product.title }}
          {%- else -%}
            FULL-SPINE ULTRA OVERNIGHT™
          {%- endif -%}
        </h1>

        <!-- Rating (Rendered dynamically only when verified review metafields exist) -->
        {%- if has_real_product and current_product.metafields.reviews.rating.value != blank -%}
          <div class="uo-pdp-rating-row">
            <span class="uo-pdp-rating-stars">★★★★★</span>
            <span class="uo-pdp-rating-score">{{ current_product.metafields.reviews.rating.value.rating | round: 1 }}</span>
            <span class="uo-pdp-rating-count">({{ current_product.metafields.reviews.rating_count.value }} verified reviews)</span>
          </div>
        {%- endif -%}

        <!-- Price -->
        <div class="uo-price-row">
          <span class="uo-price-current">
            {%- if has_real_product and current_variant.price > 0 -%}
              {{ current_variant.price | money }}
            {%- else -%}
              Pricing to be confirmed
            {%- endif -%}
          </span>

        </div>

        <!-- Short Description -->
        <div class="uo-pdp-desc">
          {%- if has_real_product and current_product.description != blank -%}
            {{ current_product.description | strip_html | truncatewords: 30 }}
          {%- else -%}
            Designed for heavy-flow nights, with full-spine coverage and 5-layer protection to help prevent leaks so you can sleep with confidence.
          {%- endif -%}
        </div>

        <!-- Key Bullets -->
        <ul class="uo-pdp-bullets">
          <li class="uo-pdp-bullet-item">
            <span class="uo-check-icon">✓</span>
            Full-spine coverage for extended, stay-in-place protection
          </li>
          <li class="uo-pdp-bullet-item">
            <span class="uo-check-icon">✓</span>
            5-layer design that helps lock in moisture and prevent leaks
          </li>
          <li class="uo-pdp-bullet-item">
            <span class="uo-check-icon">✓</span>
            Soft, breathable, and comfortable for all-night wear
          </li>
        </ul>

        <!-- Variant Options (if real product with multiple variants) -->
        {%- if has_real_product and current_product.has_only_default_variant == false -%}
          <div class="uo-product-options">
            {%- for option in current_product.options_with_values -%}
              <div class="uo-option-group" data-option-index="{{ forloop.index0 }}">
                <div class="uo-tier-section-title" style="margin-top:12px;margin-bottom:6px;font-size:13px;text-transform:uppercase;letter-spacing:0.05em;">
                  Select {{ option.name }}: <span class="uo-option-selected-label" style="font-weight:600;color:var(--uo-plum);">{{ option.selected_value }}</span>
                </div>
                <div class="uo-option-pills" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;">
                  {%- for value in option.values -%}
                    <button 
                      type="button" 
                      class="uo-option-pill {% if option.selected_value == value %}is-active{% endif %}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}" 
                      data-option-name="{{ option.name }}" 
                      data-option-value="{{ value | escape }}"
                      style="padding:6px 14px;border:1px solid {% if option.selected_value == value %}var(--uo-plum){% else %}#D9CCD0{% endif %};border-radius:4px;background:{% if option.selected_value == value %}var(--uo-plum){% else %}#ffffff{% endif %};color:{% if option.selected_value == value %}#ffffff{% else %}var(--uo-charcoal){% endif %};font-size:13px;cursor:pointer;font-family:var(--uo-font-sans);"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <p class="uo-pdp-promise">Made for the nights when comfort matters most.</p>
        <!-- Pick Your Pack Tiers -->
        <div class="uo-tier-section-title">Pick Your Pack</div>
        <div class="uo-tier-cards" role="radiogroup" aria-label="Choose a pack size">
          <!-- 1 Pair -->
          <div 
            class="uo-tier-card" role="radio" aria-checked="false" tabindex="-1" 
            data-tier="1-pair" 
            data-pack-qty="1"
            data-tier-price="{% if has_real_product and current_variant.price > 0 %}{{ current_variant.price | divided_by: 100.0 }}{% else %}0{% endif %}"
            {% if has_real_product %}data-variant-id="{{ current_variant.id }}"{% endif %}
          >
            <div class="uo-tier-header">
              <span class="uo-tier-name">1 Pair</span>
              <div class="uo-tier-radio"></div>
            </div>
            <div class="uo-tier-price">
              {%- if has_real_product and current_variant.price > 0 -%}
                {{ current_variant.price | money }}
              {%- else -%}
                TBD
              {%- endif -%}
            </div>
            <div class="uo-tier-unit">
              {%- if has_real_product and current_variant.price > 0 -%}
                ({{ current_variant.price | money }}/each)
              {%- else -%}
                (Price to be confirmed)
              {%- endif -%}
            </div>
          </div>

          <!-- 3 Pairs (Most Popular) -->
          <div 
            class="uo-tier-card is-selected" role="radio" aria-checked="true" tabindex="0" 
            data-tier="3-pairs" 
            data-pack-qty="3"
            data-tier-price="{% if has_real_product and current_variant.price > 0 %}{{ current_variant.price | times: 3 | divided_by: 100.0 | round: 2 }}{% else %}0{% endif %}"
            {% if has_real_product %}data-variant-id="{{ current_variant.id }}"{% endif %}
          >
            <span class="uo-tier-badge">MULTI-PAIR</span>
            <div class="uo-tier-header">
              <span class="uo-tier-name">3 Pairs</span>
              <div class="uo-tier-radio"></div>
            </div>
            <div class="uo-tier-price">
              {%- if has_real_product and current_variant.price > 0 -%}
                {{ current_variant.price | times: 3 | money }}
              {%- else -%}
                TBD
              {%- endif -%}
            </div>
            <div class="uo-tier-unit">
              {%- if has_real_product and current_variant.price > 0 -%}
                ({{ current_variant.price | money }}/each)
              {%- else -%}
                (Price to be confirmed)
              {%- endif -%}
            </div>
          </div>

          <!-- 5 Pairs -->
          <div 
            class="uo-tier-card" role="radio" aria-checked="false" tabindex="-1" 
            data-tier="5-pairs" 
            data-pack-qty="5"
            data-tier-price="{% if has_real_product and current_variant.price > 0 %}{{ current_variant.price | times: 5 | divided_by: 100.0 | round: 2 }}{% else %}0{% endif %}"
            {% if has_real_product %}data-variant-id="{{ current_variant.id }}"{% endif %}
          >
            <div class="uo-tier-header">
              <span class="uo-tier-name">5 Pairs</span>
              <div class="uo-tier-radio"></div>
            </div>
            <div class="uo-tier-price">
              {%- if has_real_product and current_variant.price > 0 -%}
                {{ current_variant.price | times: 5 | money }}
              {%- else -%}
                TBD
              {%- endif -%}
            </div>
            <div class="uo-tier-unit">
              {%- if has_real_product and current_variant.price > 0 -%}
                ({{ current_variant.price | money }}/each)
              {%- else -%}
                (Price to be confirmed)
              {%- endif -%}
            </div>
          </div>
        </div>

        <!-- Quantity & Add to Cart -->
        <div class="uo-atc-row">
          <div class="uo-qty-wrap">
            <button type="button" class="uo-qty-btn uo-qty-minus" aria-label="Decrease quantity">−</button>
            <span class="uo-qty-val">1</span>
            <button type="button" class="uo-qty-btn uo-qty-plus" aria-label="Increase quantity">+</button>
          </div>

          {%- if can_purchase -%}
            <button type="button" class="uo-btn-primary uo-pdp-atc-btn" data-has-product="true">ADD TO CART</button>
          {%- elsif has_real_product and current_product.published_at != blank and current_variant.price > 0 -%}
            <button type="button" class="uo-btn-primary uo-pdp-atc-btn uo-btn-disabled" disabled="disabled" data-has-product="false">SOLD OUT</button>
          {%- else -%}
            <button type="button" class="uo-btn-primary uo-pdp-atc-btn uo-btn-disabled" disabled="disabled" data-has-product="false">COMING SOON</button>
          {%- endif -%}
        </div>

        {%- unless can_purchase -%}
          <div class="uo-admin-setup-notice" style="margin-top:10px;font-size:12.5px;color:#7A6670;line-height:1.45;text-align:center;padding:10px 14px;background:#F9F2F4;border:1px dashed #D9B8C4;border-radius:6px;">
            <strong>Pre-production:</strong> Sizes and colors are concept options. Pricing and availability will be confirmed before launch.
          </div>
        {%- endunless -%}

        <div class="uo-pdp-error-msg" style="display:none;margin-top:10px;padding:8px 12px;background:#fef2f2;border:1px solid #f87171;border-radius:4px;color:#b91c1c;font-size:13px;"></div>

        <div class="uo-pdp-footnote">Final specifications and pricing are subject to product testing and approval. This pre-production draft is not available for purchase.</div>

        <!-- Trust Badges -->
        <div class="uo-trust-badges-row">
          <!-- Fast Shipping -->
          <div class="uo-trust-item">
            <svg class="uo-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span class="uo-trust-label">Made for<br>Night Comfort</span>
          </div>

          <!-- 30-Day Guarantee -->
          <div class="uo-trust-item">
            <svg class="uo-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
            <span class="uo-trust-label">30-Day<br>Guarantee</span>
          </div>

          <!-- Secure Checkout -->
          <div class="uo-trust-item">
            <svg class="uo-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="uo-trust-label">Secure<br>Checkout</span>
          </div>

          <!-- Shop Pay -->
          <div class="uo-trust-item">
            <svg class="uo-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
            <span class="uo-trust-label">Easy<br>Care</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- if has_real_product -%}
  <script type="application/json" id="uo-product-variants-json">
    {{ current_product.variants | json }}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Ultra Product Main",
  "settings": [],
  "presets": [
    {
      "name": "Ultra Product Main"
    }
  ]
}
{% endschema %}
