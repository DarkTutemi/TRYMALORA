<section class="uo-page-hero">
  <div class="uo-wrap">
    <span class="uo-eyebrow">ORDER STATUS &amp; TRACKING</span>
    <h1 class="uo-heading-serif uo-page-hero-title">Track Your Shipment</h1>
    <p class="uo-page-hero-desc">
      Real-time carrier tracking links are delivered directly to your email upon dispatch. You can also view your full order history or contact our care team below.
    </p>
  </div>
</section>

<section class="uo-page-content-wrap">
  <div class="uo-wrap">
    <div class="uo-track-box" style="max-width: 640px; margin: 0 auto; background: var(--uo-white); padding: 36px 32px; border-radius: var(--uo-radius-md); border: 1px solid var(--uo-border); box-shadow: var(--uo-shadow-sm);">
      
      <!-- Lookup Form -->
      <form class="uo-track-form" id="uoTrackLookupForm" onsubmit="handleUoTrackLookup(event)">
        <div class="uo-input-group" style="margin-bottom: 16px;">
          <label for="uoOrderNum" style="display:block; font-family: var(--uo-font-sans); font-size: 13px; font-weight: 600; color: var(--uo-charcoal); margin-bottom: 6px;">
            Order Number
          </label>
          <input type="text" id="uoOrderNum" class="uo-input-control" placeholder="e.g. #1042" required style="width: 100%; height: 46px; border: 1px solid var(--uo-border); border-radius: var(--uo-radius-sm); padding: 0 14px; font-size: 14px; font-family: var(--uo-font-sans);">
        </div>

        <div class="uo-input-group" style="margin-bottom: 20px;">
          <label for="uoEmail" style="display:block; font-family: var(--uo-font-sans); font-size: 13px; font-weight: 600; color: var(--uo-charcoal); margin-bottom: 6px;">
            Order Email Address
          </label>
          <input type="email" id="uoEmail" class="uo-input-control" placeholder="you@example.com" required style="width: 100%; height: 46px; border: 1px solid var(--uo-border); border-radius: var(--uo-radius-sm); padding: 0 14px; font-size: 14px; font-family: var(--uo-font-sans);">
        </div>

        <button type="submit" class="uo-btn-primary" id="uoTrackSubmitBtn" style="width: 100%; padding: 14px; font-size: 14px; font-weight: 700; letter-spacing: 0.05em; border: none; cursor: pointer;">
          LOOK UP ORDER STATUS ➔
        </button>
      </form>

      <!-- Honest Guidance Result Box (Replaces hardcoded fake shipment result) -->
      <div id="uoTrackGuidance" style="display: none; margin-top: 24px; padding: 20px; background: #FAF7F5; border: 1px solid var(--uo-dusty-rose); border-radius: var(--uo-radius-sm); font-family: var(--uo-font-sans); font-size: 13.5px; line-height: 1.55; color: var(--uo-charcoal);">
        <div style="font-weight: 700; color: var(--uo-plum); margin-bottom: 6px; font-size: 14.5px;">
          Order Status Information
        </div>
        <p style="margin: 0 0 12px 0;">
          For order security, live real-time carrier tracking numbers are issued directly via your automated <strong>Shopify Shipment Confirmation Email</strong>. Please check your inbox (and spam folder) for an email from <code>support@trymalora.com</code>.
        </p>
        <p style="margin: 0 0 16px 0;">
          If you have a registered customer account, you can also log in to view active fulfillments.
        </p>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/account" class="uo-btn-secondary" style="flex: 1; min-width: 160px; text-align: center; padding: 10px 14px; font-size: 13px; text-decoration: none;">
            VIEW ACCOUNT ORDERS
          </a>
          <a id="uoSupportEmailLink" href="mailto:support@trymalora.com" class="uo-btn-primary" style="flex: 1; min-width: 160px; text-align: center; padding: 10px 14px; font-size: 13px; text-decoration: none;">
            CONTACT SUPPORT ➔
          </a>
        </div>
      </div>

      <!-- General Fulfillment Details -->
      <div style="margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--uo-border); font-family: var(--uo-font-sans); font-size: 13px; color: var(--uo-body-text); line-height: 1.5;">
        <div style="font-weight: 700; color: var(--uo-charcoal); margin-bottom: 4px;">Fulfillment &amp; Delivery Standards:</div>
        • Orders are processed and packed within 1–2 business days.<br>
        • Standard US delivery takes 3–5 business days following carrier dispatch.<br>
        • Need assistance? Contact our care team at <a href="mailto:support@trymalora.com" style="color:var(--uo-plum);font-weight:600;text-decoration:underline;">support@trymalora.com</a>.
      </div>
    </div>
  </div>
</section>

<script>
  function handleUoTrackLookup(e) {
    e.preventDefault();
    const orderNum = document.getElementById('uoOrderNum').value.trim();
    const email = document.getElementById('uoEmail').value.trim();
    const guidance = document.getElementById('uoTrackGuidance');
    const supportLink = document.getElementById('uoSupportEmailLink');

    if (orderNum && email && guidance) {
      guidance.style.display = 'block';
      if (supportLink) {
        const subject = encodeURIComponent('Order Status Inquiry — ' + orderNum);
        const body = encodeURIComponent('Hello ULTRA OVERNIGHT Team,\n\nI would like to check the shipping status for:\nOrder Number: ' + orderNum + '\nEmail: ' + email + '\n\nThank you!');
        supportLink.href = 'mailto:support@trymalora.com?subject=' + subject + '&body=' + body;
      }
      guidance.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
</script>

{% schema %}
{
  "name": "Ultra Track Order",
  "settings": [],
  "presets": [
    {
      "name": "Ultra Track Order"
    }
  ]
}
{% endschema %}
