# Shopify Store Credentials for TRYMALORA
# Điền thông tin store mới Trymalora vào đây

# Store domain (ví dụ: trymalora.myshopify.com hoặc myshopify domain)
SHOPIFY_STORE=trymalora.myshopify.com

# Shopify Custom App / Partner API Credentials (nếu dùng REST/GraphQL Script)
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
SHOPIFY_API_SECRET=your_client_secret_here

# Hoặc Admin API Access Token trực tiếp (shpat_...)
SHOPIFY_ACCESS_TOKEN=

# Theme ID trên Trymalora (sau khi tạo draft theme hoặc lấy từ Shopify Admin)
SHOPIFY_THEME_ID=

# API Version
SHOPIFY_API_VERSION=2026-10
