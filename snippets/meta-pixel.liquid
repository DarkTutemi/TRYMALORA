{% if template contains 'product' %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (window.fbq) {
        window.fbq('track', 'ViewContent', {
          content_name: {{ product.title | json }},
          content_category: {{ product.type | default: 'General' | json }},
          content_ids: [{{ product.selected_or_first_available_variant.id | default: product.id | json }}],
          content_type: 'product',
          value: {{ product.selected_or_first_available_variant.price | default: 1999 | divided_by: 100.0 }},
          currency: 'USD'
        });
      }
    });
  </script>
