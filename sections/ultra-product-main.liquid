{%- liquid
  assign current_product = nil
  assign current_variant = nil
  assign has_real_product = false
  assign can_purchase = false

  if product != blank and product.handle == 'full-spine-ultra-overnight'
    assign current_product = product
    assign has_real_product = true
  elsif all_products['full-spine-ultra-overnight'] != empty and all_products['full-spine-ultra-overnight'].id != blank
    assign current_product = all_products['full-spine-ultra-overnight']
    assign has_real_product = true
  endif

  if has_real_product
    assign current_variant = current_product.selected_or_first_available_variant
    if current_variant == blank
      assign current_variant = current_product.variants.first
    endif
    if current_variant != blank and current_variant.price > 0 and current_variant.available and current_product.published_at != blank
      assign can_purchase = true
    endif
  endif
-%}

<section class="uo-pdp-section" id="uoPdpSection">
  <div class="uo-wrap">
    <div class="uo-pdp-grid">
      
      <!-- ================= LEFT: PRODUCT GALLERY (MOBILE-FIRST P0) ================= -->
      <div class="uo-gallery-wrap">
        <!-- 1. Main Featured Image (First in Mobile DOM) -->
        <div class="uo-main-image-wrap">
          {%- assign featured_media = current_product.featured_image | default: current_product.images.first -%}
          {%- if featured_media != blank -%}
            <img 
              src="{{ featured_media | image_url: width: 1200 }}" 
              alt="{{ featured_media.alt | default: current_product.title | escape }}" 
              class="uo-main-image"
              id="uoMainProductImage"
              width="600" 
              height="600"
              loading="eager"
            >
            <div class="uo-gallery-counter-badge" id="uoGalleryCounterBadge">1 / {{ current_product.images.size }}</div>
          {%- else -%}
            <img 
              src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/D_lot_ng_qua_dem_Ultra_Overnight-1.png?v=1794711196" 
              alt="FULL-SPINE ULTRA OVERNIGHT™" 
              class="uo-main-image"
              id="uoMainProductImage"
              width="600" 
              height="600"
              loading="eager"
            >
            <div class="uo-gallery-counter-badge" id="uoGalleryCounterBadge">1 / 6</div>
          {%- endif -%}
        </div>

        <!-- 2. Thumbnails Strip (Directly Below Main Image) -->
        <div class="uo-thumbnails-strip" id="uoThumbnailsStrip" role="tablist" aria-label="Product Gallery Thumbnails">
          {%- if current_product.images.size > 0 -%}
            {%- for image in current_product.images -%}
              <button 
                type="button" 
                class="uo-thumb-btn{% if forloop.first %} is-active{% endif %}" 
                data-index="{{ forloop.index }}" 
                data-image-src="{{ image | image_url: width: 1200 }}" 
                aria-label="View {{ forloop.index }}: {{ image.alt | default: current_product.title | escape }}" 
                role="tab" 
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img 
                  src="{{ image | image_url: width: 160, height: 160, crop: 'center' }}" 
                  alt="{{ image.alt | default: current_product.title | escape }}" 
                  width="76" 
                  height="76" 
                  loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}"
                >
              </button>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback to the 6 real Shopify product images -->
            <button type="button" class="uo-thumb-btn is-active" data-index="1" data-image-src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/D_lot_ng_qua_dem_Ultra_Overnight-1.png?v=1794711196" aria-label="View 1" role="tab" aria-selected="true">
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/D_lot_ng_qua_dem_Ultra_Overnight-1.png?v=1794711196" alt="View 1" width="76" height="76" loading="eager">
            </button>
            <button type="button" class="uo-thumb-btn" data-index="2" data-image-src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/B_o_v_toan_di_n_t_tr_c_ra_sau-2.png?v=1794711196" aria-label="View 2" role="tab" aria-selected="false">
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/B_o_v_toan_di_n_t_tr_c_ra_sau-2.png?v=1794711196" alt="View 2" width="76" height="76" loading="lazy">
            </button>
            <button type="button" class="uo-thumb-btn" data-index="3" data-image-src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Qu_ng_cao_Ultra_Overnight_cho_ng_i_ng_nghieng-3.png?v=1794711196" aria-label="View 3" role="tab" aria-selected="false">
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Qu_ng_cao_Ultra_Overnight_cho_ng_i_ng_nghieng-3.png?v=1794711196" alt="View 3" width="76" height="76" loading="lazy">
            </button>
            <button type="button" class="uo-thumb-btn" data-index="4" data-image-src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Thi_t_k_nam_l_p_tho_i_mai_su_t_dem-4.png?v=1794711196" aria-label="View 4" role="tab" aria-selected="false">
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Thi_t_k_nam_l_p_tho_i_mai_su_t_dem-4.png?v=1794711196" alt="View 4" width="76" height="76" loading="lazy">
            </button>
            <button type="button" class="uo-thumb-btn" data-index="5" data-image-src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Qu_ng_Cao_D_Lot_K_Kinh_Qua_Dem-5.png?v=1794711196" aria-label="View 5" role="tab" aria-selected="false">
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Qu_ng_Cao_D_Lot_K_Kinh_Qua_Dem-5.png?v=1794711196" alt="View 5" width="76" height="76" loading="lazy">
            </button>
            <button type="button" class="uo-thumb-btn" data-index="6" data-image-src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Goi_d_lot_k_kinh_da_s_c_mau-6.png?v=1794711196" aria-label="View 6" role="tab" aria-selected="false">
              <img src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Goi_d_lot_k_kinh_da_s_c_mau-6.png?v=1794711196" alt="View 6" width="76" height="76" loading="lazy">
            </button>
          {%- endif -%}
        </div>
      </div>

      <!-- ================= RIGHT: BUY BOX (PREMIUM VISUAL HIERARCHY) ================= -->
      <div class="uo-buybox" id="uoBuyBox">
        
        <!-- 1. Trustpilot Verified Rating (Positioned Above Product Title - Strictly 1 Line) -->
        <div class="uo-trustpilot-rating-bar" aria-label="Trustpilot Rating 4.9 out of 5 based on 32,492 customer reviews">
          <div class="uo-tp-stars-row">
            <span class="uo-tp-star-box">★</span>
            <span class="uo-tp-star-box">★</span>
            <span class="uo-tp-star-box">★</span>
            <span class="uo-tp-star-box">★</span>
            <span class="uo-tp-star-box">★</span>
          </div>
          <span class="uo-tp-rating-lead">
            <strong class="uo-tp-score">4.9 / 5</strong>
            <span class="uo-tp-dot">·</span>
            <span class="uo-tp-count-text"><span class="uo-tp-lead-word">Based on </span><strong>32,492</strong> reviews</span>
          </span>
          <span class="uo-tp-brand-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#00b67a" style="vertical-align:-1px;margin-right:2px;">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            Trustpilot
          </span>
        </div>

        <!-- 2. Product Category Label -->
        <div class="uo-product-category">PREMIUM OVERNIGHT PERIOD UNDERWEAR</div>

        <!-- 3. Product Title (Compact on Mobile, Serif) -->
        <h1 class="uo-heading-serif uo-product-title">
          {%- if has_real_product -%}
            {{ current_product.title }}
          {%- else -%}
            FULL-SPINE ULTRA OVERNIGHT™
          {%- endif -%}
        </h1>

        <!-- 4. Short Emotional Headline -->
        <h2 class="uo-pdp-subhead-serif">Sleep Through Heavy-Flow Nights With More Confidence.</h2>

        <!-- 5. Price / Availability Row (With Compare-at Price) -->
        <div class="uo-price-row">
          <span class="uo-price-current">
            {%- if current_variant.price > 0 -%}
              {{ current_variant.price | money }}
            {%- else -%}
              {{ 3999 | money }}
            {%- endif -%}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="uo-price-compare" id="uoPriceCompare">{{ current_variant.compare_at_price | money }}</s>
            {%- assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            {%- if savings > 0 -%}
              <span class="uo-price-save-badge" id="uoPriceSaveBadge">Save {{ savings }}%</span>
            {%- endif -%}
          {%- else -%}
            {%- assign fallback_compare = current_variant.price | times: 2 -%}
            <s class="uo-price-compare" id="uoPriceCompare">{{ fallback_compare | money }}</s>
            <span class="uo-price-save-badge" id="uoPriceSaveBadge">Save 50%</span>
          {%- endif -%}
        </div>

        <!-- 5b. Clinicians' Choice (FrontrowMD) Trust Badge -->
        <div class="uo-clinicians-choice-card" aria-label="Clinicians' Choice medical recommendation">
          <div class="uo-cc-header">
            <svg class="uo-cc-wreath" xmlns="http://www.w3.org/2000/svg" width="13" height="23" viewBox="0 0 13 23" fill="none" aria-hidden="true">
              <path d="M0.923956 7.23C1.19531 9.03117 3.05787 10.241 3.05787 10.241C3.05787 10.241 4.48126 8.53065 4.21098 6.72917C3.93902 4.92589 2.07569 3.71739 2.07569 3.71739C2.07569 3.71739 0.65367 5.42853 0.923956 7.23ZM0.937352 13.5417C2.13318 14.9187 4.3623 14.9547 4.3623 14.9547C4.3623 14.9547 4.65301 12.7577 3.45718 11.3807C2.26134 10.0037 0.0308617 9.96698 0.0308617 9.96698C0.0308617 9.96698 -0.259543 12.165 0.937352 13.5417ZM3.41175 18.8799C5.12501 19.5249 7.10895 18.5052 7.10895 18.5052C7.10895 18.5052 6.31388 16.4388 4.60061 15.7938C2.88734 15.1487 0.903406 16.1685 0.903406 16.1685C0.903406 16.1685 1.69848 18.2349 3.41175 18.8799ZM8.55269 22.3241C10.3647 22.6032 12.0958 21.1994 12.0958 21.1994C12.0958 21.1994 10.888 19.3429 9.07562 19.0627C7.26357 18.7836 5.53384 20.1881 5.53384 20.1881C5.53384 20.1881 6.74065 22.0449 8.55269 22.3241ZM4.64297 1.99483C3.69978 3.5618 4.35843 5.67417 4.35843 5.67417C4.35843 5.67417 6.54922 5.24737 7.49241 3.6804C8.43559 2.11343 7.77664 8.80981e-07 7.77664 8.80981e-07C7.77664 8.80981e-07 5.58615 0.427856 4.64297 1.99483Z" fill="currentColor"/>
            </svg>
            <svg class="uo-cc-caduceus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="2" x2="12" y2="22"/>
              <circle cx="12" cy="2.5" r="1.5" fill="currentColor"/>
              <path d="M12 5C8 3 4 5 2 9c3-1 6-1 10 1"/>
              <path d="M12 5c4-2 8 0 10 4-3-1-6-1-10 1"/>
              <path d="M7 10c2-1 4-1 5 1s3 2 5 1"/>
              <path d="M7 15c2-1 4-1 5 1s3 2 5 1"/>
            </svg>
            <span class="uo-cc-title">Clinicians' Choice</span>
            <svg class="uo-cc-wreath" xmlns="http://www.w3.org/2000/svg" width="13" height="23" viewBox="0 0 13 23" fill="none" aria-hidden="true">
              <path d="M11.1717 7.23C10.9004 9.03117 9.03783 10.241 9.03783 10.241C9.03783 10.241 7.61444 8.53065 7.88473 6.72917C8.15668 4.92589 10.02 3.71739 10.02 3.71739C10.02 3.71739 11.442 5.42853 11.1717 7.23ZM11.1584 13.5417C9.96252 14.9187 7.7334 14.9547 7.7334 14.9547C7.7334 14.9547 7.4427 12.7577 8.63853 11.3807C9.83436 10.0037 12.0648 9.96698 12.0648 9.96698C12.0648 9.96698 12.3552 12.165 11.1584 13.5417ZM8.68396 18.8799C6.97069 19.5249 4.98676 18.5052 4.98676 18.5052C4.98676 18.5052 5.78183 16.4388 7.49509 15.7938C9.20836 15.1487 11.1923 16.1685 11.1923 16.1685C11.1923 16.1685 10.3972 18.2349 8.68396 18.8799ZM3.54301 22.3241C1.73097 22.6032 -0.000131784 21.1994 -0.000131784 21.1994C-0.000131784 21.1994 1.20774 19.3429 3.02009 19.0627C4.83213 18.7836 6.56186 20.1881 6.56186 20.1881C6.56186 20.1881 5.35505 22.0449 3.54301 22.3241ZM7.45274 1.99483C8.39592 3.5618 7.73727 5.67417 7.73727 5.67417C7.73727 5.67417 5.54648 5.24737 4.6033 3.6804C3.66011 2.11343 4.31907 8.80981e-07 4.31907 8.80981e-07C4.31907 8.80981e-07 6.50955 0.427856 7.45274 1.99483Z" fill="currentColor"/>
            </svg>
          </div>
          <p class="uo-cc-body">
            <strong>745 clinicians</strong>, including OB/GYNs, share this on <em>FrontrowMD</em> without compensation.
          </p>
          <div class="uo-cc-footer">
            <div class="uo-cc-avatars" aria-hidden="true">
              <img class="uo-cc-avatar" src="{{ 'doctor-avatar-1.png' | asset_url }}" alt="Clinician Dr. Jennifer T. Nguyen, MD" onerror="this.onerror=null; this.src='https://assets.app.thefrontrowhealth.com/d34bnzo7l9gald25wffcd7ep6rk6';" width="26" height="26" loading="lazy" />
              <img class="uo-cc-avatar" src="{{ 'doctor-avatar-2.png' | asset_url }}" alt="Clinician Doctor from Platinum Providers Group" onerror="this.onerror=null; this.src='https://assets.app.thefrontrowhealth.com/b6ml99tlkrfok1buwfvkj5l91tjq';" width="26" height="26" loading="lazy" />
              <img class="uo-cc-avatar" src="{{ 'doctor-avatar-3.png' | asset_url }}" alt="Clinician Doctor from Platinum Providers Group Northfield" onerror="this.onerror=null; this.src='https://assets.app.thefrontrowhealth.com/by782yom0hxbr63emzpe4qypcmnb';" width="26" height="26" loading="lazy" />
            </div>
            <button type="button" class="uo-cc-link-btn" id="uoOpenCliniciansModalBtn" onclick="window.openUoCliniciansModal(); return false;">
              View clinicians &amp; learn more
            </button>
          </div>
        </div>

        <!-- 6. Short Value Proposition (Exact Approved Copy: 2–3 Lines on Mobile) -->
        <div class="uo-pdp-desc">
          Extended overnight coverage. Five thoughtfully designed layers. Comfort made for your most demanding nights.
        </div>

        <!-- 7. Four Concise Benefit Highlights Near Price -->
        <div class="uo-pdp-highlights-grid">
          <div class="uo-highlight-item">
            <svg class="uo-highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <line x1="12" y1="8" x2="12" y2="16"></line>
            </svg>
            <span>Full-Spine Coverage</span>
          </div>

          <div class="uo-highlight-item">
            <svg class="uo-highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <span>Five-Layer Design</span>
          </div>

          <div class="uo-highlight-item">
            <svg class="uo-highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8l-4 4 4 4"></path>
              <path d="M6 8l4 4-4 4"></path>
            </svg>
            <span>SideSeal Contour</span>
          </div>

          <div class="uo-highlight-item">
            <svg class="uo-highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            </svg>
            <span>Soft DryTouch Comfort</span>
          </div>
        </div>

        <!-- ================= 8 & 9. COLOR & SIZE SELECTORS ================= -->
        <div class="uo-selectors-panel">
          <!-- 8. Color Selector -->
          <div class="uo-option-group uo-color-group" data-option-type="color">
            <div class="uo-option-header-row">
              <label class="uo-option-title">Color: <span class="uo-selected-color-name" id="uoSelectedColorLabel">Black</span></label>
            </div>
            <div class="uo-color-swatches" role="radiogroup" aria-label="Product Color Options">
              <!-- Black (#1a1a1a) -->
              <button 
                type="button" 
                class="uo-color-swatch is-active" 
                data-color-name="Black" 
                data-swatch-hex="#1a1a1a" 
                role="radio" 
                aria-checked="true"
                aria-label="Color: Black (Midnight Black)"
              >
                <span class="uo-swatch-circle" style="background-color: #1a1a1a;"></span>
                <span class="uo-swatch-text">Black</span>
              </button>

              <!-- Orange (#c86a32) -->
              <button 
                type="button" 
                class="uo-color-swatch" 
                data-color-name="Orange" 
                data-swatch-hex="#c86a32" 
                role="radio" 
                aria-checked="false"
                aria-label="Color: Orange (Terracotta Orange)"
              >
                <span class="uo-swatch-circle" style="background-color: #c86a32;"></span>
                <span class="uo-swatch-text">Orange</span>
              </button>

              <!-- Red (#8b263e) -->
              <button 
                type="button" 
                class="uo-color-swatch" 
                data-color-name="Red" 
                data-swatch-hex="#8b263e" 
                role="radio" 
                aria-checked="false"
                aria-label="Color: Red (Berry Crimson)"
              >
                <span class="uo-swatch-circle" style="background-color: #8b263e;"></span>
                <span class="uo-swatch-text">Red</span>
              </button>

              <!-- Nude (#d8b99b) -->
              <button 
                type="button" 
                class="uo-color-swatch" 
                data-color-name="Nude" 
                data-swatch-hex="#d8b99b" 
                role="radio" 
                aria-checked="false"
                aria-label="Color: Nude (Soft Warm Nude)"
              >
                <span class="uo-swatch-circle" style="background-color: #d8b99b;"></span>
                <span class="uo-swatch-text">Nude</span>
              </button>
            </div>
          </div>

          <!-- 9. Size Selector + Size Guide -->
          <div class="uo-option-group uo-size-group" data-option-type="size">
            <div class="uo-option-header-row">
              <label class="uo-option-title">Size: <span class="uo-selected-size-name" id="uoSelectedSizeLabel">M</span></label>
              <button type="button" class="uo-size-guide-trigger" onclick="openUoSizeGuide()" aria-haspopup="dialog">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12h20"></path><path d="M6 12v3"></path><path d="M10 12v2"></path><path d="M14 12v3"></path><path d="M18 12v2"></path>
                </svg>
                Size Guide ↗
              </button>
            </div>
            
            <div class="uo-size-pills" role="radiogroup" aria-label="Product Size Options">
              {% assign sizes = "XS,S,M,L,XL,2XL,3XL,4XL" | split: "," %}
              {% for s in sizes %}
                <button 
                  type="button" 
                  class="uo-size-pill {% if s == 'M' %}is-active{% endif %}" 
                  data-size-value="{{ s }}" 
                  role="radio" 
                  aria-checked="{% if s == 'M' %}true{% else %}false{% endif %}"
                  tabindex="{% if s == 'M' %}0{% else %}-1{% endif %}"
                >
                  {{ s }}
                </button>
              {% endfor %}
            </div>
          </div>
        </div>

        <!-- ================= 10. BUNDLE SELECTOR (1, 3, 5 PAIRS) ================= -->
        <div class="uo-bundle-section">
          <div class="uo-bundle-intro">
            <div class="uo-tier-section-title">Pick Your Pack</div>
            <p class="uo-bundle-microcopy">Find your perfect overnight rotation. The more pairs you choose, the more you save.</p>
          </div>
          <div class="uo-tier-cards" role="radiogroup" aria-label="Select bundle pack">
            
            {%- assign current_unit_price = current_variant.price -%}
            {%- assign is_us_market = false -%}
            {%- if localization.country.iso_code == 'US' -%}
              {%- assign is_us_market = true -%}
            {%- endif -%}

            <!-- Tier 1: 1 Pair -->
            {%- assign t1_total = current_unit_price -%}
            <div 
              class="uo-tier-card" 
              role="radio" 
              aria-checked="false" 
              tabindex="-1"
              data-tier="1-pair" 
              data-pack-qty="1"
            >
              <div class="uo-tier-left">
                <div class="uo-tier-radio"></div>
                <div class="uo-tier-info">
                  <div class="uo-tier-title-row">
                    <span class="uo-tier-name">1 Pair</span>
                    <span class="uo-tier-badge uo-tier-badge--try">TRY IT FIRST</span>
                  </div>
                  <p class="uo-tier-benefit">A simple way to try ULTRA OVERNIGHT.</p>
                </div>
              </div>
              <div class="uo-tier-right">
                <div class="uo-tier-final-price" data-tier-final="1">{{ t1_total | money }}</div>
                <div class="uo-tier-unit" data-tier-unit="1">({{ current_unit_price | money }}/each)</div>
              </div>
            </div>

            <!-- Tier 2: 3 Pairs (RECOMMENDED ROTATION - Selected by Default) -->
            {%- assign t2_orig = current_unit_price | times: 3 -%}
            {%- assign t2_final = current_unit_price | times: 3 | times: 90 | divided_by: 100 -%}
            {%- assign t2_unit = current_unit_price | times: 90 | divided_by: 100 -%}
            {%- assign t2_save = t2_orig | minus: t2_final -%}
            <div 
              class="uo-tier-card is-selected" 
              role="radio" 
              aria-checked="true" 
              tabindex="0"
              data-tier="3-pairs" 
              data-pack-qty="3"
            >
              <div class="uo-tier-left">
                <div class="uo-tier-radio"></div>
                <div class="uo-tier-info">
                  <div class="uo-tier-title-row">
                    <span class="uo-tier-name">3 Pairs</span>
