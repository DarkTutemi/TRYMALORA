{% comment %} CERULINE US — CUSTOMER REVIEWS (1:1 CLONE OF ALIREVIEWS SECTION) {% endcomment %}
<style>
  .ceruline-rev-wrap { max-width: 1100px; margin: 0 auto; padding: 48px 20px 64px; font-family: 'Poppins', sans-serif; color: #1A1A1A; }
  .ceruline-rev-heading { font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 24px; }
  .ceruline-rev-summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  .ceruline-rev-score { text-align: center; min-width: 140px; }
  .ceruline-rev-num { font-size: 44px; font-weight: 700; line-height: 1; }
  .ceruline-rev-stars { color: #C6A76E; font-size: 18px; letter-spacing: 2px; margin: 6px 0 4px; }
  .ceruline-rev-count { font-size: 13px; color: #666; }
  .ceruline-rev-bars { flex: 1; min-width: 240px; max-width: 480px; }
  .ceruline-rev-bar-row { display: flex; align-items: center; gap: 10px; font-size: 13px; margin-bottom: 6px; }
  .ceruline-rev-bar-track { flex: 1; height: 8px; background: #EAEAEA; border-radius: 4px; overflow: hidden; }
  .ceruline-rev-bar-fill { height: 100%; background: #1A1A1A; border-radius: 4px; }
  .ceruline-rev-btn { display: block; width: 100%; max-width: 100%; padding: 14px; background: #111111; color: #FFFFFF; font-size: 14px; font-weight: 600; text-align: center; border: none; border-radius: 6px; cursor: pointer; margin-bottom: 28px; }
  .ceruline-rev-card { border-top: 1px solid #EAEAEA; padding: 20px 0; }
  .ceruline-rev-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .ceruline-rev-author { font-weight: 600; font-size: 14px; display: flex; align-items: center; gap: 8px; }
  .ceruline-rev-date { font-size: 12px; color: #888; }
  .ceruline-rev-card-stars { color: #C6A76E; font-size: 15px; letter-spacing: 1px; margin-bottom: 8px; }
  .ceruline-rev-body { font-size: 14px; line-height: 1.6; color: #333; }
</style>

<div class="ceruline-rev-wrap" id="reviews">
  <h2 class="ceruline-rev-heading">CUSTOMER REVIEWS</h2>

  <div class="ceruline-rev-summary">
    <div class="ceruline-rev-score">
      <div class="ceruline-rev-num">4.9</div>
      <div class="ceruline-rev-stars">★★★★★</div>
      <div class="ceruline-rev-count">1,342 reviews</div>
    </div>

    <div class="ceruline-rev-bars">
      <div class="ceruline-rev-bar-row"><span>5 ★</span><div class="ceruline-rev-bar-track"><div class="ceruline-rev-bar-fill" style="width:91%"></div></div><span>1221</span></div>
      <div class="ceruline-rev-bar-row"><span>4 ★</span><div class="ceruline-rev-bar-track"><div class="ceruline-rev-bar-fill" style="width:8%"></div></div><span>107</span></div>
      <div class="ceruline-rev-bar-row"><span>3 ★</span><div class="ceruline-rev-bar-track"><div class="ceruline-rev-bar-fill" style="width:1%"></div></div><span>14</span></div>
      <div class="ceruline-rev-bar-row"><span>2 ★</span><div class="ceruline-rev-bar-track"><div class="ceruline-rev-bar-fill" style="width:0%"></div></div><span>0</span></div>
      <div class="ceruline-rev-bar-row"><span>1 ★</span><div class="ceruline-rev-bar-track"><div class="ceruline-rev-bar-fill" style="width:0%"></div></div><span>0</span></div>
    </div>
  </div>

  <button type="button" class="ceruline-rev-btn" onclick="alert('Verified buyers can submit a review via their order confirmation email.')">Write a review</button>

  <div class="ceruline-rev-list">
    <div class="ceruline-rev-card">
      <div class="ceruline-rev-card-head">
        <div class="ceruline-rev-author"><span>Mike R.</span> <span>🇺🇸</span></div>
        <div class="ceruline-rev-date">2026-11-18</div>
      </div>
      <div class="ceruline-rev-card-stars">★★★★★</div>
      <div class="ceruline-rev-body">Plugged it in two years ago, my Silverado still runs like new at 287K miles all thanks to this disabler. No more V4-to-V8 shudder!</div>
    </div>
    <div class="ceruline-rev-card">
      <div class="ceruline-rev-card-head">
        <div class="ceruline-rev-author"><span>Jason T.</span> <span>🇺🇸</span></div>
        <div class="ceruline-rev-date">2026-11-14</div>
      </div>
      <div class="ceruline-rev-card-stars">★★★★★</div>
      <div class="ceruline-rev-body">Took literally 10 seconds to plug into the OBD-II port on my 2018 GMC Sierra 5.3L. Instant full V8 power and zero check engine lights.</div>
    </div>
    <div class="ceruline-rev-card">
      <div class="ceruline-rev-card-head">
        <div class="ceruline-rev-author"><span>David K.</span> <span>🇺🇸</span></div>
        <div class="ceruline-rev-date">2026-11-09</div>
      </div>
      <div class="ceruline-rev-card-stars">★★★★★</div>
      <div class="ceruline-rev-body">Ordered the 2x bundle with the free extension cable for my Tahoe and my son's Silverado. Both trucks drive noticeably smoother.</div>
    </div>
    <div class="ceruline-rev-card">
      <div class="ceruline-rev-card-head">
        <div class="ceruline-rev-author"><span>Chris M.</span> <span>🇺🇸</span></div>
        <div class="ceruline-rev-date">2026-11-02</div>
      </div>
      <div class="ceruline-rev-card-stars">★★★★★</div>
      <div class="ceruline-rev-body">Worth every penny to protect my lifters from failing. Unplugs cleanly in seconds whenever I take the truck in for inspection.</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ceruline US Reviews",
  "settings": []
}
{% endschema %}
