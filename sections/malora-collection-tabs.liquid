<script>
  (function () {
    var sectionId = 'template--21386858561728__c_collection_tabs_e3kFnY';
    var swiperInstances = {};

    function initCollectionTabsSwiper(blockId) {
      var sectionEl = document.getElementById(sectionId);
      if (!sectionEl) return;

      var swiperEl = sectionEl.querySelector('[data-swiper-id="' + blockId + '"]');
      var paginationEl = sectionEl.querySelector('[data-pagination-id="' + blockId + '"]');
      var prevEl = sectionEl.querySelector('[data-prev-id="' + blockId + '"]');
      var nextEl = sectionEl.querySelector('[data-next-id="' + blockId + '"]');

      if (!swiperEl || typeof Swiper === 'undefined') return;

      if (swiperInstances[blockId]) {
        swiperInstances[blockId].destroy(true, true);
      }

      swiperInstances[blockId] = new Swiper(swiperEl, {
        slidesPerView: 'auto',
        spaceBetween: 13,
        grabCursor: true,
        loop: false,
        pagination: {
          el: paginationEl,
          clickable: true,
        },
        navigation: {
          prevEl: prevEl,
          nextEl: nextEl,
        },
        breakpoints: {
          768: {
            spaceBetween: 16,
          },
          978: {
            spaceBetween: 20,
          },
          1200: {
            spaceBetween: 24,
          },
        },
      });
    }

    function initAllSwipers() {
      var sectionEl = document.getElementById(sectionId);
      if (!sectionEl) return;

      var swipers = sectionEl.querySelectorAll('.c-collection-tabs__swiper');
      swipers.forEach(function (swiper) {
        var blockId = swiper.getAttribute('data-swiper-id');
        if (blockId) {
          initCollectionTabsSwiper(blockId);
        }
      });
    }

    function initTabs() {
      var sectionEl = document.getElementById(sectionId);
      if (!sectionEl) return;

      var tabs = sectionEl.querySelectorAll('.c-collection-tabs__tab');
      var panels = sectionEl.querySelectorAll('.c-collection-tabs__panel');

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var tabIndex = this.getAttribute('data-tab-index');

          tabs.forEach(function (t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });

          panels.forEach(function (p) {
            p.classList.remove('is-active');
          });

          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          var activePanel = sectionEl.querySelector('[data-panel-index="' + tabIndex + '"]');
          if (activePanel) {
            activePanel.classList.add('is-active');

            var swiperEl = activePanel.querySelector('.c-collection-tabs__swiper');
            if (swiperEl) {
              var blockId = swiperEl.getAttribute('data-swiper-id');
              if (blockId && swiperInstances[blockId]) {
                swiperInstances[blockId].update();
              }
            }
          }
        });

        tab.addEventListener('keydown', function (e) {
          var currentIndex = parseInt(this.getAttribute('data-tab-index'));
          var newIndex;

          if (e.key === 'ArrowRight') {
            newIndex = currentIndex + 1;
            if (newIndex >= tabs.length) newIndex = 0;
          } else if (e.key === 'ArrowLeft') {
            newIndex = currentIndex - 1;
            if (newIndex < 0) newIndex = tabs.length - 1;
          } else if (e.key === 'Home') {
            newIndex = 0;
          } else if (e.key === 'End') {
            newIndex = tabs.length - 1;
          } else {
            return;
          }

          e.preventDefault();
          tabs[newIndex].click();
          tabs[newIndex].focus();
        });
      });
    }

    function init() {
      initTabs();
      initAllSwipers();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) {
        setTimeout(init, 100);
      }
    });

    document.addEventListener('shopify:block:select', function (event) {
      if (event.detail.sectionId === sectionId) {
        var sectionEl = document.getElementById(sectionId);
        if (!sectionEl) return;

        var tab = sectionEl.querySelector('#tab-' + sectionId + '-' + event.detail.blockId);
        if (tab) {
          tab.click();
        }
      }
    });
  })();
</script>


