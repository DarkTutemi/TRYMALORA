{%- liquid
  assign is_legacy_product = false
  if template.name == 'product' and template.suffix != 'ultra-overnight' and product.handle != 'full-spine-ultra-overnight' and product.handle != 'ultra-overnight'
    assign is_legacy_product = true
  endif
-%}

{%- unless is_legacy_product -%}
<footer class="uo-footer">
  <div class="uo-wrap">
    <div class="uo-footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="uo-footer-brand">
        <a href="/" aria-label="ULTRA OVERNIGHT Home">
          <img src="{{ 'ultra-logo-white.svg' | asset_url }}" alt="ULTRA OVERNIGHT" width="220" height="36" loading="lazy">
        </a>
        <p>Overnight protection, all-night confidence.</p>
      </div>

      <!-- Col 2: Shop Links -->
      <div class="uo-footer-col">
        <h4>Shop</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/products/full-spine-ultra-overnight">Product</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/track-order">Track Order</a></li>
        </ul>
      </div>

      <!-- Col 3: Support Links -->
      <div class="uo-footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/policies/shipping-policy">Shipping & Delivery</a></li>
          <li><a href="/policies/refund-policy">Returns & Refunds</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal Links -->
      <div class="uo-footer-col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
        </ul>
      </div>

      <!-- Col 5: Stay in the Loop -->
      <div class="uo-footer-col">
        <h4>Stay in the Loop</h4>
        <p class="uo-newsletter-text">Get product updates, special offers, and wellness tips.</p>
        <form class="uo-newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to ULTRA OVERNIGHT!');">
          <input type="email" placeholder="Enter your email" class="uo-newsletter-input" required aria-label="Email address for newsletter">
          <button type="submit" class="uo-newsletter-btn" aria-label="Subscribe">➔</button>
        </form>
        <div class="uo-social-links">
          <!-- Instagram -->
          <a href="#" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- TikTok -->
          <a href="#" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </a>
          <!-- Pinterest -->
          <a href="#" aria-label="Pinterest">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="4" x2="12" y2="20"></line>
              <circle cx="12" cy="12" r="8"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="uo-footer-bottom">
      © 2025 ULTRA OVERNIGHT. All rights reserved.
    </div>
  </div>
</footer>
{%- endunless -%}

{% schema %}
{
  "name": "Ultra Footer",
  "settings": []
}
{% endschema %}

