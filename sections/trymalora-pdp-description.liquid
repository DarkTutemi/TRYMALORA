{% comment %}
  TRYMALORA - LONG-FORM PRODUCT DESCRIPTION SECTION
  Separates main media gallery from rich-text body images.
  Renders product.description with all restored high-resolution images in intended sequence.
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}
{{ 'zavelyn-v4-pdp.css' | asset_url | stylesheet_tag }}

{% if product.description != blank %}
  <section class="tm-product-description-section" id="tmProductDescription" role="region" aria-label="Detailed Product Overview">
    <div class="zv-container" style="max-width: 960px; margin: 0 auto; padding: 48px 20px;">
      
      <div style="text-align: center; margin-bottom: 36px;">
        <span class="zv-badge zv-badge-forest" style="display: inline-block; padding: 5px 14px; border-radius: 999px; background: var(--zv-primary, #17352B); color: #FFFFFF; font-size: 11.5px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 12px;">
          IN-DEPTH SPECIFICATIONS &amp; VISUALS
        </span>
        <h2 style="font-family: var(--zv-font-heading, sans-serif); font-size: 32px; font-weight: 800; color: var(--zv-heading, #111827); line-height: 1.2; margin: 0;">
          Product Details &amp; Visual Tour
        </h2>
      </div>

      <div class="tm-description-rte">
        {{ product.description }}
      </div>

    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Trymalora Description",
  "settings": [],
  "presets": [
    {
      "name": "Trymalora Description"
    }
  ]
}
{% endschema %}
