{% comment %}
  TRYMALORA - TECHNICAL SPECIFICATIONS & COMPLIANCE (TASKS 14 & 15)
  Refined editorial specifications table matching ShopSideK T01 styling.
{% endcomment %}

<style>
  .tm-specs-section {
    padding: 72px 0;
    background: var(--zv-pdp-bg, #FFF8F5);
    border-top: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-specs-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }

  .tm-specs-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-tint, #F8E4EB);
    color: var(--zv-pdp-accent, #B0476E);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .tm-specs-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.18;
    letter-spacing: -0.6px;
    margin: 0 0 12px;
  }

  @media screen and (min-width: 768px) {
    .tm-specs-title {
      font-size: 38px;
    }
  }

  .tm-specs-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  .tm-specs-card {
    background: #FFFFFF;
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-radius: var(--zv-radius-lg, 16px);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(43, 27, 36, 0.04);
  }

  .tm-specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .tm-specs-table tr {
    border-bottom: 1px solid var(--zv-pdp-line, #EAD7DD);
  }

  .tm-specs-table tr:last-child {
    border-bottom: none;
  }

  .tm-specs-label {
    padding: 16px 24px;
    font-weight: 700;
    color: var(--zv-pdp-heading, #2B1B24);
    width: 36%;
    background: var(--zv-pdp-surface, #FBEDE8);
    vertical-align: top;
  }

  .tm-specs-val {
    padding: 16px 24px;
    color: var(--zv-pdp-body, #4A3841);
    line-height: 1.55;
  }

  @media screen and (max-width: 600px) {
    .tm-specs-table, .tm-specs-table tbody, .tm-specs-table tr, .tm-specs-table td {
      display: block;
      width: 100%;
    }
    .tm-specs-label {
      padding: 14px 18px 6px;
      background: #FFFFFF;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--zv-pdp-accent, #B0476E);
    }
    .tm-specs-val {
      padding: 0 18px 14px;
    }
  }
</style>

<section class="tm-specs-section" id="tmProductSpecs">
  <div class="zv-container" style="max-width: 960px; margin: 0 auto; padding: 0 24px;">

    <!-- Section Header -->
    <div class="tm-specs-header">
      <span class="tm-specs-chip">
        ✦ HARDWARE &amp; SAFETY SPECIFICATIONS
      </span>
      <h2 class="tm-specs-title">
        Technical Details &amp; Build Quality
      </h2>
      <p class="tm-specs-subtitle">
        Engineered for safe family play with certified infrared optical light, impact-resistant materials, and tactile haptic feedback.
      </p>
    </div>

    <!-- Table Card -->
    <div class="tm-specs-card">
      <table class="tm-specs-table">
        <tbody>
          <tr>
            <td class="tm-specs-label">Optical Safety Tech</td>
            <td class="tm-specs-val">Certified Eye-Safe Optical Infrared (Invisible beam, zero high-powered lasers, zero physical darts or projectiles).</td>
          </tr>
          <tr>
            <td class="tm-specs-label">Recommended Age</td>
            <td class="tm-specs-val">6+ Years (Children, teenagers, and multi-generation family gatherings).</td>
          </tr>
          <tr>
            <td class="tm-specs-label">Effective Range</td>
            <td class="tm-specs-val">Up to 15–30 feet indoors (operates best in dim to moderate ambient indoor light).</td>
          </tr>
          <tr>
            <td class="tm-specs-label">Housing Materials</td>
            <td class="tm-specs-val">Impact-resistant, BPA-free ABS thermoplastic with rounded child-safe contours.</td>
          </tr>
          <tr>
            <td class="tm-specs-label">Battery Requirements</td>
            <td class="tm-specs-val">
              <strong>Blasters:</strong> 4 × 1.5V AAA (2 per blaster)<br>
              <strong>Projector:</strong> 3 × 1.5V AA<br>
              <span style="font-size: 12.5px; color: #9A3412; font-weight: 600;">(Batteries sold separately; alkaline recommended)</span>
            </td>
          </tr>
          <tr>
            <td class="tm-specs-label">Multiplayer Channels</td>
            <td class="tm-specs-val">4 Selectable Team Frequencies (Blue, Red, Green, White) with unlimited players per channel.</td>
          </tr>
          <tr>
            <td class="tm-specs-label">Sensory Feedback</td>
            <td class="tm-specs-val">Acoustic battle sound effects, internal recoil vibration motor &amp; 3-light LED health meters.</td>
          </tr>
          <tr>
            <td class="tm-specs-label">Projector Articulation</td>
            <td class="tm-specs-val">180° variable elevation lens allowing wall, ceiling, and corridor projection.</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Trymalora Product Specs",
  "settings": [],
  "presets": [
    {
      "name": "Trymalora Product Specs"
    }
  ]
}
{% endschema %}
