{% comment %}
  TRYMALORA - CONTINUOUS HORIZONTAL MOVING MARQUEE TICKER (TASK 13)
  Seamless infinite hardware-accelerated ticker loop inspired by ShopSideK T01.
  Reduced-motion support, zero scrollbars, concise bullet phrases with elegant star separators.
{% endcomment %}

<style>
  .tm-marquee-wrapper {
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.bg_color | default: "#2B1B24" }};
    color: {{ section.settings.text_color | default: "#FFFFFF" }};
    padding: 13px 0;
    position: relative;
    user-select: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
  }

  .tm-marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: tmContinuousTicker 24s linear infinite;
  }

  .tm-marquee-wrapper:hover .tm-marquee-track {
    animation-play-state: paused;
  }

  .tm-marquee-group {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-right: 32px;
    flex-shrink: 0;
  }

  .tm-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    white-space: nowrap;
    color: {{ section.settings.text_color | default: "#FFFFFF" }};
  }

  .tm-marquee-item .tm-separator {
    color: {{ section.settings.accent_color | default: "#B0476E" }};
    font-size: 13px;
    display: inline-block;
  }

  @keyframes tmContinuousTicker {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tm-marquee-track {
      animation: none !important;
      transform: none !important;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
      padding: 0 16px;
    }
    .tm-marquee-group:nth-child(n+2) {
      display: none;
    }
  }

  @media screen and (max-width: 768px) {
    .tm-marquee-wrapper {
      padding: 10px 0;
    }
    .tm-marquee-group {
      gap: 20px;
      padding-right: 20px;
    }
    .tm-marquee-item {
      font-size: 11.5px;
      letter-spacing: 1.4px;
      gap: 8px;
    }
  }
</style>

<div class="tm-marquee-wrapper" role="region" aria-label="Storefront Highlights">
  <div class="tm-marquee-track">
    {% for i in (1..2) %}
      <div class="tm-marquee-group" aria-hidden="{% if forloop.index == 2 %}true{% else %}false{% endif %}">
        <span class="tm-marquee-item">
          <span>INTERACTIVE FAMILY PLAY</span>
          <span class="tm-separator">✦</span>
        </span>
        <span class="tm-marquee-item">
          <span>DYNAMIC WALL &amp; CEILING TARGETS</span>
          <span class="tm-separator">✦</span>
        </span>
        <span class="tm-marquee-item">
          <span>EYE-SAFE OPTICAL INFRARED</span>
          <span class="tm-separator">✦</span>
        </span>
        <span class="tm-marquee-item">
          <span>ACOUSTIC SOUNDS &amp; HIT VIBRATION</span>
          <span class="tm-separator">✦</span>
        </span>
        <span class="tm-marquee-item">
          <span>4 TEAM COMBAT CHANNELS</span>
          <span class="tm-separator">✦</span>
        </span>
        <span class="tm-marquee-item">
          <span>30-DAY MONEY-BACK GUARANTEE</span>
          <span class="tm-separator">✦</span>
        </span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trymalora PDP Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2B1B24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Separator Accent Color",
      "default": "#B0476E"
    }
  ],
  "presets": [
    {
      "name": "Trymalora PDP Marquee"
    }
  ]
}
{% endschema %}
