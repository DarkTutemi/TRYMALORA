{% comment %}
  TRYMALORA - HOW IT WORKS & GAMEPLAY MODES (TASKS 14 & 15)
  Editorial image-led storytelling matching ShopSideK T01 design rhythm.
  Alternating high-res media blocks, Fraunces serif typography, and scannable value points.
{% endcomment %}

<style>
  .tm-hiw-section {
    padding: 72px 0;
    background: var(--zv-pdp-bg, #FFF8F5);
    border-top: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-hiw-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .tm-hiw-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-tint, #F8E4EB);
    color: var(--zv-pdp-accent, #B0476E);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .tm-hiw-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.18;
    letter-spacing: -0.6px;
    margin: 0 0 14px;
  }

  @media screen and (min-width: 768px) {
    .tm-hiw-title {
      font-size: 40px;
    }
  }

  .tm-hiw-subtitle {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  /* Alternating Editorial Story Blocks */
  .tm-story-blocks {
    display: flex;
    flex-direction: column;
    gap: 64px;
    margin-bottom: 64px;
  }

  .tm-story-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media screen and (min-width: 992px) {
    .tm-story-row {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
    .tm-story-row.reversed {
      direction: rtl;
    }
    .tm-story-row.reversed > * {
      direction: ltr;
    }
  }

  .tm-story-media {
    position: relative;
    border-radius: var(--zv-radius-lg, 16px);
    overflow: hidden;
    background: #FFFFFF;
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    box-shadow: 0 8px 30px rgba(43, 27, 36, 0.06);
    aspect-ratio: 4/3;
  }

  .tm-story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .tm-story-media:hover .tm-story-img {
    transform: scale(1.03);
  }

  .tm-story-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(43, 27, 36, 0.85);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 4px 12px;
    border-radius: var(--zv-radius-full, 9999px);
    text-transform: uppercase;
  }

  .tm-story-content {
    display: flex;
    flex-direction: column;
  }

  .tm-story-eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--zv-pdp-accent, #B0476E);
    margin-bottom: 10px;
  }

  .tm-story-heading {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 14px;
  }

  @media screen and (min-width: 768px) {
    .tm-story-heading {
      font-size: 32px;
    }
  }

  .tm-story-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0 0 22px;
  }

  .tm-story-checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tm-story-checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
  }

  .tm-story-check-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--zv-pdp-ok-tint, #E5F2EA);
    color: var(--zv-pdp-ok, #3F8F6B);
    font-size: 13px;
    font-weight: 900;
    flex-shrink: 0;
  }

  /* 3-Step Setup Band */
  .tm-setup-band {
    background: var(--zv-pdp-surface, #FBEDE8);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-radius: var(--zv-radius-lg, 16px);
    padding: 40px 32px;
    box-shadow: 0 4px 20px rgba(43, 27, 36, 0.04);
  }

  .tm-setup-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    text-align: center;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 8px;
  }

  .tm-setup-sub {
    font-size: 14px;
    text-align: center;
    color: var(--zv-pdp-muted, #7A6670);
    margin: 0 0 32px;
  }

  .tm-setup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    text-align: center;
  }

  .tm-setup-num {
    width: 40px;
    height: 40px;
    line-height: 40px;
    border-radius: 50%;
    background: var(--zv-pdp-cta, #6B1E46);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 800;
    margin: 0 auto 12px;
  }

  .tm-setup-step-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 6px;
  }

  .tm-setup-step-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }
</style>

<section class="tm-hiw-section" id="tmHowItWorks">
  <div class="zv-container" style="max-width: 1140px; margin: 0 auto; padding: 0 24px;">

    <!-- Section Header -->
    <div class="tm-hiw-header">
      <span class="tm-hiw-chip">
        ✦ INTERACTIVE DUAL-PLAY MODES
      </span>
      <h2 class="tm-hiw-title">
        Transform Any Room Into An Interactive Battle Arena
      </h2>
      <p class="tm-hiw-subtitle">
        Whether practicing solo marksmanship against dynamic wall projections or teaming up for full-room family battles, TRYMALORA delivers active, screen-free entertainment.
      </p>
    </div>

    <!-- Editorial Story Blocks -->
    <div class="tm-story-blocks">

      <!-- Block 1: Target Projection (Left Image, Right Content) -->
      <div class="tm-story-row">
        <div class="tm-story-media">
          <span class="tm-story-badge">Solo &amp; Co-op Arcade Mode</span>
          <img 
            src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png" 
            alt="Dynamic Wall Target Projection" 
            class="tm-story-img"
            width="600"
            height="450"
            loading="lazy"
          >
        </div>
        <div class="tm-story-content">
          <span class="tm-story-eyebrow">MODE A &middot; PRECISION TARGET PRACTICE</span>
          <h3 class="tm-story-heading">
            Roving Wall Projections That Sharpen Reflexes
          </h3>
          <p class="tm-story-desc">
            Place the compact projector on any surface facing a light wall or ceiling in a dimmed room. The precision lens animates roving UFO and arcade targets across 180° of motion. Struck targets register with instant audio cues and scored feedback.
          </p>
          <ul class="tm-story-checks">
            <li>
              <span class="tm-story-check-ic">✓</span>
              <span>180° Variable Angle Projection for walls or ceilings</span>
            </li>
            <li>
              <span class="tm-story-check-ic">✓</span>
              <span>Real-Time Hit Confirmation with responsive audio &amp; flash</span>
            </li>
            <li>
              <span class="tm-story-check-ic">✓</span>
              <span>Encourages physical activity and sharp hand-eye coordination</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Block 2: Multiplayer Combat Arena (Right Image, Left Content) -->
      <div class="tm-story-row reversed">
        <div class="tm-story-media">
          <span class="tm-story-badge">Multiplayer Team Mode</span>
          <img 
            src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png" 
            alt="Multiplayer Tactical Battle Mode" 
            class="tm-story-img"
            width="600"
            height="450"
            loading="lazy"
          >
        </div>
        <div class="tm-story-content">
          <span class="tm-story-eyebrow">MODE B &middot; MULTI-TEAM ARENA COMBAT</span>
          <h3 class="tm-story-heading">
            Tactical PvP Battles With Zero Physical Darts
          </h3>
          <p class="tm-story-desc">
            Switch team channels on your blaster to form squads. Play 1-on-1 duels or sync unlimited blasters across Blue, Red, Green, and White teams. Haptic vibration pulses on your handle whenever you take a hit, while LED health meters track remaining lives.
          </p>
          <ul class="tm-story-checks">
            <li>
              <span class="tm-story-check-ic">✓</span>
              <span>4 Selectable Team Battle Channels with team-fire protection</span>
            </li>
            <li>
              <span class="tm-story-check-ic">✓</span>
              <span>Tactile Vibration Motors deliver physical hit feedback</span>
            </li>
            <li>
              <span class="tm-story-check-ic">✓</span>
              <span>3-Bar LED Life Indicator displays team health in real time</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

    <!-- 3-Step Setup Ribbon -->
    <div class="tm-setup-band">
      <h3 class="tm-setup-title">3-Step Effortless Setup</h3>
      <p class="tm-setup-sub">No complex smartphone apps, pairing codes, or Bluetooth syncing required.</p>
      
      <div class="tm-setup-grid">
        <div>
          <div class="tm-setup-num">1</div>
          <div class="tm-setup-step-title">Insert Batteries</div>
          <p class="tm-setup-step-desc">Load 2× AAA batteries into each blaster and 3× AA batteries into the projector base.</p>
        </div>
        <div>
          <div class="tm-setup-num">2</div>
          <div class="tm-setup-step-title">Choose Your Play Mode</div>
          <p class="tm-setup-step-desc">Turn on the projector for wall target drills, or select your team color channel for PvP.</p>
        </div>
        <div>
          <div class="tm-setup-num">3</div>
          <div class="tm-setup-step-title">Power On &amp; Battle</div>
          <p class="tm-setup-step-desc">Switch on, take aim, and engage in high-energy interactive indoor battles.</p>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Trymalora How It Works",
  "settings": [],
  "presets": [
    {
      "name": "Trymalora How It Works"
    }
  ]
}
{% endschema %}
