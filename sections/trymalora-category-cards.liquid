{% comment %}
  TRYMALORA - SHOP BY CATEGORY / ARCHITECTURAL STORE ENTRANCES (SECTION 4 & 6)
  Atmospheric retail portals inspired by ShopSideK T01 and 2.5D Showroom aesthetics.
  Links directly to the specialized collections.
{% endcomment %}

<style>
  .tm-dept-section {
    padding: 72px 0 80px;
    background-color: var(--zv-pdp-bg, #FFF8F5);
    border-bottom: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-dept-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px;
  }

  .tm-dept-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--zv-radius-full, 9999px);
    background: #FBEDE8;
    color: #6B1E46;
    border: 1px solid #EAD7DD;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .tm-dept-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: clamp(28px, 3.8vw, 40px);
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.18;
    letter-spacing: -0.6px;
    margin: 0 0 16px;
  }

  .tm-dept-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  .tm-dept-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 860px) {
    .tm-dept-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .tm-dept-card {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px 28px 24px;
    color: #FFFFFF;
    text-decoration: none;
    min-height: 340px;
    box-sizing: border-box;
  }

  .tm-dept-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
  }

  /* Department Themes */
  .tm-theme-arena {
    background: linear-gradient(135deg, #1C2E24 0%, #101B15 100%);
    border: 1px solid rgba(82, 140, 102, 0.3);
  }
  .tm-theme-workshop {
    background: linear-gradient(135deg, #1F252E 0%, #12161C 100%);
    border: 1px solid rgba(90, 115, 145, 0.3);
  }
  .tm-theme-renovation {
    background: linear-gradient(135deg, #332322 0%, #1E1414 100%);
    border: 1px solid rgba(160, 105, 95, 0.3);
  }
  .tm-theme-sanctuary {
    background: linear-gradient(135deg, #1E2333 0%, #131622 100%);
    border: 1px solid rgba(100, 115, 165, 0.3);
  }

  .tm-dept-top {
    margin-bottom: 24px;
  }

  .tm-dept-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .tm-dept-badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #E2E8F0;
  }

  .tm-dept-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #4ADE80;
  }

  .tm-dept-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ADE80;
    box-shadow: 0 0 8px #4ADE80;
  }

  .tm-dept-name {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 8px;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .tm-dept-summary {
    font-size: 14px;
    line-height: 1.55;
    color: #CBD5E1;
    margin: 0;
  }

  /* Product Shelving Merch Row */
  .tm-dept-merch {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 12px;
  }

  .tm-merch-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .tm-merch-img-box {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background: #FFFFFF;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  .tm-merch-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .tm-merch-label {
    font-size: 11px;
    font-weight: 600;
    color: #E2E8F0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80px;
  }

  /* Button Action Bar */
  .tm-dept-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #FFFFFF;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .tm-dept-card:hover .tm-dept-cta {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .tm-dept-cta-arrow {
    transition: transform 0.2s ease;
  }

  .tm-dept-card:hover .tm-dept-cta-arrow {
    transform: translateX(4px);
  }
</style>

