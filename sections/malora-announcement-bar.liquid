{% comment %} MALORA ORGANICS - 8SHEEP 1:1 CLONE {% endcomment %}
<div id="shopify-section-c-header1" class="shopify-section c-header1-wrapper"><style data-shopify>
  /* =============================================
     C - Header 1  —  Scoped styles
     ============================================= */

  /* --- CSS Variables --- */
  #c-header1.c-header1 {
    --ch1-bg: rgba(0,0,0,0);
    --ch1-text: #ffffff;
    --ch1-text-bold: #ffffff;
    --ch1-dropdown-bg: #ffffff;
    --ch1-dropdown-text: #222222;
    --ch1-dropdown-border: #e0e0e0;
    --ch1-icon-color: #ffffff;
    --ch1-mobile-bg: #ffffff;
    --ch1-mobile-text: #222222;
    --ch1-height: 84px;

    position: fixed;
    top: 35px;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: var(--ch1-bg);
    width: 100%;
    overflow: visible;
  }

  /* Wrapper: height 0 so fixed header doesn't push content down.
     Override .cc-animate-enabled .shopify-section { overflow: hidden } from styles.css */
  .cc-animate-enabled .shopify-section.c-header1-wrapper,
  .c-header1-wrapper {
    overflow: visible;
    height: 0;
  }

  /* Expose header height as global CSS variable */
  :root {
    --nav-height: 84px;
  }

  /* --- Main bar --- */
  #c-header1 .c-header1__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1312px;
    margin: 0 auto;
    padding: 12px 16px;
    height: var(--ch1-height);
    position: relative;
    overflow: visible;
  }

  /* --- Logo --- */
  #c-header1 .c-header1__logo {
    display: none;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  /* Hide logo in main bar on mobile — only visible inside the drawer */
  #c-header1 .c-header1__bar .c-header1__logo {
    display: none;
  }

  @media (width >= 978px) {
    #c-header1 .c-header1__bar .c-header1__logo {
      display: flex;
    }
  }

  #c-header1 .c-header1__logo img {
    display: block;
    width: 120px;
    height: auto;
  }

  @media (width >= 768px) {
    #c-header1 .c-header1__logo img {
      width: 180px;
    }
  }

  #c-header1 .c-header1__logo-text {
    font-family: var(--font-heading-bold);
    font-size: 20px;
    color: var(--ch1-text);
    text-decoration: none;
  }

  /* --- Desktop nav --- */
  #c-header1 .c-header1__nav {
    display: none;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (width >= 978px) {
    #c-header1 .c-header1__nav {
      display: flex;
    }
  }

  #c-header1 .c-header1__nav-item {
    position: relative;
  }

  #c-header1 .c-header1__nav-link {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ch1-text);
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  #c-header1 .c-header1__nav-link:hover,
  #c-header1 .c-header1__nav-link:focus-visible {
    color: var(--ch1-text-bold);
  }

  #c-header1 .c-header1__nav-link--has-children {
    font-family: var(--font-heading-bold);
    color: var(--ch1-text-bold);
  }

  #c-header1 .c-header1__nav-link--has-children .c-header1__chevron {
    width: 10px;
    height: 10px;
    transition: transform 0.25s ease;
  }

  #c-header1 .c-header1__nav-item.is-open .c-header1__nav-link--has-children .c-header1__chevron {
    transform: rotate(180deg);
  }

  /* --- Dropdown (nav-rows) --- */
  #c-header1 .c-header1__dropdown {
    position: absolute;
    top: 221%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    background-color: var(--ch1-dropdown-bg);
    border-top: 1px solid var(--ch1-dropdown-border);
    border-radius: 0 0 8px 8px;
    padding: 32px 42px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    z-index: 100;
  }

  /* Show on hover */
  #c-header1 .c-header1__nav-item:hover > .c-header1__dropdown,
  #c-header1 .c-header1__nav-item.is-open > .c-header1__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #c-header1 .c-header1__dropdown-link {
    font-family: var(--font-heading-bold);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 1px;
    color: var(--ch1-dropdown-text);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  #c-header1 .c-header1__dropdown-link:hover,
  #c-header1 .c-header1__dropdown-link:focus-visible {
    opacity: 0.7;
  }

  /* --- Utility icons (search, account, cart) --- */
  #c-header1 .c-header1__utilities {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  #c-header1 .c-header1__utility-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ch1-icon-color);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }

  #c-header1 .c-header1__utility-btn:hover,
  #c-header1 .c-header1__utility-btn:focus-visible {
    color: var(--ch1-text-bold);
  }

  #c-header1 .c-header1__utility-btn svg {
    width: 24px;
    height: 24px;
  }

  #c-header1 .c-header1__cart-count {
    position: absolute;
    top: 2px;
    right: 0;
    background-color: var(--ch1-text-bold);
    color: var(--ch1-bg);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  /* --- Hamburger (mobile) --- */
  #c-header1 .c-header1__hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ch1-icon-color);
  }

  @media (width >= 978px) {
    #c-header1 .c-header1__hamburger {
      display: none;
    }
  }

  #c-header1 .c-header1__hamburger svg {
    width: 24px;
    height: 24px;
  }

  /* --- Mobile drawer overlay --- */
  #c-header1 .c-header1__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  #c-header1 .c-header1__overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* --- Mobile floating panel (mega-menu) --- */
  #c-header1 .c-header1__drawer {
    position: fixed;
    top: 45px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 24px);
    max-width: 362px;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  #c-header1 .c-header1__drawer.is-active {
    opacity: 1;
    visibility: visible;
  }

  #c-header1 .c-header1__drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: var(--ch1-mobile-bg);
    backdrop-filter: blur(32.25px);
    -webkit-backdrop-filter: blur(32.25px);
    border-radius: 8px;
    flex-shrink: 0;
    transition: border-radius 0.15s ease;
  }

  #c-header1 .c-header1__drawer.has-panel-open .c-header1__drawer-header {
    border-radius: 8px 8px 0 0;
  }

  #c-header1 .c-header1__drawer-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #c-header1 .c-header1__drawer-logo-img {
    width: 39px;
    height: auto;
    border-radius: 5px;
    object-fit: cover;
  }

  #c-header1 .c-header1__drawer-inline-nav {
    display: flex;
    align-items: center;
    gap: 0;
    flex: 1;
    justify-content: space-evenly;
  }

  #c-header1 .c-header1__drawer-inline-link {
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ch1-mobile-text);
    text-transform: uppercase;
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  #c-header1 .c-header1__drawer-inline-link:hover {
    opacity: 0.7;
  }

  #c-header1 .c-header1__drawer-inline-link.is-active {
    font-family: var(--font-heading-bold);
    font-weight: 700;
  }

  #c-header1 .c-header1__drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    color: var(--ch1-mobile-text);
    flex-shrink: 0;
  }

  #c-header1 .c-header1__drawer-close svg {
    width: 24px;
    height: 24px;
  }

  #c-header1 .c-header1__drawer-dropdown {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 21px 42px;
    background-color: var(--ch1-mobile-bg);
    border-top: 1px solid var(--ch1-dropdown-border);
    border-radius: 0 0 8px 8px;
  }

  #c-header1 .c-header1__drawer-dropdown.is-active {
    display: flex;
  }

  #c-header1 .c-header1__drawer-dropdown-link {
    font-family: var(--font-heading-bold);
    font-size: 20px;
    line-height: 1.2;
    color: var(--ch1-mobile-text);
    text-decoration: none;
    letter-spacing: 1px;
    transition: opacity 0.2s ease;
  }

  #c-header1 .c-header1__drawer-dropdown-link:hover {
    opacity: 0.7;
  }

  /* --- Search modal --- */
  #c-header1 .c-header1__search-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1002;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 120px;
  }

  #c-header1 .c-header1__search-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  #c-header1 .c-header1__search-box {
    background: #fff;
    border-radius: 8px;
    padding: 24px;
    width: 90%;
    max-width: 600px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    position: relative;
  }

  #c-header1 .c-header1__search-form {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #c-header1 .c-header1__search-input {
    flex: 1;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #c-header1 .c-header1__search-input:focus {
    border-color: var(--ch1-text-bold);
  }

  #c-header1 .c-header1__search-submit {
    background: var(--ch1-text-bold);
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 12px 20px;
    font-family: var(--font-heading-bold);
    font-size: 16px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #c-header1 .c-header1__search-submit:hover {
    opacity: 0.85;
  }

  #c-header1 .c-header1__search-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #666;
  }

  #c-header1 .c-header1__search-close svg {
    width: 18px;
    height: 18px;
  }

  /* --- Screen reader only --- */
  #c-header1 .c-header1__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .c-header1 {
      display: none;
    }

</style>
