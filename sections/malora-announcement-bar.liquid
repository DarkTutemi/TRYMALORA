<script>
  (function () {
    const section = document.querySelector('[data-header1-open-drawer]')?.closest('.c-header1');
    if (!section) return;

    const sectionId = section.id;

    /* --- Position below announcement bar / site-control --- */
    var siteControl = document.getElementById('site-control');
    /* offsetHeight is 0 when the element or any ancestor has display:none */
    if (siteControl) {
      function updateHeaderTop() {
        var h = siteControl.offsetHeight > 0 ? siteControl.getBoundingClientRect().height : 0;
        var selfHeight = section.offsetHeight > 0 ? section.getBoundingClientRect().height : 0;
        if (h > 0) {
          section.style.top = h + 'px';
          document.documentElement.style.setProperty('--nav-height', (h + selfHeight) + 'px');
        } else {
          section.style.removeProperty('top');
          document.documentElement.style.setProperty('--nav-height', selfHeight + 'px');
        }
      }
      updateHeaderTop();
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(updateHeaderTop).observe(siteControl);
        new ResizeObserver(updateHeaderTop).observe(section);
      }
      window.addEventListener('resize', updateHeaderTop);
      new MutationObserver(updateHeaderTop).observe(siteControl.closest('.c-header') || siteControl, { attributes: true, attributeFilter: ['style', 'class'] });
    }

    /* --- Desktop dropdown: hover + click --- */
    const dropdownItems = section.querySelectorAll('[data-header1-dropdown]');

    dropdownItems.forEach(function (item) {
      const toggle = item.querySelector('[data-header1-dropdown-toggle]');
      let hoverTimeout;

      /* Hover behaviour */
      item.addEventListener('mouseenter', function () {
        clearTimeout(hoverTimeout);
        item.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
      });

      item.addEventListener('mouseleave', function () {
        hoverTimeout = setTimeout(function () {
          item.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        }, 150);
      });

      /* Click behaviour (toggle) */
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        const isOpen = item.classList.contains('is-open');
        /* Close all other dropdowns first */
        dropdownItems.forEach(function (other) {
          if (other !== item) {
            other.classList.remove('is-open');
            other.querySelector('[data-header1-dropdown-toggle]').setAttribute('aria-expanded', 'false');
          }
        });
        item.classList.toggle('is-open', !isOpen);
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });

      /* Keyboard: Escape to close */
      item.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          item.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });
    });

    /* Close dropdowns on outside click */
    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-header1-dropdown]')) {
        dropdownItems.forEach(function (item) {
          item.classList.remove('is-open');
          item.querySelector('[data-header1-dropdown-toggle]').setAttribute('aria-expanded', 'false');
        });
      }
    });

    /* --- Mobile drawer --- */
    const openBtn = section.querySelector('[data-header1-open-drawer]');
    const closeBtn = section.querySelector('[data-header1-close-drawer]');
    const drawer = section.querySelector('[data-header1-drawer]');
    const overlay = section.querySelector('[data-header1-overlay]');
    const panelToggles = section.querySelectorAll('[data-header1-panel-toggle]');
    const dropdownPanels = section.querySelectorAll('[data-header1-panel]');

    function showPanel(index) {
      /* Close all panels first */
      dropdownPanels.forEach(function (p) { p.classList.remove('is-active'); });
      panelToggles.forEach(function (t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-expanded', 'false');
      });
      /* Open the requested panel */
      var panel = section.querySelector('[data-header1-panel="' + index + '"]');
      var toggle = section.querySelector('[data-header1-panel-toggle="' + index + '"]');
      if (panel) {
        panel.classList.add('is-active');
        drawer.classList.add('has-panel-open');
        if (toggle) {
          toggle.classList.add('is-active');
          toggle.setAttribute('aria-expanded', 'true');
        }
      }
    }

    function hideAllPanels() {
      dropdownPanels.forEach(function (p) { p.classList.remove('is-active'); });
      panelToggles.forEach(function (t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-expanded', 'false');
      });
      drawer.classList.remove('has-panel-open');
    }

    function openDrawer() {
      drawer.classList.add('is-active');
      overlay.classList.add('is-active');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      /* Auto-expand first dropdown panel */
      if (panelToggles.length > 0) {
        showPanel(panelToggles[0].getAttribute('data-header1-panel-toggle'));
      }
      var firstFocusable = drawer.querySelector('a, button');
      if (firstFocusable) firstFocusable.focus();
    }

    function closeDrawer() {
      drawer.classList.remove('is-active');
      overlay.classList.remove('is-active');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      hideAllPanels();
      openBtn.focus();
    }

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);

    /* Escape key closes drawer */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-active')) {
        closeDrawer();
      }
    });

    /* --- Mobile panel toggles --- */
    panelToggles.forEach(function (toggle) {
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        var index = toggle.getAttribute('data-header1-panel-toggle');
        var panel = section.querySelector('[data-header1-panel="' + index + '"]');
        var isOpen = panel && panel.classList.contains('is-active');
        if (isOpen) {
          hideAllPanels();
        } else {
          showPanel(index);
        }
      });
    });

    /* --- Search overlay --- */
    const searchOpenBtns = section.querySelectorAll('[data-header1-search-open]');
    const searchOverlay = section.querySelector('[data-header1-search-overlay]');
    const searchCloseBtn = section.querySelector('[data-header1-search-close]');
    const searchInput = section.querySelector('.c-header1__search-input');

    function openSearch() {
      searchOverlay.classList.add('is-active');
      searchOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (searchInput) searchInput.focus();
    }

    function closeSearch() {
      searchOverlay.classList.remove('is-active');
      searchOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    searchOpenBtns.forEach(function (btn) {
      btn.addEventListener('click', openSearch);
    });

    if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearch);

    /* Click outside search box closes overlay */
    searchOverlay.addEventListener('click', function (e) {
      if (e.target === searchOverlay) closeSearch();
    });

    /* Escape key closes search */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && searchOverlay.classList.contains('is-active')) {
        closeSearch();
      }
    });

    /* --- Cart — open Rebuy Smart Cart flyout --- */
    var cartBtn = section.querySelector('[data-header1-cart-open]');
    if (cartBtn) {
      cartBtn.addEventListener('click', function () {
        if (window.Rebuy && window.Rebuy.SmartCart) {
          window.Rebuy.SmartCart.show();
        } else {
          window.location.href = '/cart';
        }
      });
    }
  })();
</script>


