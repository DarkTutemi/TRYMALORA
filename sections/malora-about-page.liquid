{% comment %} MALORA ORGANICS — ABOUT US PAGE {% endcomment %}
<style>
  .malora-page-wrap { display: block !important; width: 100% !important; max-width: 1120px !important; margin: 0 auto !important; padding: 48px 24px 72px !important; color: #323A31 !important; opacity: 1 !important; visibility: visible !important; position: relative !important; z-index: 10 !important; background: #FFFFFF !important; }
  .malora-about-hero { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 48px !important; align-items: center !important; margin-bottom: 56px !important; }
  .malora-about-hero > div { min-width: 0 !important; }
  @media (max-width: 768px) { .malora-about-hero { grid-template-columns: 1fr !important; gap: 28px !important; } }
  .malora-about-img { width: 100% !important; max-width: 520px !important; height: 380px !important; border-radius: 12px !important; object-fit: cover !important; display: block !important; }
  .malora-page-title { font-family: 'Canela', Georgia, serif !important; font-size: clamp(30px, 4vw, 44px) !important; font-weight: 500 !important; margin: 0 0 16px !important; color: #323A31 !important; }
  .malora-page-text { font-size: 16px !important; line-height: 1.7 !important; color: #4A5249 !important; margin-bottom: 16px !important; }
  .malora-values-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 24px !important; }
  @media (max-width: 768px) { .malora-values-grid { grid-template-columns: 1fr !important; } }
  .malora-value-card { background: #F8F7F4 !important; padding: 28px !important; border-radius: 10px !important; border: 1px solid #ECEAE4 !important; }
  .malora-value-card h3 { font-family: 'Canela', Georgia, serif !important; font-size: 22px !important; margin: 0 0 10px !important; color: #323A31 !important; }
</style>

<div class="malora-page-wrap">
  <div class="malora-about-hero">
    <div>
      <h1 class="malora-page-title">Our Story: Pure, Organic Care for Mama &amp; Baby</h1>
      <p class="malora-page-text">
        Malora Organics was founded with one simple mission: to create 100% natural, pregnancy-safe skincare and sleep essentials that actually work—without synthetic chemicals, parabens, or artificial fragrances.
      </p>
      <p class="malora-page-text">
        Crafted in small batches in the USA using deep sea magnesium, organic shea butter, and soothing botanical oils, our formulas are trusted by over 168,000+ mothers and recommended by OB-GYNs nationwide.
      </p>
    </div>
    <div>
      <img src="https://8sheep.com/cdn/shop/products/37_d17b3185-e3d0-4a60-9f46-88a00bdbe8e3_1024x1024.png?v=1762197935" alt="Malora Organics Mama and Baby" class="malora-about-img">
    </div>
  </div>

  <div class="malora-values-grid">
    <div class="malora-value-card">
      <h3>🌿 100% Clean Ingredients</h3>
      <p class="malora-page-text" style="margin:0;">Every ingredient is carefully vetted for pregnancy and baby safety. Zero toxins, zero fillers.</p>
    </div>
    <div class="malora-value-card">
      <h3>🧪 Small-Batch Craft</h3>
      <p class="malora-page-text" style="margin:0;">Handcrafted in small batches in the USA to preserve maximum potency and freshness.</p>
    </div>
    <div class="malora-value-card">
      <h3>💛 90-Day Guarantee</h3>
      <p class="malora-page-text" style="margin:0;">Try any Malora Organics product risk-free for 3 full months. Love it or get a full refund.</p>
    </div>
  </div>
</div>

