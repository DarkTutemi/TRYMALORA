{% comment %} MALORA ORGANICS - 8SHEEP 1:1 CLONE {% endcomment %}
<div id="shopify-section-c-header2" class="shopify-section c-header2-wrapper"><style data-shopify>
   /* =============================================
      C - Header 2  —  Scoped styles
      ============================================= */

   /* --- CSS Variables --- */
   #c-header2.c-header2 {
     --ch2-bg: rgba(0,0,0,0);
     --ch2-text: #ffffff;
     --ch2-text-bold: #ffffff;
     --ch2-icon-color: #ffffff;
     --ch2-dropdown-bg: rgba(0,0,0,0.26);
     --ch2-dropdown-text: #ffffff;
     --ch2-dropdown-blur: 32px;
     --ch2-mobile-bg: rgba(0,0,0,0.26);
     --ch2-mobile-text: #ffffff;
     --ch2-badge-bg: #bc635b;
     --ch2-badge-text: #ffffff;
     --ch2-height: 84px;

     position: fixed;
     top: 35px;
     left: 0;
     right: 0;
     z-index: 1000;
     background-color: var(--ch2-bg);
     width: 100%;
     overflow: visible;
   }

   /* Wrapper: height 0 so fixed header doesn't push content down.
      Prevent Shopify wrapper from clipping dropdown */
   .cc-animate-enabled .shopify-section.c-header2-wrapper,
   .c-header2-wrapper {
     overflow: visible;
     height: 0;
   }

   :root {
     --nav-height: 84px;
   }

   /* --- Main bar --- */
   #c-header2 .c-header2__bar {
     display: flex;
     align-items: center;
     justify-content: space-between;
     max-width: 1312px;
     margin: 0 auto;
     padding: 12px 16px;
     height: var(--ch2-height);
     position: relative;
     overflow: visible;
   }

   /* --- Logo --- */
   #c-header2 .c-header2__logo {
     display: flex;
     align-items: center;
     flex-shrink: 0;
     text-decoration: none;
   }

   #c-header2 .c-header2__logo img {
     display: block;
     width: 120px;
     height: auto;
   }

   @media (width >= 768px) {
     #c-header2 .c-header2__logo img {
       width: 180px;
     }
   }

   #c-header2 .c-header2__logo-text {
     font-family: var(--font-heading-bold);
     font-size: 20px;
     color: var(--ch2-text);
     text-decoration: none;
   }

   /* --- Desktop nav --- */
   #c-header2 .c-header2__nav {
     display: none;
     align-items: center;
     gap: 32px;
     list-style: none;
     margin: 0;
     padding: 0;
   }

   @media (width >= 978px) {
     #c-header2 .c-header2__nav {
       display: flex;
     }
   }

   #c-header2 .c-header2__nav-item {
     position: relative;
   }

   #c-header2 .c-header2__nav-link {
     font-family: var(--font-body);
     font-size: 16px;
     line-height: 1.5;
     color: var(--ch2-text);
     text-decoration: none;
     text-transform: uppercase;
     letter-spacing: 0.5px;
     white-space: nowrap;
     background: none;
     border: none;
     cursor: pointer;
     padding: 0;
     display: flex;
     align-items: center;
     gap: 4px;
     transition: color 0.2s ease;
   }

   #c-header2 .c-header2__nav-link:hover,
   #c-header2 .c-header2__nav-link:focus-visible {
     color: var(--ch2-text-bold);
   }

   #c-header2 .c-header2__nav-link--has-children {
     font-family: var(--font-heading-bold);
     color: var(--ch2-text-bold);
   }

   #c-header2 .c-header2__nav-link--has-children .c-header2__chevron {
     width: 10px;
     height: 10px;
     transition: transform 0.25s ease;
   }

   #c-header2 .c-header2__nav-item.is-open .c-header2__nav-link--has-children .c-header2__chevron {
     transform: rotate(180deg);
   }

   /* --- "Product-card" dropdown (glassmorphism) --- */
   #c-header2 .c-header2__dropdown {
     position: absolute;
     top: calc(100% + 20px);
     left: 50%;
     transform: translateX(-50%);
     min-width: 379px;
     background: var(--ch2-dropdown-bg);
     backdrop-filter: blur(var(--ch2-dropdown-blur));
     -webkit-backdrop-filter: blur(var(--ch2-dropdown-blur));
     border-radius: 8px;
     padding: 24px;
     display: flex;
     flex-direction: column;
     gap: 12px;
     opacity: 0;
     visibility: hidden;
     pointer-events: none;
     transition: opacity 0.25s ease, visibility 0.25s ease;
     z-index: 100;
   }

   #c-header2 .c-header2__nav-item:hover > .c-header2__dropdown,
   #c-header2 .c-header2__nav-item.is-open > .c-header2__dropdown {
     opacity: 1;
     visibility: visible;
     pointer-events: auto;
   }

   /* --- Product card inside dropdown --- */
   #c-header2 .c-header2__product-card {
     display: flex;
     align-items: center;
     gap: 12px;
     text-decoration: none;
     color: var(--ch2-dropdown-text);
     padding: 4px;
     border-radius: 8px;
     transition: background 0.2s ease;
   }

   #c-header2 .c-header2__product-card:hover {
     background: rgba(255, 255, 255, 0.08);
   }

   #c-header2 .c-header2__product-img-wrap {
     width: 71px;
     height: 71px;
     flex-shrink: 0;
     border-radius: 8px;
     background: rgba(0, 0, 0, 0.12);
     overflow: hidden;
     display: flex;
     align-items: center;
     justify-content: center;
   }

   #c-header2 .c-header2__product-img-wrap img {
     width: 100%;
     height: 100%;
     object-fit: cover;
     display: block;
   }

   #c-header2 .c-header2__product-info {
     display: flex;
     flex-direction: column;
     gap: 4px;
     min-width: 0;
   }

   #c-header2 .c-header2__product-badge {
     display: inline-block;
     font-family: "Inter", sans-serif;
     font-size: 12px;
     font-weight: 400;
     text-transform: uppercase;
     letter-spacing: 0.36px;
     line-height: 1.4;
     padding: 4px 8px;
     border-radius: 8px;
     width: fit-content;
   }

   #c-header2 .c-header2__product-title {
     font-family: var(--font-heading-bold);
     font-size: 17px;
     font-weight: 700;
     letter-spacing: 0.9px;
     line-height: 1.2;
     color: var(--ch2-dropdown-text);
     margin: 0;
   }

   #c-header2 .c-header2__product-tagline {
     font-family: var(--font-body);
     font-size: 12px;
     letter-spacing: 0.3px;
     line-height: 1.3;
     color: var(--ch2-dropdown-text);
     opacity: 0.8;
     margin: 0;
     display: block;
     width: 264px;
     max-width: 264px;
     white-space: nowrap;
     overflow: hidden;
     text-overflow: ellipsis;
   }

   #c-header2 .c-header2__product-supertitle {
     font-family: var(--font-body);
     font-size: 14px;
     font-weight: 400;
     letter-spacing: 0.5px;
     text-transform: uppercase;
     line-height: 1.2;
     color: var(--ch2-dropdown-text);
     opacity: 0.7;
     margin: 0;
   }

   /* --- Shop All link --- */
   #c-header2 .c-header2__shop-all {
     display: flex;
     align-items: center;
     justify-content: center;
     background-color: rgba(255, 255, 255, 0.17);
     border-radius: 8px;
     padding: 8px;
     font-family: var(--font-heading-bold);
     font-size: 14px;
     text-transform: capitalize;
     letter-spacing: 0.7px;
     color: var(--ch2-dropdown-text);
     text-decoration: underline;
     text-decoration-skip-ink: none;
     margin-top: 8px;
     transition: opacity 0.2s ease;
     width: 100%;
   }

   #c-header2 .c-header2__shop-all:hover {
     opacity: 0.7;
   }

   /* --- Utility icons --- */
   #c-header2 .c-header2__utilities {
     display: flex;
     align-items: center;
     gap: 4px;
     flex-shrink: 0;
   }

   #c-header2 .c-header2__utility-btn {
     display: flex;
     align-items: center;
     justify-content: center;
     padding: 8px;
     background: none;
     border: none;
     cursor: pointer;
     color: var(--ch2-icon-color);
     text-decoration: none;
     position: relative;
     transition: color 0.2s ease;
   }

   #c-header2 .c-header2__utility-btn:hover,
   #c-header2 .c-header2__utility-btn:focus-visible {
     color: var(--ch2-text-bold);
   }

   #c-header2 .c-header2__utility-btn svg {
     width: 24px;
     height: 24px;
   }

   #c-header2 .c-header2__cart-count {
     position: absolute;
     top: 2px;
     right: 0;
     background-color: var(--ch2-text-bold);
     color: var(--ch2-bg);
     font-family: var(--font-body);
     font-size: 10px;
     font-weight: 700;
     line-height: 1;
     min-width: 16px;
     height: 16px;
     border-radius: 50%;
     display: flex;
     align-items: center;
     justify-content: center;
     padding: 0 4px;
   }

   /* --- Hamburger (mobile) --- */
   #c-header2 .c-header2__hamburger {
     display: flex;
     align-items: center;
     justify-content: center;
     padding: 8px;
     background: none;
     border: none;
     cursor: pointer;
     color: var(--ch2-icon-color);
   }

   @media (width >= 978px) {
     #c-header2 .c-header2__hamburger {
       display: none;
     }
   }

   #c-header2 .c-header2__hamburger svg {
     width: 24px;
     height: 24px;
   }

   /* --- Mobile overlay --- */
   #c-header2 .c-header2__overlay {
     position: fixed;
     inset: 0;
     background-color: rgba(0, 0, 0, 0.4);
     z-index: 999;
     opacity: 0;
     visibility: hidden;
     transition: opacity 0.3s ease, visibility 0.3s ease;
   }

   #c-header2 .c-header2__overlay.is-active {
     opacity: 1;
     visibility: visible;
   }

   /* --- Mobile drawer (seed.com style — full-width slide from left) --- */
   #c-header2 .c-header2__drawer {
     position: fixed;
     top: 5%;
     left: 0;
     width: 100%;
     height: 100%;
     background: var(--ch2-mobile-bg);
     backdrop-filter: blur(var(--ch2-dropdown-blur));
     -webkit-backdrop-filter: blur(var(--ch2-dropdown-blur));
     z-index: 1001;
     transform: translateX(-100%);
     transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
     overflow-y: auto;
     -webkit-overflow-scrolling: touch;
     display: flex;
     flex-direction: column;
   }

   @media (width >= 978px) {
     #c-header2 .c-header2__drawer {
       max-width: 420px;
     }
   }

   #c-header2 .c-header2__drawer.is-active {
     transform: translateX(0);
   }

   #c-header2 .c-header2__drawer-header {
     display: flex;
     align-items: center;
     justify-content: space-between;
     padding: 20px 24px;
     flex-shrink: 0;
   }

   #c-header2 .c-header2__drawer-close {
     display: flex;
     align-items: center;
     justify-content: center;
     background: none;
     border: none;
     cursor: pointer;
     padding: 8px;
     color: var(--ch2-mobile-text);
   }

   #c-header2 .c-header2__drawer-close svg {
     width: 24px;
     height: 24px;
   }

   #c-header2 .c-header2__drawer-logo img {
     display: block;
     width: 120px;
     height: auto;
   }

   /* --- Mobile drawer nav --- */
   #c-header2 .c-header2__drawer-nav {
     list-style: none;
     margin: 0;
     padding: 0 24px;
     flex: 1;
     display: flex;
     flex-direction: column;
     gap: 0;
   }

   #c-header2 .c-header2__drawer-item {
     border-bottom: 1px solid rgba(255, 255, 255, 0.15);
   }

   #c-header2 .c-header2__drawer-link {
     display: flex;
     align-items: center;
     justify-content: space-between;
     padding: 16px 0;
     font-family: var(--font-heading-bold);
     font-size: 18px;
     line-height: 1.3;
     color: var(--ch2-mobile-text);
     text-decoration: none;
     text-transform: uppercase;
     letter-spacing: 0.9px;
     background: none;
     border: none;
     width: 100%;
     cursor: pointer;
     transition: opacity 0.2s ease;
   }

   #c-header2 .c-header2__drawer-link:hover {
     opacity: 0.7;
   }

   #c-header2 .c-header2__drawer-link .c-header2__chevron {
     width: 12px;
     height: 12px;
     transition: transform 0.25s ease;
     flex-shrink: 0;
   }

   #c-header2 .c-header2__drawer-item.is-open .c-header2__drawer-link .c-header2__chevron {
     transform: rotate(180deg);
   }

   /* --- Mobile drawer product cards sub-section --- */
   #c-header2 .c-header2__drawer-products {
     list-style: none;
     margin: 0;
     padding: 0 0 16px 0;
     display: none;
     flex-direction: column;
     gap: 12px;
   }

   #c-header2 .c-header2__drawer-item.is-open .c-header2__drawer-products {
     display: flex;
   }

   /* --- Search overlay --- */
   #c-header2 .c-header2__search-overlay {
     position: fixed;
     inset: 0;
     background-color: rgba(0, 0, 0, 0.5);
     z-index: 1002;
     opacity: 0;
     visibility: hidden;
     transition: opacity 0.3s ease, visibility 0.3s ease;
     display: flex;
     align-items: flex-start;
     justify-content: center;
     padding-top: 120px;
   }

   #c-header2 .c-header2__search-overlay.is-active {
     opacity: 1;
     visibility: visible;
   }

   #c-header2 .c-header2__search-box {
     background: #fff;
     border-radius: 8px;
     padding: 24px;
     width: 90%;
     max-width: 600px;
     box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
     position: relative;
   }

   #c-header2 .c-header2__search-form {
     display: flex;
     align-items: center;
     gap: 12px;
   }

   #c-header2 .c-header2__search-input {
     flex: 1;
     border: 1px solid #ddd;
     border-radius: 4px;
     padding: 12px 16px;
     font-family: var(--font-body);
     font-size: 16px;
     outline: none;
     transition: border-color 0.2s ease;
   }

   #c-header2 .c-header2__search-input:focus {
     border-color: var(--ch2-text-bold);
   }

   #c-header2 .c-header2__search-submit {
     background: var(--ch2-text-bold);
     color: #fff;
     border: none;
     border-radius: 4px;
     padding: 12px 20px;
     font-family: var(--font-heading-bold);
     font-size: 16px;
     cursor: pointer;
     transition: opacity 0.2s ease;
   }

   #c-header2 .c-header2__search-submit:hover {
     opacity: 0.85;
   }

   #c-header2 .c-header2__search-close {
     position: absolute;
     top: 12px;
     right: 12px;
     background: none;
     border: none;
     cursor: pointer;
     padding: 4px;
     color: #666;
   }

   #c-header2 .c-header2__search-close svg {
     width: 18px;
     height: 18px;
   }

   /* --- Screen reader only --- */
   #c-header2 .c-header2__sr-only {
     position: absolute;
     width: 1px;
     height: 1px;
     padding: 0;
     margin: -1px;
     overflow: hidden;
     clip: rect(0, 0, 0, 0);
     white-space: nowrap;
     border: 0;
   }

   /* =============================================
      MOBILE OVERRIDES
      ============================================= */

   /* --- Mobile bar: only hamburger + logo --- */
   @media (max-width: 977px) {
     #c-header2 .c-header2__bar {
       display: flex;
       align-items: center;
       justify-content: flex-start;
       gap: 0;
     }

     #c-header2 .c-header2__hamburger {
       order: -1;
       flex-shrink: 0;
     }

     #c-header2 .c-header2__bar .c-header2__logo {
       position: absolute;
       left: -28%;
       transform: translateX(-50%);
     }


     #c-header2 .c-header2__bar nav,
     #c-header2 .c-header2__utilities {
       display: none;
     }
   }

  /* --- Mobile drawer style only  --- */
   @media (max-width: 977px) {
     #c-header2 .c-header2__drawer {
       height: auto;
       max-height: 90vh;
       border-radius: 0;
       left: 3%;
       width: 94%;
       background: transparent;
       backdrop-filter: none;
       -webkit-backdrop-filter: none;
       gap: 9px;
       transform: translateX(calc(-100% - 3vw));
     }

     #c-header2 .c-header2__drawer.is-active {
       transform: translateX(0);
     }

     /* Nav bar card */
     #c-header2 .c-header2__drawer-header {
       background: var(--ch2-mobile-bg);
       backdrop-filter: blur(var(--ch2-dropdown-blur));
       -webkit-backdrop-filter: blur(var(--ch2-dropdown-blur));
       border-radius: 8px;
     }
   }

   /* --- Drawer header — flat horizontal row (Figma 1618-4695) --- */
   @media (max-width: 977px) {
     #c-header2 .c-header2__drawer-header {
       display: flex;
       flex-wrap: wrap;
       align-items: center;
       justify-content: space-between;
       padding: 16px 20px;
       gap: 0;
     }

     /* Small drawer logo with rounded corners */
     #c-header2 .c-header2__drawer-logo {
       flex-shrink: 0;
     }

     #c-header2 .c-header2__drawer-logo img {
       width: 39px;
       height: auto;
       border-radius: 5px;
       display: block;
     }

     #c-header2 .c-header2__drawer-header-link {
       font-family: "Century Gothic", CenturyGothic, AppleGothic, sans-serif;
       font-size: 16px;
       font-weight: 400;
       color: var(--ch2-mobile-text);
       text-transform: uppercase;
       text-decoration: none;
       letter-spacing: 0.5px;
       line-height: 1.5;
       white-space: nowrap;
       background: none;
       border: none;
       cursor: pointer;
       padding: 0;
       transition: opacity 0.2s ease;
     }

     #c-header2 .c-header2__drawer-header-link:hover {
       opacity: 0.7;
     }

     #c-header2 .c-header2__drawer-header-link--bold {
       font-weight: 700;
     }

     /* Close button — 32×32 to match Figma */
     #c-header2 .c-header2__drawer-close {
       flex-shrink: 0;
       padding: 4px;
     }

     #c-header2 .c-header2__drawer-close svg {
       width: 32px;
       height: 32px;
     }
   }

   /* --- Products panel \u2014 separate card below nav bar --- */
   @media (max-width: 977px) {
     #c-header2 .c-header2__drawer-products {
       display: none;
       flex-direction: column;
       gap: 16px;
       padding: 20px;
       margin: 0;
       list-style: none;
       background: var(--ch2-mobile-bg);
       backdrop-filter: blur(var(--ch2-dropdown-blur));
       -webkit-backdrop-filter: blur(var(--ch2-dropdown-blur));
       border-radius: 8px;
     }

     #c-header2 .c-header2__drawer-products.is-open {
       display: flex;
     }

     /* Product card in mobile drawer */
     #c-header2 .c-header2__drawer-products .c-header2__product-card {
       display: flex;
       align-items: center;
       gap: 12px;
       text-decoration: none;
       color: var(--ch2-mobile-text);
       padding: 4px;
       border-radius: 8px;
       transition: background 0.2s ease;
     }

     #c-header2 .c-header2__drawer-products .c-header2__product-card:hover {
       background: rgba(255, 255, 255, 0.08);
     }

     #c-header2 .c-header2__drawer-products .c-header2__product-img-wrap {
       width: 71px;
       height: 71px;
       flex-shrink: 0;
       border-radius: 8px;
       background: rgba(0, 0, 0, 0.12);
       overflow: hidden;
     }

     #c-header2 .c-header2__drawer-products .c-header2__product-badge {
       font-family: "Inter", sans-serif;
       font-size: 12px;
       font-weight: 400;
       text-transform: uppercase;
       letter-spacing: 0.36px;
       border-radius: 8px;
       padding: 4px 8px;
     }

     #c-header2 .c-header2__drawer-products .c-header2__product-title {
       font-family: var(--font-heading-bold);
       font-size: 18px;
       font-weight: 700;
       letter-spacing: 0.9px;
       color: #eeeeee;
     }

     #c-header2 .c-header2__drawer-products .c-header2__product-supertitle {
       font-family: var(--font-body);
       font-size: 14px;
       font-weight: 400;
       text-transform: uppercase;
       letter-spacing: 0.5px;
     }

     #c-header2 .c-header2__drawer-products .c-header2__shop-all {
       background: rgba(255, 255, 255, 0.17);
       border-radius: 8px;
       padding: 8px;
       text-decoration: underline;
       text-decoration-skip-ink: none;
     }

     #c-header2 .c-header2__drawer-products .c-header2__product-tagline {
       width: auto;
       max-width: 100%;
       white-space: normal;
       overflow: visible;
       text-overflow: unset;
       font-size: 11px;
       line-height: 1.4;
     }
   }

   /* --- Problem 4: Desktop safety — hide drawer & overlay --- */
   @media (width >= 978px) {
     #c-header2 .c-header2__drawer,
     #c-header2 .c-header2__overlay {
       display: none !important;
     }
   }

   /* --- Mobile logo wrapper (centered) --- */
   #c-header2 .c-header2__logo-icons-wrap {
     display: flex;
     align-items: center;
     justify-content: center;
     position: absolute;
     left: 50%;
     transform: translateX(-50%);
     width: auto;
   }

   /* --- Mobile icons — right side of bar --- */
   #c-header2 .c-header2__mobile-icons {
     display: flex;
     align-items: center;
     gap: 8px;
     position: absolute;
     right: 16px;
     top: 50%;
     transform: translateY(-50%);
   }

   #c-header2 .c-header2__mobile-icon {
     display: flex;
     align-items: center;
     justify-content: center;
     width: 32px;
     height: 32px;
     border-radius: 50%;
     background: none;
     border: none;
     padding: 0;
     cursor: pointer;
     color: var(--ch2-icon-color);
     text-decoration: none;
     transition: background 0.2s;
   }

   #c-header2 .c-header2__mobile-icon:hover {
     background: rgba(0, 0, 0, 0.06);
   }

   #c-header2 .c-header2__mobile-icon svg {
     width: 20px;
     height: 20px;
     fill: #FFFFFF;
   }

   /* Desktop: restore logo wrapper to normal flow + hide mobile icons */
   @media (width >= 978px) {
