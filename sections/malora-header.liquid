{% comment %} MALORA ORGANICS — VISIBLE STICKY HEADER & MENU (8SHEEP 1:1 CLONE) {% endcomment %}
<style>
  .malora-ann-bar {
    background: #323A31;
    color: #FFFFFF;
    text-align: center;
    padding: 9px 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .malora-site-header {
    position: sticky;
    top: 0;
    z-index: 999;
    background: #FFFFFF;
    border-bottom: 1px solid #EAEAE6;
    width: 100%;
  }
  .malora-header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .malora-logo {
    font-family: 'Canela', Georgia, serif;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: #323A31;
    text-decoration: none;
    white-space: nowrap;
  }
  .malora-nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .malora-nav-link {
    font-size: 14px;
    font-weight: 500;
    color: #323A31;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .malora-nav-link:hover {
    color: #B36A42;
  }
  .malora-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .malora-cart-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #323A31;
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid #D5D5D0;
    border-radius: 99px;
  }
  .malora-mobile-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 24px;
    color: #323A31;
    cursor: pointer;
    padding: 4px;
  }
  .malora-mobile-drawer {
    display: none;
    background: #FFFFFF;
    border-top: 1px solid #EAEAE6;
    padding: 16px 24px 24px;
    flex-direction: column;
    gap: 14px;
  }
  .malora-mobile-drawer.is-open {
    display: flex;
  }
  @media (max-width: 900px) {
    .malora-nav {
      display: none;
    }
    .malora-mobile-toggle {
      display: block;
    }
  }
</style>

<div class="malora-ann-bar">
  FREE US SHIPPING ON ORDERS $50+ · 100% ORGANIC &amp; PREGNANCY-SAFE · 90-DAY GUARANTEE
</div>

<header class="malora-site-header">
  <div class="malora-header-inner">
    <button type="button" class="malora-mobile-toggle" id="MaloraMobileMenuBtn" aria-label="Open Menu">☰</button>

    <a href="/" class="malora-logo">MALORA</a>

    <nav class="malora-nav" aria-label="Main Navigation">
      <a href="/collections/our-best-sellers" class="malora-nav-link">Best Sellers</a>
      <a href="/collections/bundle" class="malora-nav-link">Bundles &amp; Save</a>
      <a href="/collections/sleep-products" class="malora-nav-link">Sleep</a>
      <a href="/collections/organic-pregnancy-products" class="malora-nav-link">Pregnancy</a>
      <a href="/collections/baby" class="malora-nav-link">Baby &amp; Kids</a>
      <a href="/pages/about-us" class="malora-nav-link">About</a>
      <a href="/pages/track-order" class="malora-nav-link">Track Order</a>
      <a href="/pages/contact" class="malora-nav-link">Contact</a>
    </nav>

    <div class="malora-header-actions">
      <a href="/cart" class="malora-cart-link" aria-label="Cart">
        <span>🛒</span>
        <span id="MaloraCartCount">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="malora-mobile-drawer" id="MaloraMobileDrawer">
    <a href="/collections/our-best-sellers" class="malora-nav-link">Best Sellers</a>
    <a href="/collections/bundle" class="malora-nav-link">Bundles &amp; Save</a>
    <a href="/collections/sleep-products" class="malora-nav-link">Sleep</a>
    <a href="/collections/organic-pregnancy-products" class="malora-nav-link">Pregnancy</a>
    <a href="/collections/baby" class="malora-nav-link">Baby &amp; Kids</a>
    <a href="/pages/about-us" class="malora-nav-link">About</a>
    <a href="/pages/track-order" class="malora-nav-link">Track Order</a>
    <a href="/pages/contact" class="malora-nav-link">Contact</a>
  </div>
</header>

<script>
(function() {
  const btn = document.getElementById('MaloraMobileMenuBtn');
  const drawer = document.getElementById('MaloraMobileDrawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('is-open');
    });
  }
})();
</script>

{% schema %}
{
  "name": "Malora Header",
  "settings": []
}
{% endschema %}
