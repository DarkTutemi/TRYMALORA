  (function () {
    var sectionId = 'template--21386858561728__c_collection_GMfQyC';

    function initCollectionSwiper() {
      var sectionEl = document.getElementById(sectionId);
      if (!sectionEl) return;

      var swiperEl = sectionEl.querySelector('.c-collection__swiper');
      var paginationEl = sectionEl.querySelector('.c-collection__pagination');
      var prevEl = sectionEl.querySelector('.c-collection__nav-prev');
      var nextEl = sectionEl.querySelector('.c-collection__nav-next');

      if (!swiperEl || typeof Swiper === 'undefined') return;

      new Swiper(swiperEl, {
        slidesPerView: 'auto',
        spaceBetween: 13,
        grabCursor: true,
        loop: false,
        pagination: {
          el: paginationEl,
          clickable: true,
        },
        navigation: {
          prevEl: prevEl,
          nextEl: nextEl,
        },
        breakpoints: {
          768: {
            spaceBetween: 16,
          },
          978: {
            spaceBetween: 20,
          },
          1200: {
            spaceBetween: 24,
          },
        },
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollectionSwiper);
    } else {
      initCollectionSwiper();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) {
        setTimeout(initCollectionSwiper, 100);
      }
    });
  })();
