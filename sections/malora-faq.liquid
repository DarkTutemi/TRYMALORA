<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = 'template--21386858561728__c_faq_tabs_xxktn4';
    const tabButtons = document.querySelectorAll(`#${sectionId} .c-tab-button`);
    const faqItems = document.querySelectorAll(`#${sectionId} .c-faq-item`);
    const tabsContainer = document.querySelector(`#${sectionId} .c-tabs`);

    function markFirstVisibleFaq(tabId) {
      faqItems.forEach((item) => item.classList.remove('is-first-visible'));
      const visibleFaqs = document.querySelectorAll(`#${sectionId} .c-faq-item[data-faq-tab="${tabId}"]`);
      if (visibleFaqs.length > 0) visibleFaqs[0].classList.add('is-first-visible');
    }

    function initializeTabs() {
      if (tabButtons.length > 0) {
        const firstTab = tabButtons[0];
        const firstTabId = firstTab.getAttribute('data-tab-id');

        tabButtons.forEach((btn) => btn.classList.remove('active'));
        firstTab.classList.add('active');

        faqItems.forEach((item) => {
          item.classList.remove('active-tab', 'is-first-visible');
          if (item.hasAttribute('open')) item.removeAttribute('open');
        });

        const firstTabFaqs = document.querySelectorAll(`#${sectionId} .c-faq-item[data-faq-tab="${firstTabId}"]`);
        firstTabFaqs.forEach((faq) => faq.classList.add('active-tab'));

        markFirstVisibleFaq(firstTabId);
      }
    }

    // Drag functionality for desktop (768px and above)
    let dragState = { isDragging: false, hasDragged: false, startX: 0, scrollLeft: 0, threshold: 5 };

    // Touch state for mobile swipe
    let touchState = { isTouching: false, hasSwiped: false, startX: 0, startY: 0, scrollLeft: 0, threshold: 10 };

    if (tabsContainer) {
      // Desktop mouse drag events (only on larger screens)
      if (window.innerWidth > 768) {
        tabsContainer.addEventListener('mousedown', function (e) {
          dragState.isDragging = true;
          dragState.hasDragged = false;
          dragState.startX = e.pageX;
          dragState.scrollLeft = tabsContainer.scrollLeft;
          tabsContainer.classList.add('dragging');
          e.preventDefault();
        });

        tabsContainer.addEventListener('mouseleave', function () {
          dragState.isDragging = false;
          dragState.hasDragged = false;
          tabsContainer.classList.remove('dragging');
        });

        tabsContainer.addEventListener('mouseup', function () {
          dragState.isDragging = false;
          setTimeout(
            () => {
              tabsContainer.classList.remove('dragging');
              dragState.hasDragged = false;
            },
            dragState.hasDragged ? 150 : 0
          );
        });

        tabsContainer.addEventListener('mousemove', function (e) {
          if (!dragState.isDragging) return;

          const currentX = e.pageX;
          const diffX = Math.abs(currentX - dragState.startX);

          if (diffX > dragState.threshold) {
            dragState.hasDragged = true;
            e.preventDefault();
            const walk = (currentX - dragState.startX) * 1.5;
            tabsContainer.scrollLeft = dragState.scrollLeft - walk;
          }
        });
      }

      // Mobile touch swipe events
      tabsContainer.addEventListener(
        'touchstart',
        function (e) {
          touchState.isTouching = true;
          touchState.hasSwiped = false;
          touchState.startX = e.touches[0].clientX;
          touchState.startY = e.touches[0].clientY;
          touchState.scrollLeft = tabsContainer.scrollLeft;
        },
        { passive: true }
      );

      tabsContainer.addEventListener(
        'touchmove',
        function (e) {
          if (!touchState.isTouching) return;

          const currentX = e.touches[0].clientX;
          const currentY = e.touches[0].clientY;
          const diffX = Math.abs(currentX - touchState.startX);
          const diffY = Math.abs(currentY - touchState.startY);

          // Only handle horizontal swipes (when horizontal movement is greater than vertical)
          if (diffX > diffY && diffX > touchState.threshold) {
            touchState.hasSwiped = true;
            const walk = currentX - touchState.startX;
            tabsContainer.scrollLeft = touchState.scrollLeft - walk;
          }
        },
        { passive: true }
      );

      tabsContainer.addEventListener(
        'touchend',
        function () {
          touchState.isTouching = false;
          setTimeout(() => {
            touchState.hasSwiped = false;
          }, 150);
        },
        { passive: true }
      );

      window.addEventListener('resize', function () {
        if (window.innerWidth <= 768) {
          tabsContainer.classList.remove('dragging');
          dragState.isDragging = false;
          dragState.hasDragged = false;
        }
      });
    }

    tabButtons.forEach((button) => {
      button.addEventListener('click', function (e) {
        if (dragState.hasDragged || touchState.hasSwiped) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        const targetTabId = this.getAttribute('data-tab-id');

        tabButtons.forEach((btn) => btn.classList.remove('active'));
        this.classList.add('active');

        faqItems.forEach((item) => {
          item.classList.remove('active-tab', 'is-first-visible');
          if (item.hasAttribute('open')) item.removeAttribute('open');
        });

        const targetFaqs = document.querySelectorAll(`#${sectionId} .c-faq-item[data-faq-tab="${targetTabId}"]`);
        targetFaqs.forEach((faq) => faq.classList.add('active-tab'));

        markFirstVisibleFaq(targetTabId);
      });
    });

    // Accordion behavior within the same tab
    faqItems.forEach((item) => {
      item.addEventListener('toggle', function () {
        if (this.hasAttribute('open')) {
          const currentTab = this.getAttribute('data-faq-tab');
          const sameLevelFaqs = document.querySelectorAll(`#${sectionId} .c-faq-item[data-faq-tab="${currentTab}"]`);
          sameLevelFaqs.forEach((faq) => {
            if (faq !== this && faq.hasAttribute('open')) faq.removeAttribute('open');
          });
        }
      });
    });

    initializeTabs();
  });
</script>


