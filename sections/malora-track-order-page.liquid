{% comment %} MALORA ORGANICS — TRACK ORDER PAGE {% endcomment %}
<style>
  .malora-track-wrap { max-width: 680px; margin: 0 auto; padding: 56px 24px 80px; text-align: center; color: #323A31; }
  .malora-track-card { background: #F8F7F4; border: 1px solid #ECEAE4; border-radius: 12px; padding: 36px 28px; margin-top: 28px; }
  .malora-track-input { width: 100%; padding: 12px 16px; border: 1px solid #D5D5D0; border-radius: 6px; font-size: 15px; margin-bottom: 14px; background: #fff; }
  .malora-track-btn { width: 100%; padding: 14px; background: #323A31; color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; }
  .malora-track-btn:hover { background: #1F251E; }
</style>

<div class="malora-track-wrap">
  <h1 style="font-family: 'Canela', Georgia, serif; font-size: clamp(28px, 4vw, 40px); margin: 0 0 12px;">Track Your Order</h1>
  <p style="font-size: 15px; color: #555;">Enter your order number and email address to view your live shipping status.</p>

  <div class="malora-track-card">
    <form onsubmit="event.preventDefault(); document.getElementById('MaloraTrackResult').style.display='block';">
      <input type="text" class="malora-track-input" placeholder="Order Number (e.g. #ML1024)" required>
      <input type="email" class="malora-track-input" placeholder="Email Address" required>
      <button type="submit" class="malora-track-btn">Track Order</button>
    </form>
    <div id="MaloraTrackResult" style="display:none; margin-top:20px; padding:14px; background:#fff; border-radius:8px; border:1px solid #D5D5D0; font-size:14px;">
      📦 Your order is being prepared in small batches. Tracking updates are sent automatically to your email! Need help? Email <strong>support@trymalora.com</strong>.
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Malora Track Order",
  "settings": []
}
{% endschema %}
