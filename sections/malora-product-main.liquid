{% comment %} MALORA ORGANICS — 100% DYNAMIC PDP MAIN (8SHEEP 1:1 CLONE) {% endcomment %}

<style>
  .malora-pdp-wrapper,
  .malora-pdp-wrapper * {
    opacity: 1 !important;
    visibility: visible !important;
  }
  .malora-pdp-wrapper {
    display: block !important;
    width: 100% !important;
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding: 32px 24px 56px !important;
    font-family: inherit !important;
    color: #323A31 !important;
    opacity: 1 !important;
    visibility: visible !important;
    position: relative !important;
    z-index: 5 !important;
    background: #FFFFFF !important;
  }
  .malora-pdp-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .malora-pdp-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .malora-pdp-wrapper,
  .malora-pdp-wrapper * {
    opacity: 1 !important;
    visibility: visible !important;
  }
  .malora-pdp-wrapper {
      padding: 16px 16px 40px;
    }
  }
  /* Gallery */
  .malora-gallery {
    display: flex;
    gap: 16px;
  }
  .malora-thumbs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 76px;
    flex-shrink: 0;
  }
  .malora-thumb-btn {
    width: 76px;
    height: 76px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: #F7F6F3;
    transition: border-color 0.2s;
  }
  .malora-thumb-btn.is-active {
    border-color: #323A31;
  }
  .malora-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .malora-main-image-wrap {
    flex: 1;
    background: #F7F6F3;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    position: relative;
  }
  .malora-main-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 767px) {
    .malora-gallery {
      flex-direction: column-reverse;
    }
    .malora-thumbs {
      flex-direction: row;
      width: 100%;
      overflow-x: auto;
    }
    .malora-thumb-btn {
      width: 64px;
      height: 64px;
      flex-shrink: 0;
    }
  }
  /* Info Column */
  .malora-pdp-title {
    font-family: 'Canela', Georgia, serif;
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #323A31;
  }
  .malora-pdp-reviews {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #555;
    margin-bottom: 14px;
  }
  .malora-pdp-stars {
    color: #D4A017;
    letter-spacing: 1px;
  }
  .malora-pdp-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 18px;
  }
  .malora-pdp-price {
    font-size: 22px;
    font-weight: 600;
    color: #323A31;
  }
  .malora-pdp-compare {
    font-size: 16px;
    color: #888;
    text-decoration: line-through;
  }
  .malora-pdp-save-pill {
    background: #2E7D32;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .malora-option-group {
    margin-bottom: 18px;
  }
  .malora-option-label {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #323A31;
  }
  .malora-option-label span {
    font-weight: 400;
    color: #666;
  }
  .malora-option-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .malora-pill {
    position: relative;
    padding: 10px 18px;
    border: 1.5px solid #D5D5D0;
    border-radius: 6px;
    background: #fff;
    font-size: 14px;
    font-weight: 500;
    color: #323A31;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }
  .malora-pill:hover {
    border-color: #8A6B4A;
  }
  .malora-pill.is-selected {
    border-color: #D49A2A;
    background: #FFFDF8;
    box-shadow: 0 0 0 1px #D49A2A;
  }
  .malora-pill-badge {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    background: #2E7D32;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .malora-atc-row {
    display: flex;
    gap: 12px;
    margin: 20px 0 16px;
  }
  .malora-qty-box {
    display: flex;
    align-items: center;
    border: 1.5px solid #D5D5D0;
    border-radius: 6px;
    height: 50px;
    width: 116px;
    flex-shrink: 0;
  }
  .malora-qty-btn {
    width: 36px;
    height: 100%;
    border: none;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
    color: #323A31;
  }
  .malora-qty-val {
    flex: 1;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
  }
  .malora-atc-btn {
    flex: 1;
    height: 50px;
    background: #323A31;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s;
  }
  .malora-atc-btn:hover {
    background: #1F251E;
  }
  .malora-atc-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .malora-guarantee-box {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #FAF6EE;
    border: 1px solid #EFE6D5;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 18px;
  }
  .malora-guarantee-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #323A31;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    text-align: center;
    line-height: 1.1;
    flex-shrink: 0;
  }
  .malora-trust-icons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    padding: 14px 0;
    border-top: 1px solid #EAEAE6;
    border-bottom: 1px solid #EAEAE6;
    margin-bottom: 20px;
    text-align: center;
    font-size: 12px;
    color: #555;
  }
  /* Bundle Upsell Box */
  .malora-bundle-upsell {
    background: #F8F7F4;
    border: 1px solid #E5E3DC;
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 22px;
  }
  .malora-bundle-upsell-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #8A6B4A;
    margin-bottom: 12px;
  }
  .malora-bundle-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background: #fff;
    border: 1px solid #EAEAE6;
    border-radius: 8px;
    margin-bottom: 8px;
  }
  .malora-bundle-item:last-child {
    margin-bottom: 0;
  }
  .malora-bundle-item img {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 6px;
  }
  .malora-bundle-item-info {
    flex: 1;
  }
  .malora-bundle-item-name {
    font-size: 14px;
    font-weight: 600;
    color: #323A31;
    text-decoration: none;
    display: block;
  }
  .malora-bundle-item-price {
    font-size: 13px;
    color: #666;
  }
  .malora-bundle-add-btn {
    padding: 7px 14px;
    background: #8A6B4A;
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .malora-bundle-add-btn:hover {
    background: #6F553A;
  }
  .malora-description {
    font-size: 15px;
    line-height: 1.65;
    color: #444;
  }
</style>

<div class="malora-pdp-wrapper" data-product-id="{{ product.id }}">
  <div class="malora-pdp-grid">
    <!-- Left: Gallery -->
    <div class="malora-gallery">
      {% if product.images.size > 1 %}
        <div class="malora-thumbs">
          {% for image in product.images %}
            <button
              type="button"
              class="malora-thumb-btn {% if forloop.first %}is-active{% endif %}"
              data-full-src="{{ image | image_url: width: 1200 }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <div class="malora-main-image-wrap">
        {% assign featured_img = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
        {% if featured_img %}
          <img
            id="MaloraMainProductImg"
            src="{{ featured_img | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
          >
        {% endif %}
      </div>
    </div>

    <!-- Right: Product Info -->
    <div class="malora-pdp-info">
      <h1 class="malora-pdp-title">{{ product.title }}</h1>

      <div class="malora-pdp-reviews">
        <span class="malora-pdp-stars">★★★★★</span>
        <span>2,937+ Verified Reviews</span>
      </div>

      {% assign current_variant = product.selected_or_first_available_variant %}
      <div class="malora-pdp-price-row">
        <span id="MaloraPrice" class="malora-pdp-price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span id="MaloraComparePrice" class="malora-pdp-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="malora-pdp-save-pill">SAVE</span>
        {% else %}
          <span id="MaloraComparePrice" class="malora-pdp-compare" style="display:none;"></span>
        {% endif %}
      </div>

      {% unless product.has_only_default_variant %}
        <div id="MaloraVariantOptions">
          {% for option in product.options_with_values %}
            <div class="malora-option-group" data-option-index="{{ forloop.index0 }}">
              <div class="malora-option-label">
                {{ option.name }}: <span class="malora-selected-val">{{ option.selected_value }}</span>
              </div>
              <div class="malora-option-pills">
                {% for value in option.values %}
                  <button
                    type="button"
                    class="malora-pill {% if option.selected_value == value %}is-selected{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-value="{{ value | escape }}"
                  >
                    {% if value == '8 oz' %}
                      <span class="malora-pill-badge">SAVE 22%</span>
                    {% endif %}
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <div class="malora-atc-row">
        <div class="malora-qty-box">
          <button type="button" class="malora-qty-btn" id="MaloraQtyMinus" aria-label="Decrease quantity">−</button>
          <span class="malora-qty-val" id="MaloraQtyVal">1</span>
          <button type="button" class="malora-qty-btn" id="MaloraQtyPlus" aria-label="Increase quantity">+</button>
        </div>
        <button
          type="button"
          class="malora-atc-btn"
          id="MaloraAddToCartBtn"
          data-variant-id="{{ current_variant.id }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
        </button>
      </div>

      <div class="malora-guarantee-box">
        <div class="malora-guarantee-badge">90-DAY<br>TRIAL</div>
        <div>
          <div style="font-weight: 600; font-size: 14px;">Try Risk-Free For 3 Months</div>
          <div style="font-size: 12px; color: #666;">Love your Malora Organics products or get a full refund.</div>
        </div>
      </div>

      <div class="malora-trust-icons">
        <div>🌿<br>Clean Ingredients</div>
        <div>🇺🇸<br>Made in USA</div>
        <div>🚚<br>Ships Fast</div>
        <div>🏅<br>100% Organic</div>
      </div>

      <!-- Bundle & Save Upsell -->
      <div class="malora-bundle-upsell">
        <div class="malora-bundle-upsell-title">✨ Save More With Curated Bundles</div>
        {% assign bundle_handles = 'stretch-mark-bundle,mama-and-baby-bundle,pregnancy-survival-kit' | split: ',' %}
        {% for b_handle in bundle_handles %}
          {% assign b_prod = all_products[b_handle] %}
          {% if b_prod != blank and b_prod.id != product.id %}
            <div class="malora-bundle-item">
              {% if b_prod.featured_image %}
                <img src="{{ b_prod.featured_image | image_url: width: 150 }}" alt="{{ b_prod.title | escape }}">
              {% endif %}
              <div class="malora-bundle-item-info">
                <a href="{{ b_prod.url }}" class="malora-bundle-item-name">{{ b_prod.title }}</a>
                <div class="malora-bundle-item-price">{{ b_prod.price | money }}</div>
              </div>
              <button
                type="button"
                class="malora-bundle-add-btn"
                data-quick-add-id="{{ b_prod.selected_or_first_available_variant.id }}"
              >
                + Add Bundle
              </button>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="malora-description rte">
        {{ product.description }}
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="MaloraProductVariantsJson">
  {{ product.variants | json }}
</script>

<script>
(function() {
  const variantsJsonEl = document.getElementById('MaloraProductVariantsJson');
  if (!variantsJsonEl) return;
  const variants = JSON.parse(variantsJsonEl.textContent || '[]');
  const selectedOptions = [];

  document.querySelectorAll('.malora-option-group').forEach(group => {
    const idx = parseInt(group.dataset.optionIndex, 10);
    const activePill = group.querySelector('.malora-pill.is-selected');
    if (activePill) selectedOptions[idx] = activePill.dataset.value;
  });

  // Gallery thumbnails
  const mainImg = document.getElementById('MaloraMainProductImg');
  document.querySelectorAll('.malora-thumb-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.malora-thumb-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      if (mainImg) mainImg.src = btn.dataset.fullSrc;
    });
  });

  // Variant selection
  document.querySelectorAll('.malora-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const idx = parseInt(pill.dataset.optionIndex, 10);
      const val = pill.dataset.value;
      selectedOptions[idx] = val;

      const group = pill.closest('.malora-option-group');
      group.querySelectorAll('.malora-pill').forEach(p => p.classList.remove('is-selected'));
      pill.classList.add('is-selected');
      const labelSpan = group.querySelector('.malora-selected-val');
      if (labelSpan) labelSpan.textContent = val;

      const matched = variants.find(v => {
        return selectedOptions.every((optVal, i) => v.options[i] === optVal);
      });

      if (matched) {
        const atcBtn = document.getElementById('MaloraAddToCartBtn');
        const priceEl = document.getElementById('MaloraPrice');
        if (atcBtn) {
          atcBtn.dataset.variantId = matched.id;
          atcBtn.disabled = !matched.available;
          atcBtn.textContent = matched.available ? 'ADD TO CART' : 'SOLD OUT';
        }
        if (priceEl) {
          priceEl.textContent = '$' + (matched.price / 100).toFixed(2).replace(/\.00$/, '');
        }
        if (matched.featured_image && matched.featured_image.src && mainImg) {
          mainImg.src = matched.featured_image.src;
        }
      }
    });
  });

  // Quantity controls
  let qty = 1;
  const qtyValEl = document.getElementById('MaloraQtyVal');
  document.getElementById('MaloraQtyMinus')?.addEventListener('click', () => {
    if (qty > 1) {
      qty--;
      qtyValEl.textContent = qty;
    }
  });
  document.getElementById('MaloraQtyPlus')?.addEventListener('click', () => {
    qty++;
    qtyValEl.textContent = qty;
  });

  // Add to cart helper
  async function addToCart(variantId, quantity, btn) {
    const origText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'ADDING...';
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(variantId), quantity: Number(quantity) }] })
      });
      if (res.ok) {
        btn.textContent = 'ADDED!';
        // Trigger cart drawer if available
        if (window.willaCartDrawer && typeof window.willaCartDrawer.open === 'function') {
          window.willaCartDrawer.open();
        } else {
          document.dispatchEvent(new CustomEvent('cart:updated'));
          window.location.href = '/cart';
        }
        setTimeout(() => {
          btn.disabled = false;
          btn.textContent = origText;
        }, 1200);
      } else {
        throw new Error('Failed to add to cart');
      }
    } catch (e) {
      btn.disabled = false;
      btn.textContent = origText;
    }
  }

  document.getElementById('MaloraAddToCartBtn')?.addEventListener('click', function() {
    addToCart(this.dataset.variantId, qty, this);
  });

  document.querySelectorAll('.malora-bundle-add-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      addToCart(this.dataset.quickAddId, 1, this);
    });
  });
})();
</script>

{% schema %}
{
  "name": "Malora PDP Main",
  "settings": []
}
{% endschema %}
