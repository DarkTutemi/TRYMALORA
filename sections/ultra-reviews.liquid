<section class="uo-reviews-section">
  <div class="uo-wrap">
    <div class="uo-reviews-grid">
      <!-- Left Column -->
      <div class="uo-reviews-intro">
        <h2 class="uo-heading-serif">{{ section.settings.title }}</h2>
        <div class="uo-star-row">
          ★★★★★
        </div>
        <p>{{ section.settings.subhead }}</p>
      </div>

      <!-- Right 3 Review Cards -->
      <div class="uo-reviews-cards">
        <!-- Review 1 -->
        <div class="uo-review-card">
          <div>
            <div class="uo-review-stars">★★★★★</div>
            <div class="uo-review-quote">“Finally, no more midnight sheet changes!”</div>
            <div class="uo-review-body">
              The coverage is amazing and it actually keeps me dry all night. I can sleep through my heavy days without worry now.
            </div>
          </div>
          <div class="uo-reviewer-info">
            <img src="{{ 'ultra-avatar-emily.jpg' | asset_url }}" alt="Emily R." class="uo-reviewer-avatar">
            <div class="uo-reviewer-meta">
              <span class="uo-reviewer-name">Emily R.</span>
              <span class="uo-reviewer-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Verified Buyer
              </span>
            </div>
          </div>
        </div>

        <!-- Review 2 -->
        <div class="uo-review-card">
          <div>
            <div class="uo-review-stars">★★★★★</div>
            <div class="uo-review-quote">“Perfect for side sleepers.”</div>
            <div class="uo-review-body">
              I'm a side sleeper and usually always had leaks with other period underwear. This one stays in place and gives me real peace of mind.
            </div>
          </div>
          <div class="uo-reviewer-info">
            <img src="{{ 'ultra-avatar-nicole.jpg' | asset_url }}" alt="Nicole M." class="uo-reviewer-avatar">
            <div class="uo-reviewer-meta">
              <span class="uo-reviewer-name">Nicole M.</span>
              <span class="uo-reviewer-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Verified Buyer
              </span>
            </div>
          </div>
        </div>

        <!-- Review 3 -->
        <div class="uo-review-card">
          <div>
            <div class="uo-review-stars">★★★★★</div>
            <div class="uo-review-quote">“So comfortable and reliable.”</div>
            <div class="uo-review-body">
              It feels soft, fits beautifully, and handles my heaviest nights with no issues. I've already ordered a second set!
            </div>
          </div>
          <div class="uo-reviewer-info">
            <img src="{{ 'ultra-avatar-jasmine.jpg' | asset_url }}" alt="Jasmine T." class="uo-reviewer-avatar">
            <div class="uo-reviewer-meta">
              <span class="uo-reviewer-name">Jasmine T.</span>
              <span class="uo-reviewer-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Verified Buyer
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ultra Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by Women Who Sleep Deeper"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Real experiences from women who trust ULTRA OVERNIGHT™ for their heaviest nights."
    }
  ],
  "presets": [
    {
      "name": "Ultra Reviews"
    }
  ]
}
{% endschema %}

