<section class="uo-faq-section" id="ultra-faq">
  <div class="uo-wrap">
    <div class="uo-faq-header">
      <span class="uo-eyebrow">{{ section.settings.eyebrow | default: 'CLARITY & DETAILS' }}</span>
      <h2 class="uo-heading-serif uo-faq-title">{{ section.settings.title | default: 'Frequently Asked Questions' }}</h2>
      <p class="uo-faq-subhead">{{ section.settings.subhead | default: 'Clear, transparent answers about our design, fit, care, and upcoming release.' }}</p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="uo-faq-list">
      <!-- Q1 -->
      <div class="uo-faq-item is-active">
        <button type="button" class="uo-faq-trigger" aria-expanded="true">
          <span>What is Full-Spine™ coverage?</span>
          <span class="uo-faq-icon">+</span>
        </button>
        <div class="uo-faq-content">
          <div class="uo-faq-body">
            Unlike traditional period underwear with a small central gusset, Full-Spine™ architecture extends protective absorbent coverage all the way from the front waistband across the entire posterior seat up to the rear waistband. This continuous barrier is designed to catch flow whether you sleep on your back, stomach, or side.
          </div>
        </div>
      </div>

      <!-- Q2 -->
      <div class="uo-faq-item">
        <button type="button" class="uo-faq-trigger" aria-expanded="false">
          <span>How does the 5-layer system protect against leaks?</span>
          <span class="uo-faq-icon">+</span>
        </button>
        <div class="uo-faq-content">
          <div class="uo-faq-body">
            Our 5-layer system combines: (1) a soft moisture-wicking top layer, (2) a rapid distribution layer, (3) a high-capacity absorbency core, (4) a breathable leak-blocking membrane, and (5) a soft CloudFlex™ modal outer shell to keep moisture securely locked inside.
          </div>
        </div>
      </div>

      <!-- Q3 -->
      <div class="uo-faq-item">
        <button type="button" class="uo-faq-trigger" aria-expanded="false">
          <span>How do I find my best size?</span>
          <span class="uo-faq-icon">+</span>
        </button>
        <div class="uo-faq-content">
          <div class="uo-faq-body">
            We offer 8 sizes spanning XS through 4XL. Click the "Size Guide ↗" link in the buy box to review waist and hip guidelines. If you prefer a more relaxed fit for sleeping or fall between two sizes, we recommend ordering one size up.
          </div>
        </div>
      </div>

      <!-- Q4 -->
      <div class="uo-faq-item">
        <button type="button" class="uo-faq-trigger" aria-expanded="false">
          <span>How do I wash and care for the underwear?</span>
          <span class="uo-faq-icon">+</span>
        </button>
        <div class="uo-faq-content">
          <div class="uo-faq-body">
            Simple 3-step routine: (1) Rinse in cold water after waking until water runs clear. (2) Machine wash cold on a gentle cycle with mild detergent. (3) Hang dry or lay flat. Avoid bleach, fabric softeners, or high-heat tumble dryers.
          </div>
        </div>
      </div>

      <!-- Q5 -->
      <div class="uo-faq-item">
        <button type="button" class="uo-faq-trigger" aria-expanded="false">
          <span>Can I customize sizes and colors in a bundle?</span>
          <span class="uo-faq-icon">+</span>
        </button>
        <div class="uo-faq-content">
          <div class="uo-faq-body">
            Yes. Our interactive Mix &amp; Match customizer allows you to choose different sizes and colors for each individual pair in your 3-pack or 5-pack bundle.
          </div>
        </div>
      </div>

      <!-- Q6 -->
      <div class="uo-faq-item">
        <button type="button" class="uo-faq-trigger" aria-expanded="false">
          <span>When will official orders open?</span>
          <span class="uo-faq-icon">+</span>
        </button>
        <div class="uo-faq-content">
          <div class="uo-faq-body">
            FULL-SPINE ULTRA OVERNIGHT™ is in its final pre-production stage. Commercial release and inventory will open soon. Sign up via the Early Access link above to receive priority ordering access.
          </div>
        </div>
      </div>
    </div>

    <!-- Final CTA Card Embedded at End of Section 11 -->
    <div class="uo-final-cta-card">
      <div class="uo-final-cta-grid">
        <div class="uo-final-cta-visual">
          <img 
            src="{{ 'ultra-pdp-main.jpg' | asset_url }}" 
            alt="FULL-SPINE ULTRA OVERNIGHT™" 
            class="uo-final-cta-img"
            width="320" 
            height="320"
            loading="lazy"
          >
        </div>
        <div class="uo-final-cta-content">
          <span class="uo-eyebrow" style="color:var(--uo-plum);">RESTFUL NIGHTS AWAIT</span>
          <h3 class="uo-heading-serif uo-final-cta-heading">Full-Spine Protection for Deeper, Worry-Free Sleep.</h3>
          <p class="uo-final-cta-desc">Experience five-layer fluid security, extended rear coverage, and CloudFlex™ comfort crafted for every sleeping position.</p>
          <div class="uo-final-cta-action">
            <button type="button" class="uo-btn-primary uo-final-cta-btn" onclick="scrollToUoBuyBox()">
              COMING SOON — VIEW OPTIONS ➔
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Ultra FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CLARITY & DETAILS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Clear, transparent answers about our design, fit, care, and upcoming release."
    }
  ],
  "presets": [
    {
      "name": "Ultra FAQ"
    }
  ]
}
{% endschema %}
