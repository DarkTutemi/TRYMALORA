{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Pill Badge Text",
      "default": "CURATED STOREFRONT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured New Releases & Best Sellers"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheadline",
      "default": "Explore our full catalog of active interactive play, automotive surface restoration, home renovation coatings, and personal styling essentials."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}

<style>
  .tm-featured-section {
    background-color: var(--zv-pdp-bg, #FFF8F5);
    padding: 72px 0 80px;
    border-bottom: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px;
  }

  .tm-pill {
    display: inline-block;
    background: #FBEDE8;
    color: #6B1E46;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 14px;
    border: 1px solid #EAD7DD;
  }

  .tm-section-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    letter-spacing: -0.6px;
    line-height: 1.18;
    margin: 0 0 16px;
  }

  .tm-section-subhead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  /* Responsive Grid: Desktop 4 cols, Tablet 2-3 cols, Mobile 2 cols */
  .tm-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  @media screen and (max-width: 1100px) {
    .tm-products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 820px) {
    .tm-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media screen and (max-width: 480px) {
    .tm-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  /* Product Card */
  .tm-product-card {
    background: #FFFFFF;
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    box-shadow: 0 4px 16px rgba(43, 27, 36, 0.04);
  }

  .tm-product-card:hover {
    transform: translateY(-4px);
    border-color: var(--zv-pdp-accent, #B0476E);
    box-shadow: 0 10px 28px rgba(43, 27, 36, 0.09);
  }

  .tm-card-media-wrap {
    position: relative;
    background: #FAF5F2;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .tm-card-badge {
    position: absolute;
    z-index: 2;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.6px;
    padding: 4px 10px;
    border-radius: 6px;
    text-transform: uppercase;
  }

  .tm-badge-sale {
    top: 10px;
    left: 10px;
    background: #6B1E46;
    color: #FFFFFF;
  }

  .tm-badge-hot {
    top: 10px;
    right: 10px;
    background: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FED7AA;
  }

  .tm-card-media-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .tm-card-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .tm-product-card:hover .tm-card-img {
    transform: scale(1.04);
  }

  .tm-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  @media screen and (max-width: 480px) {
    .tm-card-body {
      padding: 12px 10px;
    }
  }

  .tm-card-category {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--zv-pdp-accent, #B0476E);
    margin-bottom: 4px;
  }

  .tm-card-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 8px;
    color: var(--zv-pdp-heading, #2B1B24);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 42px;
  }

  @media screen and (max-width: 480px) {
    .tm-card-title {
      font-size: 13.5px;
      min-height: 38px;
    }
  }

  .tm-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .tm-card-title a:hover {
    color: var(--zv-pdp-cta, #6B1E46);
  }

  .tm-card-pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }

  .tm-live-price {
    font-size: 17px;
    font-weight: 800;
    color: var(--zv-pdp-cta, #6B1E46);
  }

  .tm-old-price {
    font-size: 13.5px;
    color: #8C7882;
    text-decoration: line-through;
  }

  .tm-card-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tm-btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #6B1E46;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    border: none;
    transition: background 0.2s ease;
  }

  .tm-btn-primary:hover {
    background: #4F1332;
  }

  /* Trust Strip */
  .tm-trust-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 32px;
    padding-top: 32px;
    border-top: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-size: 13.5px;
    font-weight: 700;
    color: #4A3841;
  }

  .tm-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>

