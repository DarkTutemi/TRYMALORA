{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Pill Badge Text",
      "default": "FEATURED RELEASES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Interactive Toys & Active Play"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheadline",
      "default": "Engineered for screen-free physical battles, wall target practice, and unforgettable family tournaments."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}

{%- liquid
  assign target_col = collections[section.settings.collection]
  if target_col == blank or target_col.products_count == 0
    assign target_col = collections['frontpage']
  endif
  if target_col == blank or target_col.products_count == 0
    assign target_col = collections['interactive-toys']
  endif
-%}

<section class="tm-featured-section">
  <div class="willa-container">
    <div class="tm-section-header">
      <span class="tm-pill">{{ section.settings.pill_text | default: 'FEATURED RELEASES' }}</span>
      <h2 class="tm-section-title">{{ section.settings.heading | default: 'Interactive Toys & Active Play' }}</h2>
      <p class="tm-section-subhead">{{ section.settings.subhead | default: 'Engineered for screen-free physical battles, wall target practice, and unforgettable family tournaments.' }}</p>
    </div>

    <div class="tm-products-grid">
      {% if target_col != blank and target_col.products.size > 0 %}
        {% for product in target_col.products limit: 6 %}
          {%- liquid
            assign current_variant = product.selected_or_first_available_variant
            assign compare_price = current_variant.compare_at_price | default: product.compare_at_price
            assign live_price = current_variant.price | default: product.price
            assign has_savings = false
            if compare_price > live_price
              assign has_savings = true
              assign savings_pct = compare_price | minus: live_price | times: 100.0 | divided_by: compare_price | round
            endif
            assign prod_image = product.featured_image
            if product.handle contains 'infrared' or product.handle contains 'battle' or product.handle contains 'laser'
              assign prod_cutout = 'infrared-battle-set-cutout.png' | asset_url
            endif
          -%}
          <div class="tm-product-card" data-product-handle="{{ product.handle }}">
            <div class="tm-card-media-wrap">
              {% if has_savings %}
                <span class="tm-card-badge tm-badge-sale">SAVE {{ savings_pct }}%</span>
              {% endif %}
              <span class="tm-card-badge tm-badge-hot">🔥 BEST SELLER</span>

              <a href="{{ product.url }}" class="tm-card-media-link" aria-label="{{ product.title | escape }}">
                {% if prod_cutout != blank %}
                  <img 
                    src="{{ prod_cutout }}" 
                    alt="{{ product.title | escape }}" 
                    class="tm-card-img tm-cutout-img"
                    loading="lazy"
                    width="400"
                    height="300"
                  >
                {% elsif prod_image %}
                  <img 
                    src="{{ prod_image | image_url: width: 600 }}" 
                    alt="{{ product.title | escape }}" 
                    class="tm-card-img"
                    loading="lazy"
                    width="400"
                    height="300"
                  >
                {% endif %}
              </a>
            </div>

            <div class="tm-card-body">
              <div class="tm-card-rating">
                <span class="tm-stars">★★★★★</span>
                <span class="tm-score">4.9</span>
                <span class="tm-verified">Verified Choice</span>
              </div>

              <h3 class="tm-card-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <ul class="tm-card-features">
                <li><span>✓</span> 2 Tactical Blasters + 1 Target Projector</li>
                <li><span>✓</span> 180° Dynamic Wall Target Arena Mode</li>
                <li><span>✓</span> 100% Eye-Safe Optical Infrared (Zero Darts)</li>
              </ul>

              <div class="tm-card-pricing">
                <span class="tm-live-price">{{ live_price | money }}</span>
                {% if has_savings %}
                  <span class="tm-old-price">{{ compare_price | money }}</span>
                  <span class="tm-savings-tag">Save {{ savings_pct }}%</span>
                {% endif %}
              </div>

              <div class="tm-card-actions">
                <a href="{{ product.url }}" class="tm-btn-primary">
                  <span>VIEW PRODUCT &amp; BUNDLES</span>
                  <span class="tm-arrow">➔</span>
                </a>
                <button 
                  type="button" 
                  class="tm-btn-secondary"
                  onclick="quickAddToCart('{{ current_variant.id }}')"
                  aria-label="Add {{ product.title | escape }} to cart"
                >
                  <span>ADD TO CART</span>
                </button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Guaranteed Flagship Product Card (Infrared Battle Set) -->
        <div class="tm-product-card">
          <div class="tm-card-media-wrap">
            <span class="tm-card-badge tm-badge-sale">SAVE 50%</span>
            <span class="tm-card-badge tm-badge-hot">🔥 BEST SELLER</span>

            <a href="/products/kids-infrared-battle-blaster-set-with-target-projector" class="tm-card-media-link">
              <img 
                src="{{ 'infrared-battle-set-cutout.png' | asset_url }}" 
                alt="Infrared Laser Battle Set" 
                class="tm-card-img tm-cutout-img"
                loading="lazy"
                width="400"
                height="300"
              >
            </a>
          </div>

          <div class="tm-card-body">
            <div class="tm-card-rating">
              <span class="tm-stars">★★★★★</span>
              <span class="tm-score">4.9</span>
              <span class="tm-verified">Verified Choice</span>
            </div>

            <h3 class="tm-card-title">
              <a href="/products/kids-infrared-battle-blaster-set-with-target-projector">Infrared Laser Battle Set</a>
            </h3>

            <ul class="tm-card-features">
              <li><span>✓</span> 2 Tactical Blasters + 1 Target Projector</li>
              <li><span>✓</span> 180° Dynamic Wall Target Arena Mode</li>
              <li><span>✓</span> 100% Eye-Safe Optical Infrared (Zero Darts)</li>
            </ul>

            <div class="tm-card-pricing">
              <span class="tm-live-price">$99.99</span>
              <span class="tm-old-price">$199.99</span>
              <span class="tm-savings-tag">Save 50%</span>
            </div>

            <div class="tm-card-actions">
              <a href="/products/kids-infrared-battle-blaster-set-with-target-projector" class="tm-btn-primary">
                <span>VIEW PRODUCT &amp; BUNDLES</span>
                <span class="tm-arrow">➔</span>
              </a>
              <button 
                type="button" 
                class="tm-btn-secondary"
                onclick="window.location.href='/products/kids-infrared-battle-blaster-set-with-target-projector'"
              >
                <span>ORDER NOW</span>
              </button>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Bottom Reassurance Strip -->
    <div class="tm-trust-strip">
      <div class="tm-trust-item">
        <span>🚚</span> Free Express US Shipping Over $49
      </div>
      <div class="tm-trust-item">
        <span>🛡️</span> 30-Day Money-Back Guarantee
      </div>
      <div class="tm-trust-item">
        <span>👁️</span> 100% Eye-Safe Optical Technology
      </div>
      <div class="tm-trust-item">
        <span>🔒</span> 256-Bit SSL Encrypted Checkout
      </div>
    </div>
  </div>
</section>

<style>
  .tm-featured-section {
    background-color: var(--zv-pdp-bg, #FFF8F5);
    padding: 72px 0 80px;
    border-bottom: 1px solid var(--zv-pdp-line, #EAD7DD);
  }

  .tm-section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .tm-pill {
    display: inline-block;
    background: #FBEDE8;
    color: #6B1E46;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 14px;
    border: 1px solid #EAD7DD;
  }

  .tm-section-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 800;
    color: #2B1B24;
    margin: 0 0 12px;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .tm-section-subhead {
    font-size: 15px;
    color: #7A6670;
    line-height: 1.6;
    margin: 0;
  }

  .tm-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 460px));
    justify-content: center;
    gap: 32px;
    margin-bottom: 56px;
  }

  .tm-product-card {
    background: #FFFFFF;
    border: 1px solid #EAD7DD;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(43, 27, 36, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .tm-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(43, 27, 36, 0.1);
    border-color: #D4B2BE;
  }

  .tm-card-media-wrap {
    position: relative;
    background: radial-gradient(circle at center, #FFFFFF 0%, #FAF0EC 100%);
    padding: 36px 24px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    border-bottom: 1px solid #F0DFE4;
  }

  .tm-card-badge {
    position: absolute;
    top: 14px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 4px 10px;
    border-radius: 6px;
    text-transform: uppercase;
    z-index: 2;
  }
  .tm-badge-sale {
    left: 14px;
    background: #6B1E46;
    color: #FFFFFF;
  }
  .tm-badge-hot {
    right: 14px;
    background: #FBEDE8;
    color: #6B1E46;
    border: 1px solid #EAD7DD;
  }

  .tm-card-media-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .tm-card-img {
    max-width: 88%;
    max-height: 220px;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(43, 27, 36, 0.15));
    transition: transform 0.3s ease;
  }

  .tm-product-card:hover .tm-card-img {
    transform: scale(1.04);
  }

  .tm-card-body {
    padding: 24px 26px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tm-card-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    margin-bottom: 8px;
  }
  .tm-stars {
    color: #E58A2B;
    letter-spacing: 1.5px;
  }
  .tm-score {
    font-weight: 800;
    color: #2B1B24;
  }
  .tm-verified {
    color: #7A6670;
    font-size: 11.5px;
  }

  .tm-card-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 21px;
    font-weight: 700;
    margin: 0 0 14px;
    line-height: 1.3;
  }
  .tm-card-title a {
    color: #2B1B24;
    text-decoration: none;
    transition: color 0.15s;
  }
  .tm-card-title a:hover {
    color: #6B1E46;
  }

  .tm-card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tm-card-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #4A3A43;
    line-height: 1.4;
  }
  .tm-card-features li span {
    color: #2E7D32;
    font-weight: 800;
  }

  .tm-card-pricing {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 22px;
    padding-top: 14px;
    border-top: 1px dashed #EAD7DD;
  }
  .tm-live-price {
    font-size: 26px;
    font-weight: 800;
    color: #6B1E46;
    letter-spacing: -0.5px;
  }
  .tm-old-price {
    font-size: 16px;
    color: #9E8E95;
    text-decoration: line-through;
  }
  .tm-savings-tag {
    font-size: 11px;
    font-weight: 800;
    background: #E8F5E9;
    color: #2E7D32;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .tm-card-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  .tm-btn-primary {
    background: #6B1E46;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 14px 20px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(107, 30, 70, 0.25);
  }
  .tm-btn-primary:hover {
    background: #852657;
    transform: translateY(-1px);
    color: #FFFFFF;
  }

  .tm-btn-secondary {
    background: #FBEDE8;
    color: #6B1E46;
    border: 1px solid #EAD7DD;
    border-radius: 12px;
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .tm-btn-secondary:hover {
    background: #F4DBD3;
    border-color: #6B1E46;
  }

  .tm-trust-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 32px;
    padding-top: 32px;
    border-top: 1px solid #EAD7DD;
    font-size: 13px;
    font-weight: 600;
    color: #5C4A54;
  }
  .tm-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .tm-featured-section {
      padding: 48px 0 56px;
    }
    .tm-products-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tm-card-body {
      padding: 18px 18px 22px;
    }
    .tm-trust-strip {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
  }
</style>

<script>
  function quickAddToCart(variantId) {
    if (!variantId) {
      window.location.href = '/products/kids-infrared-battle-blaster-set-with-target-projector';
      return;
    }
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(r => r.json())
    .then(item => {
      if (typeof openWillaCart === 'function') {
        openWillaCart();
      } else {
        window.location.href = '/cart';
      }
    })
    .catch(() => {
      window.location.href = '/cart';
    });
  }
</script>
