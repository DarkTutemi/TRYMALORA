<section class="uo-details-section" id="ultra-product-details">
  <div class="uo-wrap">
    <div class="uo-details-header">
      <span class="uo-eyebrow">{{ section.settings.eyebrow | default: 'IN-DEPTH SPECIFICATIONS' }}</span>
      <h2 class="uo-heading-serif uo-details-title">{{ section.settings.title | default: 'Product Details & Technical Specifications' }}</h2>
      <p class="uo-details-subhead">{{ section.settings.subhead | default: 'Complete transparency into our materials, sizing standards, care rituals, and production roadmap.' }}</p>
    </div>

    <!-- 2-Column Layout: Visual + Accordion -->
    <div class="uo-details-layout">
      <!-- Left Visual: Technical Specification Architecture -->
      <div class="uo-details-visual">
        <img 
          src="https://cdn.shopify.com/s/files/1/1032/4541/4771/files/Thi_t_k_nam_l_p_tho_i_mai_su_t_dem-4.png?v=1794711196" 
          alt="FULL-SPINE ULTRA OVERNIGHT™ Product Details &amp; Technical Specifications" 
          class="uo-details-img"
          width="540" 
          height="540"
          loading="lazy"
        >
      </div>

      <!-- Right: Interactive Accordion Container -->
      <div class="uo-details-accordion" role="region" aria-label="Product Details Accordion">
      
      <!-- Accordion 1: Materials & Construction -->
      <div class="uo-accordion-item is-open">
        <button type="button" class="uo-accordion-header" aria-expanded="true" aria-controls="acc-materials">
          <span class="uo-accordion-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            Materials &amp; Layer Construction
          </span>
          <span class="uo-accordion-icon">−</span>
        </button>
        <div class="uo-accordion-content" id="acc-materials">
          <div class="uo-accordion-body">
            <p><strong>Composite Layering Architecture:</strong></p>
            <ul>
              <li><strong>Body Shell:</strong> 93% MicroModal, 7% Elastane for breathable, feather-light skin contact.</li>
              <li><strong>Top Wick Layer:</strong> Rapid-drying honeycomb polyester mesh designed to pull moisture downward instantly.</li>
              <li><strong>Middle Absorbent Core:</strong> High-density poly-cellulose blend providing extended multi-hour liquid retention.</li>
              <li><strong>Waterproof Barrier:</strong> Breathable polyurethane (TPU) protective membrane preventing liquid pass-through without crinkling.</li>
              <li><strong>Lining:</strong> 100% natural organic cotton gusset surface gentle on sensitive mucous membranes.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Accordion 2: Size & Fit -->
      <div class="uo-accordion-item">
        <button type="button" class="uo-accordion-header" aria-expanded="false" aria-controls="acc-size-fit">
          <span class="uo-accordion-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12h20"></path><path d="M6 12v3"></path><path d="M10 12v2"></path><path d="M14 12v3"></path><path d="M18 12v2"></path>
            </svg>
            Size &amp; Fit Recommendations
          </span>
          <span class="uo-accordion-icon">+</span>
        </button>
        <div class="uo-accordion-content" id="acc-size-fit" style="display:none;">
          <div class="uo-accordion-body">
            <p>Available in 8 inclusive US sizes from XS to 4XL. Engineered with an ergonomic mid-high waist rise and full rear seat coverage.</p>
            <p><strong>Fit Tip:</strong> Underwear should fit snugly against leg contours to optimize side seal coverage. If you fall between two sizes or prefer a looser bedtime feel, we recommend sizing up one size.</p>
            <p><button type="button" class="uo-link-btn" onclick="openUoSizeGuide()">View Complete Sizing Chart ↗</button></p>
          </div>
        </div>
      </div>

      <!-- Accordion 3: Care Instructions -->
      <div class="uo-accordion-item">
        <button type="button" class="uo-accordion-header" aria-expanded="false" aria-controls="acc-care">
          <span class="uo-accordion-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="3"></rect>
              <circle cx="12" cy="13" r="5"></circle>
              <circle cx="6" cy="6" r="1"></circle>
            </svg>
            Care &amp; Wash Routine
          </span>
          <span class="uo-accordion-icon">+</span>
        </button>
        <div class="uo-accordion-content" id="acc-care" style="display:none;">
          <div class="uo-accordion-body">
            <ol>
              <li><strong>Cold Rinse:</strong> Immediately after waking, rinse under cold running water until the runoff is clear.</li>
              <li><strong>Gentle Machine Wash:</strong> Wash with similar dark colors on a cold gentle cycle (max 30°C / 86°F) using mild liquid detergent.</li>
              <li><strong>Hang to Dry:</strong> Lay flat or hang dry in a well-ventilated space. Avoid direct high-heat radiators or tumble dryers to preserve the waterproof membrane.</li>
              <li><strong>Do Not Use:</strong> Bleach, fabric softeners, or harsh stain removers, as they coat the technical absorption fibers and reduce wicking capability.</li>
            </ol>
          </div>
        </div>
      </div>

      <!-- Accordion 4: Shipping & Returns -->
      <div class="uo-accordion-item">
        <button type="button" class="uo-accordion-header" aria-expanded="false" aria-controls="acc-shipping">
          <span class="uo-accordion-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            Shipping &amp; Hygiene Return Policy
          </span>
          <span class="uo-accordion-icon">+</span>
        </button>
        <div class="uo-accordion-content" id="acc-shipping" style="display:none;">
          <div class="uo-accordion-body">
            <p><strong>Domestic US Delivery:</strong> Standard shipping delivers within 3–5 business days. Free standard US shipping is provided on all multi-pair bundle orders over $49.</p>
            <p><strong>Intimate Hygiene Policy:</strong> For customer health and hygiene standards, only unopened, unworn pairs with original tamper-evident seals intact are eligible for return within 30 days of receipt.</p>
          </div>
        </div>
      </div>

      <!-- Accordion 5: Clinical Validation & Quality Standards -->
      <div class="uo-accordion-item">
        <button type="button" class="uo-accordion-header" aria-expanded="false" aria-controls="acc-testing">
          <span class="uo-accordion-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Clinical Validation &amp; Quality Standards
          </span>
          <span class="uo-accordion-icon">+</span>
        </button>
        <div class="uo-accordion-content" id="acc-testing" style="display:none;">
          <div class="uo-accordion-body">
            <p>FULL-SPINE ULTRA OVERNIGHT™ is manufactured under strict ISO 9001 and OEKO-TEX® Standard 100 certified facilities. 100% free of PFAS forever chemicals, toxic phthalates, and synthetic antimicrobial irritants.</p>
            <p>Independently tested and shared by board-certified OB/GYNs on FrontrowMD for superior nighttime coverage and biocompatibility.</p>
          </div>
        </div>
      </div>

    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ultra PDP Tabs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "IN-DEPTH SPECIFICATIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Product Details & Technical Specifications"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Complete transparency into our materials, sizing standards, care rituals, and production roadmap."
    }
  ],
  "presets": [
    {
      "name": "Ultra PDP Tabs"
    }
  ]
}
{% endschema %}
