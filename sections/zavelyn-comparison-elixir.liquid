<section class="zv-comparison-section">
  <div class="zv-section-header">
    <h2>Us Vs. Them</h2>
    <p>See why over 10,000+ families choose Trymalora over generic toy market alternatives.</p>
  </div>

  <div class="zv-comparison-box">
    <table class="zv-comp-table">
      <thead>
        <tr>
          <th>Standard Features</th>
          <th class="zv-brand-col">Trymalora Innovations</th>
          <th class="zv-other-col">Generic Knockoffs</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Build Materials</strong></td>
          <td class="zv-brand-col"><span class="zv-check-icon">✔</span> Impact-Resistant ABS & Tactile Grips</td>
          <td class="zv-other-col"><span class="zv-cross-icon">✘</span> Brittle Recycled Plastic That Cracks</td>
        </tr>
        <tr>
          <td><strong>Interactive Play Mode</strong></td>
          <td class="zv-brand-col"><span class="zv-check-icon">✔</span> 180° Dynamic Wall Target Projector & Arena Sound</td>
          <td class="zv-other-col"><span class="zv-cross-icon">✘</span> Static Paper Targets Or No Projection</td>
        </tr>
        <tr>
          <td><strong>Certified Safety</strong></td>
          <td class="zv-brand-col"><span class="zv-check-icon">✔</span> Eye-Safe Optical Infrared (Zero Physical Projectiles)</td>
          <td class="zv-other-col"><span class="zv-cross-icon">✘</span> High-Power Lasers Or Flying Darts</td>
        </tr>
        <tr>
          <td><strong>Risk-Free Guarantee</strong></td>
          <td class="zv-brand-col"><span class="zv-check-icon">✔</span> 30-Day Money-Back Guarantee</td>
          <td class="zv-other-col"><span class="zv-cross-icon">✘</span> Restrictive Or No Return Policy</td>
        </tr>
        <tr>
          <td><strong>Customer Support</strong></td>
          <td class="zv-brand-col"><span class="zv-check-icon">✔</span> Dedicated US Support (support@trymalora.com)</td>
          <td class="zv-other-col"><span class="zv-cross-icon">✘</span> Unresponsive Chatbots</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
