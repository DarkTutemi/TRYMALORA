{% comment %}
  TRYMALORA PHYSICAL SHOWROOM V5.0 (SHOPIFY OS 2.0 SCHEMA + DYNAMIC BLOCKS)
  - 100% Admin Configurable via Theme Editor Customize
  - Dedicated "Showroom Product" Blocks for each shelf item
  - Transparent Cutout Image Upload with Contact Shadow & Grounding
  - 4 Products per Desktop Shelf / 2 Products per Mobile Shelf
  - Shelf-Edge Channel Price Tags & Spatial Inspection Bay
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}
{{ 'zavelyn-v4-showroom.css' | asset_url | stylesheet_tag }}

{% assign bg_color = section.settings.bg_color | default: '#FAF6F3' %}
{% assign text_color = section.settings.text_color | default: '#2B1B24' %}
{% assign shelf_wood_color = section.settings.shelf_wood_color | default: '#C89D66' %}
{% assign shelf_fascia_color = section.settings.shelf_fascia_color | default: '#A67C46' %}
{% assign badge_color = section.settings.badge_color | default: '#6B1E46' %}
{% assign price_color = section.settings.price_color | default: '#191919' %}
{% assign tag_bg_color = section.settings.tag_bg_color | default: '#FFFFFF' %}
{% assign tag_border_color = section.settings.tag_border_color | default: '#EAD7DD' %}
{% assign button_toggle_color = section.settings.button_toggle_color | default: '#6B1E46' %}
{% assign divider_color = section.settings.divider_color | default: '#EAD7DD' %}

<style>
  #shopify-section-{{ section.id }} .zv-showroom-wrapper {
    background-color: {{ bg_color }};
    color: {{ text_color }};
  }
  #shopify-section-{{ section.id }} .zv-showroom-h1 {
    color: #FFF8F5 !important;
  }
  #shopify-section-{{ section.id }} .zv-showroom-desc {
    color: #EAD7DD !important;
  }
  #shopify-section-{{ section.id }} .zv-shelf-style-badge {
    background: {{ badge_color }};
    color: #FFFFFF;
  }
  #shopify-section-{{ section.id }} .zv-wood-top-surface {
    background: linear-gradient(90deg, 
      {{ shelf_wood_color | color_darken: 28 }} 0%, 
      {{ shelf_wood_color | color_darken: 14 }} 15%, 
      {{ shelf_wood_color }} 50%, 
      {{ shelf_wood_color | color_darken: 14 }} 85%, 
      {{ shelf_wood_color | color_darken: 28 }} 100%) !important;
  }
  #shopify-section-{{ section.id }} .zv-wood-front-fascia {
    background: linear-gradient(180deg, 
      {{ shelf_fascia_color }} 0%, 
      {{ shelf_fascia_color | color_darken: 15 }} 40%, 
      {{ shelf_fascia_color | color_darken: 35 }} 100%) !important;
    border-top-color: {{ shelf_fascia_color | color_lighten: 20 }} !important;
  }
  #shopify-section-{{ section.id }} .zv-tag-card {
    background: {{ tag_bg_color }} !important;
    border-color: {{ tag_border_color }} !important;
  }
  #shopify-section-{{ section.id }} .zv-tag-badge {
    background: {{ badge_color }} !important;
    color: #FFFFFF !important;
    border: 1px solid {{ badge_color }} !important;
    font-size: 9px !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    padding: 2px 6px !important;
    border-radius: 3px !important;
    line-height: 1.2 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  #shopify-section-{{ section.id }} .zv-tag-price-curr {
    color: {{ price_color }} !important;
  }
  #shopify-section-{{ section.id }} .zv-view-btn.active {
    background: #FFF8F5 !important;
    color: #6B1E46 !important;
    border-color: #FFF8F5 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25) !important;
  }
  #shopify-section-{{ section.id }} .zv-view-btn.active svg {
    color: #6B1E46 !important;
    stroke: #6B1E46 !important;
  }
  #shopify-section-{{ section.id }} .zv-fixture-column {
    border-color: {{ divider_color }} !important;
  }
  {% if section.settings.product_gap %}
    #shopify-section-{{ section.id }} .zv-shelf-columns-grid {
      gap: {{ section.settings.product_gap }}px;
    }
  {% endif %}
  {% if section.settings.shelf_gap %}
    #shopify-section-{{ section.id }} .zv-shelf-tier {
      margin-bottom: {{ section.settings.shelf_gap }}px;
    }
  {% endif %}
  {% if section.settings.price_tag_width %}
    #shopify-section-{{ section.id }} .zv-shelf-clip-tag {
      width: {{ section.settings.price_tag_width }}px;
    }
  {% endif %}
</style>

<div class="zv-showroom-wrapper shelf-theme-wood" id="zvShowroomWrapper-{{ section.id }}">

  <!-- =======================================================================
       1. SHOWROOM ATMOSPHERIC ARCHITECTURAL HEADER
       ======================================================================= -->
  <header class="zv-showroom-header">
    <div class="zv-container">
      <div class="zv-showroom-title-row">
        <div>
          <div class="zv-showroom-eyebrow">
            <span>{{ section.settings.eyebrow_text | default: "🏛️ TRYMALORA RETAIL ENVIRONMENT" }}</span>
            <span>&middot;</span>
            <span class="zv-shelf-style-badge">{{ section.settings.badge_text | default: "Architecture Department" }}</span>
          </div>
          <h1 class="zv-showroom-h1">{{ section.settings.heading | default: collection.title | default: "TRYMALORA Physical Showroom" }}</h1>
          <div class="zv-showroom-desc">
            {{ section.settings.description | default: collection.description | default: "Step into our physical retail showroom. Products are displayed on authentic architectural shelves. Click any item to pull it forward for spatial inspection and instant checkout." }}
          </div>
        </div>

        <!-- Controls Toolbar (View Toggle & Inventory Count) -->
        <div class="zv-showroom-toolbar">
          <div class="zv-showroom-stats">
            <span class="zv-live-status-dot"></span>
            {% assign visible_blocks_count = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'showroom_product' and block.settings.show_product != false %}
                {% assign visible_blocks_count = visible_blocks_count | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% if section.settings.items_count_text != blank %}
              {{ section.settings.items_count_text }}
            {% elsif visible_blocks_count > 0 %}
              <strong>{{ visible_blocks_count }}</strong> Items on Display
            {% else %}
              <strong>{{ collection.products_count | default: 6 }}</strong> Items on Display
            {% endif %}
          </div>

          <div class="zv-view-switcher" role="group" aria-label="Display View Mode">
            <button type="button" class="zv-view-btn active" data-view-mode="shelf" title="2.5D Physical Showroom Shelves">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
              <span>{{ section.settings.toggle_showroom_label | default: "Showroom" }}</span>
            </button>
            <button type="button" class="zv-view-btn" data-view-mode="grid" title="Standard Catalog Grid">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span>{{ section.settings.toggle_grid_label | default: "Grid" }}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- =======================================================================
       2. 2.5D SHELF SHOWROOM STAGE (PHYSICAL DISPLAY ENVIRONMENT)
       ======================================================================= -->
  <main class="zv-showroom-stage" id="zvShowroomStage">
    
    <!-- Architectural Fixture Columns (Store Wall Frame) -->
    <div class="zv-fixture-column zv-fixture-left" aria-hidden="true"></div>
    <div class="zv-fixture-column zv-fixture-right" aria-hidden="true"></div>

    <div class="zv-container">

      {% assign items_per_shelf = section.settings.desktop_columns | default: 4 %}
      {% if items_per_shelf < 2 %}{% assign items_per_shelf = 4 %}{% endif %}

      {% comment %}
        Determine data source:
        If section.blocks has showroom_product blocks, render them directly.
        Otherwise, fallback to collection.products.
      {% endcomment %}
      {% assign valid_blocks_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'showroom_product' and block.settings.show_product != false %}
          {% assign valid_blocks_count = valid_blocks_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if valid_blocks_count > 0 %}
        {% comment %} RENDER DYNAMIC THEME EDITOR BLOCKS {% endcomment %}
        {% assign active_idx = 0 %}
        {% assign max_shelf_col = items_per_shelf | minus: 1 %}

        {% for block in section.blocks %}
          {% if block.type == 'showroom_product' and block.settings.show_product != false %}
            {% assign mod_index = active_idx | modulo: items_per_shelf %}
            {% assign mod2_index = active_idx | modulo: 2 %}
            {% assign remaining_items = valid_blocks_count | minus: active_idx %}
            {% if remaining_items >= items_per_shelf %}
              {% assign current_row_count = items_per_shelf %}
            {% else %}
              {% assign current_row_count = remaining_items %}
            {% endif %}

            {% comment %} Open a new Desktop Shelf Tier every items_per_shelf blocks {% endcomment %}
            {% if mod_index == 0 %}
              <div class="zv-shelf-tier" data-tier-index="{{ active_idx | divided_by: items_per_shelf }}" data-tier-count="{{ current_row_count }}">
                
                <!-- Overhead Directional Lighting Beam -->
                <div class="zv-fixture-lightbar" aria-hidden="true">
                  {% for i in (1..items_per_shelf) %}
                    {% assign spotlight_pct = i | times: 100.0 | minus: 50.0 | divided_by: items_per_shelf %}
                    <div class="zv-spotlight-beam" style="left: {{ spotlight_pct }}%;"></div>
                  {% endfor %}
                </div>

                <!-- Shelf Stage: Holds continuous wooden plank and product columns -->
                <div class="zv-shelf-stage">

                  <!-- Continuous Wooden Plank (Desktop-Only: >= 992px) -->
                  <div class="zv-continuous-wooden-shelf zv-shelf-desktop-only" aria-hidden="true">
                    <div class="zv-wood-top-surface">
                      <div class="zv-wood-grain-texture"></div>
                      <div class="zv-wood-top-highlight"></div>
                    </div>
                    <div class="zv-wood-front-fascia">
                      <div class="zv-wood-bevel-edge"></div>
                      <div class="zv-wood-front-grain"></div>
                      <div class="zv-wood-bottom-bevel"></div>
                    </div>
                    <div class="zv-wood-under-shadow"></div>
                  </div>

                  <!-- Products Columns Grid -->
                  <div class="zv-shelf-columns-grid zv-grid--{{ current_row_count }}">
            {% endif %}

            {% comment %} Open a Mobile Shelf Pair every 2 products {% endcomment %}
            {% if mod2_index == 0 %}
              {% assign remaining_in_pair = valid_blocks_count | minus: active_idx %}
              {% if remaining_in_pair >= 2 and mod_index != max_shelf_col %}
                {% assign pair_count = 2 %}
              {% else %}
                {% assign pair_count = 1 %}
              {% endif %}

              <div class="zv-shelf-pair zv-pair--{{ pair_count }}" data-pair-count="{{ pair_count }}">
                <!-- Continuous Wooden Plank (Mobile/Tablet-Only: < 992px) -->
                <div class="zv-continuous-wooden-shelf zv-shelf-mobile-only" aria-hidden="true">
                  <div class="zv-wood-top-surface">
                    <div class="zv-wood-grain-texture"></div>
                    <div class="zv-wood-top-highlight"></div>
                  </div>
                  <div class="zv-wood-front-fascia">
                    <div class="zv-wood-bevel-edge"></div>
                    <div class="zv-wood-front-grain"></div>
                    <div class="zv-wood-bottom-bevel"></div>
                  </div>
                  <div class="zv-wood-under-shadow"></div>
                </div>

                <div class="zv-pair-products">
            {% endif %}

            {% comment %} Resolve Product & Pricing Data {% endcomment %}
            {% assign prod = block.settings.product %}
            {% assign prod_title = block.settings.custom_display_title %}
            {% if prod_title == blank and prod != blank %}
              {% assign prod_title = prod.title %}
            {% endif %}
            {% if prod_title == blank %}
              {% assign prod_title = "Showroom Product" %}
            {% endif %}

            {% assign shelf_tag_title = block.settings.shelf_tag_title %}
            {% if shelf_tag_title == blank %}
              {% assign shelf_tag_title = prod_title %}
            {% endif %}

            {% assign prod_url = block.settings.product_url_override %}
            {% if prod_url == blank and prod != blank %}
              {% assign prod_url = prod.url %}
            {% endif %}
            {% if prod_url == blank %}
              {% assign prod_url = "#" %}
            {% endif %}

            {% assign current_variant = prod.selected_or_first_available_variant %}
            {% assign has_compare = false %}
            {% assign save_percent = 0 %}

            {% if block.settings.use_dynamic_price and prod != blank and current_variant != blank %}
              {% assign prod_price = current_variant.price | money %}
              {% if current_variant.compare_at_price > current_variant.price %}
                {% assign has_compare = true %}
                {% assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
                {% assign compare_price_text = current_variant.compare_at_price | money %}
              {% endif %}
            {% elsif block.settings.custom_price_text != blank %}
              {% assign prod_price = block.settings.custom_price_text %}
            {% elsif current_variant != blank %}
              {% assign prod_price = current_variant.price | money %}
            {% else %}
              {% assign prod_price = "$16.99" %}
            {% endif %}

            {% comment %} Cutout Image Resolution {% endcomment %}
            {% assign is_cutout = false %}
            {% assign showroom_img_url = '' %}
            {% if block.settings.cutout_image != blank %}
              {% assign is_cutout = true %}
              {% assign showroom_img_url = block.settings.cutout_image | image_url: width: 800 %}
            {% elsif prod.handle contains 'infrared' or prod.handle contains 'laser' %}
              {% assign is_cutout = true %}
              {% assign showroom_img_url = 'infrared-battle-set-cutout.png' | asset_url %}
            {% elsif prod.featured_image != blank %}
              {% assign showroom_img_url = prod.featured_image | image_url: width: 800 %}
            {% else %}
              {% assign showroom_img_url = 'https://cdn.shopify.com/s/files/1/1032/4541/4771/files/b2.webp?v=1793726274' %}
            {% endif %}

            {% assign display_scale = block.settings.display_scale | default: 100 %}
            {% assign mobile_scale = block.settings.mobile_scale | default: display_scale %}
            {% assign horizontal_offset = block.settings.horizontal_offset | default: 0 %}
            {% assign baseline_offset = block.settings.baseline_offset | default: 0 %}
            {% assign shadow_width = block.settings.shadow_width | default: 75 %}
            {% assign shadow_opacity = block.settings.shadow_opacity | default: 70 | divided_by: 100.0 %}

            {% capture safe_product_json %}
            {
              "id": {{ prod.id | default: active_idx | plus: 1 }},
              "title": {{ prod_title | json }},
              "handle": {{ prod.handle | default: '' | json }},
              "url": {{ prod_url | json }},
              "featured_image": {{ showroom_img_url | json }},
              "variants": [
                {% if prod != blank and prod.variants.size > 0 %}
                  {% for v in prod.variants %}
                    {
                      "id": {{ v.id }},
                      "title": {{ v.title | json }},
                      "price": {{ v.price }},
                      "compare_at_price": {{ v.compare_at_price | default: 0 }},
                      "available": {{ v.available }},
                      "featured_image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 600 | json }}{% else %}{{ showroom_img_url | json }}{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                {% else %}
                  {
                    "id": {{ active_idx | plus: 1 }},
                    "title": "Default",
                    "price": {{ current_variant.price | default: 1699 }},
                    "compare_at_price": 0,
                    "available": true,
                    "featured_image": {{ showroom_img_url | json }}
                  }
                {% endif %}
              ]
            }
            {% endcapture %}

            <!-- Individual Product Column -->
            <div class="zv-shelf-column" data-col-index="{{ mod_index }}" data-product-handle="{{ prod.handle }}" {{ block.shopify_attributes }}>
              
              <!-- A. SHOWROOM 2.5D SHELF VIEW (Active in Showroom Mode) -->
              <div class="zv-showroom-view-wrap">
                <article 
                  class="zv-shelf-item" 
                  data-product-id="{{ prod.id | default: active_idx | plus: 1 }}" 
                  data-product-handle="{{ prod.handle }}"
                  data-product-url="{{ prod_url }}"
                  data-product-json="{{ safe_product_json | escape }}"
                  data-col="{{ mod_index }}"
                  {% if is_cutout and showroom_img_url != '' %}data-cutout-src="{{ showroom_img_url }}"{% endif %}
                  tabindex="0"
                  role="button"
                  aria-label="{{ prod_title | escape }} - {{ prod_price }}"
                >
                  <div 
                    class="zv-merch-display" 
                    style="--shadow-w: {{ shadow_width }}%; --shadow-op: {{ shadow_opacity }}; --shadow-h: 12px;"
                  >
                    {% if is_cutout and showroom_img_url != '' %}
                      <div 
                        class="zv-cutout-container"
                        style="--scale-d: {{ display_scale | divided_by: 100.0 }}; --scale-m: {{ mobile_scale | divided_by: 100.0 }}; --trans-x: {{ horizontal_offset }}px; --trans-y: {{ baseline_offset }}px;"
                      >
                        <img 
                          src="{{ showroom_img_url }}" 
                          alt="{{ prod_title | escape }}" 
                          loading="lazy" 
                          class="zv-merch-img zv-cutout-img"
                          width="320"
                          height="240"
                        >
                      </div>
                      {% if section.settings.enable_shadow != false and block.settings.enable_contact_shadow != false %}
                        <div class="zv-shelf-contact-shadow" aria-hidden="true"></div>
                        <div class="zv-shelf-ambient-shadow" aria-hidden="true"></div>
                      {% endif %}
                    {% else %}
                      <div class="zv-fallback-container">
                        <img 
                          src="{{ showroom_img_url }}" 
                          alt="{{ prod_title | escape }}" 
                          loading="lazy" 
                          class="zv-merch-img zv-fallback-img"
                          width="240"
                          height="240"
                        >
                      </div>
                      {% if section.settings.enable_shadow != false %}
                        <div class="zv-shelf-contact-shadow" style="--shadow-w: 70%; --shadow-op: 0.22;"></div>
                      {% endif %}
                    {% endif %}
                  </div>
                </article>

                <!-- Shelf-Edge Retail Price Tag (Attached to Fascia Rail) -->
                {% if section.settings.enable_retail_tag != false %}
                  <div 
                    class="zv-shelf-clip-tag" 
                    data-product-id="{{ prod.id | default: active_idx | plus: 1 }}"
                    data-product-json="{{ safe_product_json | escape }}"
                    tabindex="0"
                    role="button"
                    aria-label="Inspect {{ shelf_tag_title | escape }} - {{ prod_price }}"
                  >
                    <div class="zv-tag-clip-bracket" aria-hidden="true">
                      <div class="zv-clip-rivet"></div>
                    </div>
                    <div class="zv-tag-card">
                      <div class="zv-tag-meta-row">
                        <span class="zv-tag-dept">{{ block.settings.merchandising_label | default: "TRYMALORA" }}</span>
                        {% if block.settings.short_badge != blank %}
                          <span class="zv-tag-badge">{{ block.settings.short_badge }}</span>
                        {% elsif has_compare %}
                          <span class="zv-tag-badge sale">-{{ save_percent }}%</span>
                        {% else %}
                          <span class="zv-tag-badge">TOP PICK</span>
                        {% endif %}
                      </div>
                      <div class="zv-tag-title" title="{{ shelf_tag_title | escape }}">
                        {{ shelf_tag_title }}
                      </div>
                      <div class="zv-tag-pricing-row">
                        <div class="zv-tag-price-wrap">
                          <span class="zv-tag-price-curr">{{ prod_price }}</span>
                          <span class="zv-tag-unit">USD</span>
                        </div>
                        <div class="zv-tag-rating">
                          <span class="zv-tag-stars">★★★★★</span>
                          <span class="zv-tag-rating-val">{{ block.settings.rating_text | default: "4.9" }}</span>
                        </div>
                      </div>
                      {% if section.settings.enable_quick_look != false %}
                        <div class="zv-tag-action-row">
                          <span class="zv-tag-action-hint">{{ block.settings.shelf_tag_subtext | default: "Quick Look · Inspect ⚡" }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>

              <!-- B. CATALOG GRID CARD VIEW (Active in Grid Mode) -->
              <div class="zv-catalog-view-wrap">
                <div class="zv-cat-card" data-product-id="{{ prod.id | default: active_idx | plus: 1 }}">
                  <a href="{{ prod_url }}" class="zv-cat-card-media" aria-label="{{ prod_title | escape }}">
                    <img 
                      src="{{ showroom_img_url }}" 
                      alt="{{ prod_title | escape }}" 
                      loading="lazy" 
                      width="400" 
                      height="400" 
                      class="zv-cat-card-img" 
                      style="object-fit: contain;"
                    >
                    {% if block.settings.short_badge != blank %}
                      <span class="zv-cat-sale-badge">{{ block.settings.short_badge }}</span>
                    {% elsif has_compare %}
                      <span class="zv-cat-sale-badge">SAVE {{ save_percent }}%</span>
                    {% endif %}
                  </a>
                  <div class="zv-cat-card-body">
                    <div class="zv-cat-rating">
                      <span class="zv-stars">★★★★★</span>
                      <span class="zv-cat-rating-num">{{ block.settings.rating_text | default: "4.9" }}</span>
                      <span class="zv-cat-review-count">{{ block.settings.review_count_text | default: "(2,418)" }}</span>
                    </div>
                    <h3 class="zv-cat-card-title">
                      <a href="{{ prod_url }}" title="{{ prod_title | escape }}">{{ prod_title }}</a>
                    </h3>
                    <div class="zv-cat-price-row">
                      <span class="zv-cat-price-curr">{{ prod_price }}</span>
                      {% if compare_price_text != blank %}
                        <span class="zv-cat-price-old">{{ compare_price_text }}</span>
                      {% endif %}
                    </div>
                    <div class="zv-cat-card-actions">
                      {% if current_variant != blank and current_variant.available %}
                        <button type="button" class="zv-cat-atc-btn" onclick="zvShowroomDirectAddToCart('{{ current_variant.id }}', this)">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                          <span>Add to Cart</span>
                        </button>
                      {% else %}
                        <a href="{{ prod_url }}" class="zv-cat-atc-btn">
                          <span>View Product</span>
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>

            </div> <!-- /.zv-shelf-column -->

            {% assign next_active = active_idx | plus: 1 %}
            {% assign is_last_item = false %}
            {% if next_active == valid_blocks_count %}
              {% assign is_last_item = true %}
            {% endif %}

            {% comment %} Close Mobile Shelf Pair {% endcomment %}
            {% if mod2_index == 1 or is_last_item or mod_index == max_shelf_col %}
                </div> <!-- /.zv-pair-products -->
              </div> <!-- /.zv-shelf-pair -->
            {% endif %}

            {% comment %} Close Desktop Shelf Tier {% endcomment %}
            {% if mod_index == max_shelf_col or is_last_item %}
                    </div> <!-- /.zv-shelf-columns-grid -->
                  </div> <!-- /.zv-shelf-stage -->
                </div> <!-- /.zv-shelf-tier -->
            {% endif %}

            {% assign active_idx = active_idx | plus: 1 %}
          {% endif %}
        {% endfor %}

      {% else %}
        {% comment %} EMPTY / ONBOARDING STATE IN THEME EDITOR {% endcomment %}
        <div style="text-align: center; padding: 60px 20px; background: #FFFFFF; border-radius: 12px; border: 1.5px dashed var(--zv-pdp-line, #EAD7DD); margin: 40px auto; max-width: 600px;">
          <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 12px; color: #2B1B24;">🎨 Physical Showroom Is Ready</h3>
          <p style="font-size: 14px; color: #7A6670; line-height: 1.6; margin-bottom: 20px;">
            In the Shopify Theme Editor sidebar, click <strong>"Add Showroom Product"</strong> below to place your first background-removed product on the architectural shelf.
          </p>
        </div>
      {% endif %}

    </div>
  </main>

  <!-- =======================================================================
       3. POSITIONAL ZOOM: SPATIAL PRODUCT INSPECTION BAY (DESKTOP)
       Anchored directly to the selected shelf item's on-screen coordinates
       ======================================================================= -->
  {% if section.settings.enable_inspect != false %}
    <div class="zv-spatial-inspect-bay" id="zvSpatialInspectBay" aria-hidden="true" role="dialog" aria-modal="true">
      
      <!-- Atmospheric Showroom Dimming Backdrop -->
      <div class="zv-inspect-backdrop" id="zvInspectBackdrop"></div>

      <!-- Active Inspection Stage Container -->
      <div class="zv-inspect-stage-wrap" id="zvInspectStageWrap">

        <!-- Zoomed Product Focal Image (FLIP-animated from shelf position) -->
        <div class="zv-inspect-focal-frame" id="zvInspectFocalFrame">
          <div class="zv-focal-spotlight"></div>
          <img src="" alt="" width="500" height="500" class="zv-focal-img" id="zvInspectFocalImg">
          <div class="zv-focal-ground-shadow"></div>
        </div>

        <!-- Anchored Product Information Panel (Slides out beside the product) -->
        <div class="zv-inspect-anchored-panel" id="zvInspectAnchoredPanel">
          
          <!-- Header & Close Button -->
          <div class="zv-anchored-header">
            <div class="zv-badge zv-badge-forest" style="font-size: 11px;">
              <span>🏛️ SPATIAL SHELF INSPECTION</span>
            </div>
            <button type="button" class="zv-anchored-close-btn" id="zvInspectCloseBtn" aria-label="Return product to shelf">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>

          <!-- Product Identity -->
          <h2 class="zv-anchored-title" id="zvInspectTitle">Product Title</h2>

          <!-- Pricing & Value Strip -->
          <div class="zv-anchored-price-strip">
            <span class="zv-anchored-price-curr" id="zvInspectPriceCurr">$0.00</span>
            <span class="zv-anchored-price-old" id="zvInspectPriceOld">$0.00</span>
            <span class="zv-badge zv-badge-lime" id="zvInspectSaveBadge">SAVE 20%</span>
          </div>

          <!-- Verified Value Props -->
          <ul class="zv-anchored-benefits-list">
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>In stock &middot; Dispatches directly from US warehouse</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>30-Day risk-free home trial with 100% money-back guarantee</span>
            </li>
          </ul>

          <!-- Variant Options Pills Container -->
          <div class="zv-anchored-variants" id="zvInspectVariants"></div>

          <!-- Commerce Action Buttons -->
          <div class="zv-anchored-actions">
            <button type="button" class="zv-btn zv-btn-primary zv-btn-block zv-btn-lg" id="zvInspectAtcBtn">
              <span>ADD TO CART ➔</span>
            </button>
            
            <a href="#" class="zv-anchored-pdp-link" id="zvInspectPdpLink">
              <span>View Full Product Page &amp; Video Reviews &rarr;</span>
            </a>
          </div>

          <!-- Safe Shipping & Security Guarantee -->
          <div class="zv-anchored-trust-footer">
            <span>🔒 256-bit Encrypted Checkout</span>
            <span>&bull;</span>
            <span>🚚 Fast 3-5 Day Delivery</span>
          </div>

        </div>

      </div>
    </div>
  {% endif %}

  <!-- =======================================================================
       4. MOBILE SHOWROOM BOTTOM SHEET (< 768px Viewports)
       ======================================================================= -->
  {% if section.settings.enable_inspect != false %}
    <div class="zv-mobile-sheet-overlay" id="zvMobileSheetOverlay" aria-hidden="true">
      <div class="zv-mobile-sheet" id="zvMobileSheet">
        <div class="zv-mobile-sheet-handle"></div>
        
        <div class="zv-mobile-sheet-header">
          <button type="button" class="zv-mobile-sheet-close" id="zvMobileSheetClose" aria-label="Close bottom sheet">&times;</button>
        </div>

        <div class="zv-mobile-sheet-body">
          <div class="zv-mobile-sheet-img-wrap">
            <img src="" alt="" width="400" height="400" id="zvMobileSheetImg">
          </div>
          
          <h3 id="zvMobileSheetTitle">Product Title</h3>
          
          <div class="zv-mobile-sheet-price-row">
            <span class="zv-mobile-sheet-price" id="zvMobileSheetPrice">$0.00</span>
            <span class="zv-mobile-sheet-compare" id="zvMobileSheetCompare">$0.00</span>
            <span class="zv-badge zv-badge-lime" id="zvMobileSheetSave">SAVE 20%</span>
          </div>

          <div class="zv-mobile-sheet-variants" id="zvMobileSheetVariants"></div>

          <button type="button" class="zv-btn zv-btn-primary zv-btn-block" id="zvMobileSheetAtcBtn" style="margin-top: 16px;">
            <span>ADD TO CART ➔</span>
          </button>

          <a href="#" class="zv-mobile-sheet-pdp" id="zvMobileSheetPdpLink">
            <span>View Full Product Page &amp; Video Reviews &rarr;</span>
          </a>
        </div>
      </div>
    </div>
  {% endif %}



</div>

<script src="{{ 'zavelyn-v4-showroom.js' | asset_url }}" defer></script>

