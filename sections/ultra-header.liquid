{%- liquid
  assign is_legacy_product = false
  if template.name == 'product' and template.suffix != 'ultra-overnight' and template.suffix != 'ultra-lace' and template.suffix != 'ultra-shorts' and product.handle != 'full-spine-ultra-overnight' and product.handle != 'ultra-lace-period-briefs' and product.handle != 'ultra-comfort-period-shorts' and product.handle != 'ultra-overnight'
    assign is_legacy_product = true
  endif
-%}

{%- unless is_legacy_product -%}
<!-- ULTRA OVERNIGHT Announcement Bar -->
{% if section.settings.show_announcement %}
  <div class="uo-announcement-bar">
    <div class="uo-wrap">
      <span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.6 15.5A8.5 8.5 0 0 1 8.5 3.4 8.5 8.5 0 1 0 20.6 15.5Z"/></svg>
        {%- if localization.country.iso_code == 'US' -%}
          {{ section.settings.announcement_text }}
        {%- else -%}
          ★ FREE WORLDWIDE EXPRESS SHIPPING ELIGIBLE · 30-DAY SATISFACTION GUARANTEE ★
        {%- endif -%}
      </span>
    </div>
  </div>
{% endif %}

<!-- ULTRA OVERNIGHT Main Header -->
<header class="uo-header-wrap">
  <div class="uo-wrap">
    <div class="uo-header">
      <!-- Mobile Menu Toggle -->
      <button type="button" class="uo-mobile-menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="uoMobileNavDrawer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Brand Logo -->
      <a href="/" class="uo-logo" aria-label="ULTRA OVERNIGHT Home">
        <img src="{{ 'ultra-logo.svg' | asset_url }}" alt="ULTRA OVERNIGHT" width="220" height="36" loading="eager">
      </a>

      <!-- Primary Navigation -->
      <nav class="uo-nav" aria-label="Primary navigation">
        {%- if section.settings.primary_menu.links.size > 0 -%}
          {%- for link in section.settings.primary_menu.links -%}
            <a href="{{ link.url }}" class="uo-nav-link{% if link.active %} is-active{% endif %}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="/" class="uo-nav-link {% if request.page_type == 'index' %}is-active{% endif %}">Home</a>
          <a href="/collections/ultra-period-underwear" class="uo-nav-link {% if request.path contains '/collections/ultra' %}is-active{% endif %}">Shop All</a>
          <a href="/products/full-spine-ultra-overnight" class="uo-nav-link {% if product.handle == 'full-spine-ultra-overnight' %}is-active{% endif %}">ULTRA OVERNIGHT</a>
          <a href="/products/ultra-lace-period-briefs" class="uo-nav-link {% if product.handle == 'ultra-lace-period-briefs' %}is-active{% endif %}">ULTRA LACE</a>
          <a href="/products/ultra-comfort-period-shorts" class="uo-nav-link {% if product.handle == 'ultra-comfort-period-shorts' %}is-active{% endif %}">ULTRA COMFORT SHORTS</a>
          <a href="/pages/about-us" class="uo-nav-link {% if request.path contains '/pages/about' %}is-active{% endif %}">Our Story</a>
          <a href="/pages/track-order" class="uo-nav-link {% if request.path contains '/pages/track' %}is-active{% endif %}">Track Order</a>
        {%- endif -%}
      </nav>

      <!-- Header Action Icons -->
      <div class="uo-header-actions">
        <!-- Customer Account Icon -->
        <a href="{{ routes.account_url }}" class="uo-header-icon-btn" aria-label="Customer Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>

        <!-- Cart Icon -->
        <button type="button" class="uo-header-icon-btn" onclick="if(typeof openWillaCart === 'function') openWillaCart(); else window.location.href='/cart';" aria-label="View shopping bag">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="uo-cart-badge" id="uoCartCount">{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="uo-mobile-drawer-overlay"></div>
<aside class="uo-mobile-drawer" id="uoMobileNavDrawer" aria-label="Mobile menu" aria-hidden="true">
  <div class="uo-mobile-drawer-header">
    <img src="{{ 'ultra-logo.svg' | asset_url }}" alt="ULTRA OVERNIGHT" width="160" height="26">
    <button type="button" class="uo-mobile-drawer-close" aria-label="Close menu" style="background:none;border:none;font-size:24px;cursor:pointer;color:var(--uo-plum);">&times;</button>
  </div>
  <nav class="uo-mobile-nav" aria-label="Mobile navigation">
    {%- if section.settings.primary_menu.links.size > 0 -%}
      {%- for link in section.settings.primary_menu.links -%}
        <a href="{{ link.url }}" class="uo-mobile-nav-link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }} <span aria-hidden="true">→</span></a>
      {%- endfor -%}
    {%- else -%}
      <a href="/" class="uo-mobile-nav-link">Home <span aria-hidden="true">→</span></a>
      <a href="/collections/ultra-period-underwear" class="uo-mobile-nav-link">Shop All Collection <span aria-hidden="true">→</span></a>
      <a href="/products/full-spine-ultra-overnight" class="uo-mobile-nav-link">ULTRA OVERNIGHT™ <span aria-hidden="true">→</span></a>
      <a href="/products/ultra-lace-period-briefs" class="uo-mobile-nav-link">ULTRA LACE™ <span aria-hidden="true">→</span></a>
      <a href="/products/ultra-comfort-period-shorts" class="uo-mobile-nav-link">ULTRA COMFORT SHORTS™ <span aria-hidden="true">→</span></a>
      <a href="/pages/about-us" class="uo-mobile-nav-link">Our Story <span aria-hidden="true">→</span></a>
      <a href="/pages/track-order" class="uo-mobile-nav-link">Track Order <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </nav>
</aside>
{%- endunless -%}

{% schema %}
{
  "name": "Ultra Header",
  "settings": [
    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "ULTRA Primary Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "FREE US SHIPPING ON ORDERS $70+ · 30-DAY SATISFACTION GUARANTEE"
    }
  ]
}
{% endschema %}
