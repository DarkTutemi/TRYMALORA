          </div>
          <div class="tm-pkg-card">
            <div class="tm-pkg-card-top">
              <div class="tm-pkg-icon-wrap"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg></div>
              <span class="tm-pkg-count-badge">1× INCLUDED</span>
            </div>
