{% comment %}
  TRYMALORA - PACKAGE CONTENTS & UNBOXING SECTION (TASK 14 & 15)
  Refined editorial presentation matching ShopSideK T01 layout.
  Clear component counting, hardware badges, and mandatory battery disclosure.
{% endcomment %}

<style>
  .tm-pkg-section {
    padding: 72px 0;
    background: #FFFFFF;
    border-top: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-bottom: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-pkg-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }

  .tm-pkg-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-tint, #F8E4EB);
    color: var(--zv-pdp-accent, #B0476E);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .tm-pkg-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.18;
    letter-spacing: -0.6px;
    margin: 0 0 12px;
  }

  @media screen and (min-width: 768px) {
    .tm-pkg-title {
      font-size: 38px;
    }
  }

  .tm-pkg-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  .tm-pkg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .tm-pkg-card {
    background: var(--zv-pdp-bg, #FFF8F5);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-radius: var(--zv-radius-md, 12px);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all 0.25s ease;
  }

  .tm-pkg-card:hover {
    border-color: var(--zv-pdp-accent, #B0476E);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(43, 27, 36, 0.05);
  }

  .tm-pkg-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
  }

  .tm-pkg-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--zv-radius-sm, 8px);
    background: #FFFFFF;
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--zv-pdp-accent, #B0476E);
  }

  .tm-pkg-count-badge {
    font-size: 11.5px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-surface, #FBEDE8);
    color: var(--zv-pdp-cta, #6B1E46);
    letter-spacing: 0.5px;
  }

  .tm-pkg-name {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 8px;
  }

  .tm-pkg-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  .tm-battery-notice {
    background: #FFF7ED;
    border: 1px solid #FED7AA;
    border-radius: var(--zv-radius-md, 12px);
    padding: 18px 24px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .tm-battery-icon {
    width: 28px;
    height: 28px;
    color: #C2410C;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .tm-battery-title {
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #9A3412;
    margin-bottom: 4px;
  }

  .tm-battery-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: #7C2D12;
    margin: 0;
  }
</style>

<section class="tm-pkg-section" id="tmPackageContents">
  <div class="zv-container" style="max-width: 1140px; margin: 0 auto; padding: 0 24px;">

    <!-- Section Header -->
    <div class="tm-pkg-header">
      <span class="tm-pkg-chip">
        ✦ FULL RETAIL KIT
      </span>
      <h2 class="tm-pkg-title">
        What's in the Box
      </h2>
      <p class="tm-pkg-subtitle">
        Every TRYMALORA package arrives secured in custom shock-absorbing foam with all hardware needed for instant single-player and team play.
      </p>
    </div>

    <!-- 4 Components Grid -->
    <div class="tm-pkg-grid">

      <!-- Item 1: 2 Blasters -->
      <div class="tm-pkg-card">
        <div class="tm-pkg-card-top">
          <div class="tm-pkg-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-5h12l4 5v3h-4v-2H7v2H3v-3z"></path><circle cx="6.5" cy="17.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
          </div>
          <span class="tm-pkg-count-badge">2× INCLUDED</span>
        </div>
        <h3 class="tm-pkg-name">Tactical Blasters</h3>
        <p class="tm-pkg-desc">
          Ergonomic molded body with integrated infrared receiver, team-color toggle, LED health meter, and tactile recoil vibration.
        </p>
      </div>

      <!-- Item 2: Target Projector -->
      <div class="tm-pkg-card">
        <div class="tm-pkg-card-top">
          <div class="tm-pkg-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
          </div>
          <span class="tm-pkg-count-badge">1× INCLUDED</span>
        </div>
        <h3 class="tm-pkg-name">Target Projector</h3>
        <p class="tm-pkg-desc">
          180° variable-tilt optical projection dome capable of painting roving moving targets across walls, floors, or ceilings.
        </p>
      </div>

      <!-- Item 3: Target Discs -->
      <div class="tm-pkg-card">
        <div class="tm-pkg-card-top">
          <div class="tm-pkg-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
          </div>
          <span class="tm-pkg-count-badge">MULTI-DISC</span>
        </div>
        <h3 class="tm-pkg-name">Target Slide Discs</h3>
        <p class="tm-pkg-desc">
          High-contrast optical films featuring varied speeds, obstacle patterns, and arcade difficulty levels for target tracking.
        </p>
      </div>

      <!-- Item 4: Quickstart Guide -->
      <div class="tm-pkg-card">
        <div class="tm-pkg-card-top">
          <div class="tm-pkg-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </div>
          <span class="tm-pkg-count-badge">1× GUIDE</span>
        </div>
        <h3 class="tm-pkg-name">Quickstart Manual</h3>
        <p class="tm-pkg-desc">
          Illustrated step-by-step setup handbook detailing channel synchronization, safety advice, battery loading, and game modes.
        </p>
      </div>

    </div>

    <!-- Battery Notice Box -->
    <div class="tm-battery-notice">
      <svg class="tm-battery-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="18" height="12" rx="2"></rect><line x1="23" y1="11" x2="23" y2="13"></line><line x1="7" y1="10" x2="7" y2="14"></line><line x1="11" y1="10" x2="11" y2="14"></line></svg>
      <div>
        <div class="tm-battery-title">BATTERY REQUIREMENTS NOTICE</div>
        <p class="tm-battery-text">
          <strong>Batteries are not included in the standard package.</strong> The 2 blasters require <strong>4 × 1.5V AAA</strong> batteries (2 per blaster), and the target projector requires <strong>3 × 1.5V AA</strong> batteries. Standard alkaline batteries are recommended for optimal beam strength and projection brightness.
        </p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Trymalora Package",
  "settings": [],
  "presets": [
    {
      "name": "Trymalora Package"
    }
  ]
}
{% endschema %}
