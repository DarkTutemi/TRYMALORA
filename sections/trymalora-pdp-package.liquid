{% comment %}
  TRYMALORA - PACKAGE CONTENTS & UNBOXING SECTION
  Factual breakdown of included hardware and accessories.
  Explicit battery disclosure to guarantee compliance.
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}

<section class="tm-package-section" style="padding: 60px 0; background: var(--zv-surface-muted, #F8F9F8); border-top: 1px solid var(--zv-border, #E5E7EB); border-bottom: 1px solid var(--zv-border, #E5E7EB);">
  <div class="zv-container" style="max-width: 1120px; margin: 0 auto; padding: 0 20px;">
    
    <div style="text-align: center; max-width: 720px; margin: 0 auto 40px;">
      <span class="zv-badge zv-badge-forest" style="display: inline-block; padding: 5px 14px; border-radius: 999px; background: var(--zv-primary, #17352B); color: #FFFFFF; font-size: 11.5px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 12px;">
        COMPLETE RETAIL SET
      </span>
      <h2 style="font-family: var(--zv-font-heading, sans-serif); font-size: 32px; font-weight: 800; color: var(--zv-heading, #111827); line-height: 1.2; margin: 0 0 12px;">
        What's in the Box
      </h2>
      <p style="font-size: 15.5px; line-height: 1.6; color: var(--zv-body, #4B5563); margin: 0;">
        Each set arrives in protective packaging with all core hardware needed for instant solo target practice and head-to-head multiplayer battles.
      </p>
    </div>

    <!-- Package Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
      
      <!-- Item 1 -->
      <div style="background: #FFFFFF; border: 1.5px solid var(--zv-border, #E5E7EB); border-radius: 12px; padding: 24px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="font-size: 36px; margin-bottom: 12px;">🔫</div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--zv-heading, #111827); margin: 0 0 6px;">2× Tactical Blasters</h3>
        <p style="font-size: 13.5px; line-height: 1.5; color: var(--zv-body, #4B5563); margin: 0;">
          Ergonomic grip, LED health bar, team color selector (Blue/Red/Green/White), and tactile vibration feedback.
        </p>
      </div>

      <!-- Item 2 -->
      <div style="background: #FFFFFF; border: 1.5px solid var(--zv-border, #E5E7EB); border-radius: 12px; padding: 24px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="font-size: 36px; margin-bottom: 12px;">🛸</div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--zv-heading, #111827); margin: 0 0 6px;">1× Target Projector</h3>
        <p style="font-size: 13.5px; line-height: 1.5; color: var(--zv-body, #4B5563); margin: 0;">
          180° adjustable projection lens displaying moving targets on walls or ceilings with built-in score tracking.
        </p>
      </div>

      <!-- Item 3 -->
      <div style="background: #FFFFFF; border: 1.5px solid var(--zv-border, #E5E7EB); border-radius: 12px; padding: 24px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="font-size: 36px; margin-bottom: 12px;">🎯</div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--zv-heading, #111827); margin: 0 0 6px;">Target Slide Discs</h3>
        <p style="font-size: 13.5px; line-height: 1.5; color: var(--zv-body, #4B5563); margin: 0;">
          Dynamic visual target patterns for varied speeds and engaging arcade-style shooting practice.
        </p>
      </div>

      <!-- Item 4 -->
      <div style="background: #FFFFFF; border: 1.5px solid var(--zv-border, #E5E7EB); border-radius: 12px; padding: 24px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="font-size: 36px; margin-bottom: 12px;">📖</div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--zv-heading, #111827); margin: 0 0 6px;">User &amp; Game Manual</h3>
        <p style="font-size: 13.5px; line-height: 1.5; color: var(--zv-body, #4B5563); margin: 0;">
          Clear English illustrated instructions covering team sync, mode setup, battery insertion, and battle rules.
        </p>
      </div>

    </div>

    <!-- Battery Disclosure Alert Box -->
    <div style="background: #FFFBEB; border: 1.5px solid #FDE68A; border-radius: 12px; padding: 18px 24px; display: flex; align-items: center; gap: 16px;">
      <div style="font-size: 28px; flex-shrink: 0;">🔋</div>
      <div>
        <div style="font-size: 14px; font-weight: 800; color: #92400E; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
          Battery Requirements Notice
        </div>
        <div style="font-size: 13.5px; line-height: 1.5; color: #78350F;">
          <strong>Batteries are not included in the package.</strong> The blasters require <strong>4 × 1.5V AAA</strong> batteries (2 per blaster), and the target projector requires <strong>3 × 1.5V AA</strong> batteries. Standard alkaline batteries are recommended.
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Trymalora Package",
  "settings": [],
  "presets": [
    {
      "name": "Trymalora Package"
    }
  ]
}
{% endschema %}
