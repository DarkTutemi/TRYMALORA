{% comment %}
  TRYMALORA - PACKAGE CONTENTS & UNBOXING SECTION (SECTION XIV.A)
  Dynamic per product: What's in the Box tailored to each product handle.
{% endcomment %}

<style>
  .tm-pkg-section {
    padding: 72px 0;
    background: #FFFFFF;
    border-top: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-bottom: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-family: var(--zv-font-body, 'Inter', system-ui, sans-serif);
    color: var(--zv-pdp-text, #2B1B24);
  }

  .tm-pkg-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }

  .tm-pkg-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-tint, #F8E4EB);
    color: var(--zv-pdp-accent, #B0476E);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .tm-pkg-title {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    line-height: 1.18;
    letter-spacing: -0.6px;
    margin: 0 0 12px;
  }

  @media screen and (min-width: 768px) {
    .tm-pkg-title {
      font-size: 38px;
    }
  }

  .tm-pkg-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }

  .tm-pkg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .tm-pkg-card {
    background: var(--zv-pdp-bg, #FFF8F5);
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    border-radius: var(--zv-radius-md, 12px);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all 0.25s ease;
  }

  .tm-pkg-card:hover {
    border-color: var(--zv-pdp-accent, #B0476E);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(43, 27, 36, 0.05);
  }

  .tm-pkg-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
  }

  .tm-pkg-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--zv-radius-sm, 8px);
    background: #FFFFFF;
    border: 1px solid var(--zv-pdp-line, #EAD7DD);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--zv-pdp-accent, #B0476E);
  }

  .tm-pkg-count-badge {
    font-size: 11.5px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: var(--zv-radius-full, 9999px);
    background: var(--zv-pdp-surface, #FBEDE8);
    color: var(--zv-pdp-cta, #6B1E46);
    letter-spacing: 0.5px;
  }

  .tm-pkg-name {
    font-family: var(--zv-font-heading, 'Fraunces', Georgia, serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--zv-pdp-heading, #2B1B24);
    margin: 0 0 8px;
  }

  .tm-pkg-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--zv-pdp-body, #4A3841);
    margin: 0;
  }
</style>

<section class="tm-pkg-section" id="tmPackageContents">
  <div class="zv-container" style="max-width: 1140px; margin: 0 auto; padding: 0 24px;">

    <!-- Section Header -->
    <div class="tm-pkg-header">
      <span class="tm-pkg-chip">
        {{ section.settings.chip_text | default: "✦ FULL RETAIL KIT" }}
      </span>
      <h2 class="tm-pkg-title">
        {{ section.settings.heading | default: "What's in the Box" }}
      </h2>
      <p class="tm-pkg-subtitle">
        {% if section.settings.subtitle != blank %}
          {{ section.settings.subtitle }}
        {% else %}
          {% case product.handle %}
          {% when 'car-metal-rust-repair-paste' %}
            Every package arrives secured with precision applicator tools and factory-sealed automotive metal repair paste.
          {% when 'metal-chrome-polish-restorer-paste' %}
            Every package arrives complete with professional oxidation-removing polish, custom detail brush, and microfiber buffing cloth.
          {% when 'mini-dual-purpose-travel-styling-iron' %}
            Every package arrives in protective cushioning with your travel styling iron, dual-voltage power cord, and user handbook.
          {% when 'tile-refinishing-paint-restoration-kit', 'tile-refinishing-paint-restoration-kit-draft' %}
            Every package arrives complete with high-adhesion tile refinishing paint, detail application brush, and surface prep scuff pad.
          {% when 'metallic-silver-anti-rust-renovation-coating' %}
            Every package arrives secured with water-based metallic silver coating, application brush, and complete renovation instructions.
          {% when 'ear-cleaner' %}
            Every package arrives secured with veterinarian-formulated ear wash, precision soft applicator nozzle, and complete care handbook.
          {% when 'eyvelle-steam-therapy' %}
            Every package arrives securely boxed with your ultrasonic steam therapy wand, medical silicone eye cup, USB-C rapid charging cable, precision dropper, and eye wellness guide.
          {% when 'christmas-lantern-welcome-gnome' %}
            Every package arrives securely protected in collector's holiday gift packaging, featuring your handcrafted woodland gnome, warm-white LED star lantern, and pre-fitted evergreen garland.
          {% else %}
            Every TRYMALORA package arrives secured in custom shock-absorbing foam with all hardware needed for instant single-player and team play.
        {% endcase %}
        {% endif %}
      </p>
    </div>

    <!-- 4 Components Grid -->
    <div class="tm-pkg-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="tm-pkg-card" {{ block.shopify_attributes }}>
            <div class="tm-pkg-card-top">
              <div class="tm-pkg-icon-wrap">
                {% case block.settings.icon %}
                  {% when 'star' %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
                  {% when 'gift' %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                  {% when 'box' %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {% endcase %}
              </div>
              {% if block.settings.badge != blank %}
                <span class="tm-pkg-count-badge">{{ block.settings.badge }}</span>
              {% endif %}
            </div>
            <h3 class="tm-pkg-name">{{ block.settings.title }}</h3>
            <p class="tm-pkg-desc">{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      {% else %}
        {% case product.handle %}
        {% when 'car-metal-rust-repair-paste' %}
          <div class="tm-pkg-card">
            <div class="tm-pkg-card-top">
              <div class="tm-pkg-icon-wrap"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></div>
              <span class="tm-pkg-count-badge">1× INCLUDED</span>
            </div>
            <h3 class="tm-pkg-name">Rust Repair Paste</h3>
