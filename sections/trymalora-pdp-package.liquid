{% schema %}
{
  "name": "Trymalora Package",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Eyebrow Badge",
      "default": "✦ FULL RETAIL KIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What's in the Box"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle (Optional override)"
    }
  ],
  "blocks": [
    {
      "type": "package_item",
      "name": "Included Item Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Craft / Shield" },
            { "value": "star", "label": "Star / Lantern" },
            { "value": "leaf", "label": "Evergreen / Botanical" },
            { "value": "gift", "label": "Gift Box" },
            { "value": "box", "label": "Packaging / Spec" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Card Badge",
          "default": "INCLUDED"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Title",
          "default": "Handcrafted Item"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Item Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trymalora Package"
    }
  ]
}
{% endschema %}
