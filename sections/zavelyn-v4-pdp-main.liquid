{% comment %}
  TRYMALORA - PRODUCT PAGE V2 BUY BOX HERO (ROUND 2: SHOPSIDEK T01 VISUAL MATCH)
  Tasks 1-12: Typography hierarchy (Fraunces + Inter), Warm blush/plum palette,
  Review row above title, Live viewers pill, Kaching-style bundle cards,
  Two-line CTA button, 3-step delivery stepper, Mini review card,
  Native payment icons without container header, Refined minimal accordions.
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}
{{ 'zavelyn-v4-pdp.css' | asset_url | stylesheet_tag }}

{% assign variant_tier_1 = nil %}
{% assign variant_tier_2 = nil %}
{% assign variant_tier_3 = nil %}

{% if product.variants.size > 0 %}
  {% for v in product.variants %}
    {% assign t_title = v.title | downcase %}
    {% if t_title contains '1 set' or t_title contains 'starter' or t_title contains 'single' %}
      {% assign variant_tier_1 = v %}
    {% elsif t_title contains '2 set' or t_title contains 'duo' or t_title contains 'double' %}
      {% assign variant_tier_2 = v %}
    {% elsif t_title contains '3 set' or t_title contains 'family' or t_title contains 'triple' or t_title contains 'arena' %}
      {% assign variant_tier_3 = v %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign prod_title = product.title | default: "Infrared Laser Battle Set" %}
{% assign prod_hero_desc = "Turn ordinary playtime into an interactive adventure with infrared battles, projected targets, and exciting sound effects." %}

{% assign t1_id = variant_tier_1.id | default: "67297621934451" %}
{% assign t1_price = variant_tier_1.price | default: 12900 %}
{% assign t1_compare = variant_tier_1.compare_at_price | default: 25800 %}
{% assign t2_id = variant_tier_2.id | default: "67297622131059" %}
{% assign t2_price = variant_tier_2.price | default: 24510 %}
{% assign t2_compare = 51600 %}
{% assign t3_id = variant_tier_3.id | default: "67297622163827" %}
{% assign t3_price = variant_tier_3.price | default: 32895 %}
{% assign t3_compare = 77400 %}

{% assign t1_savings = t1_compare | minus: t1_price %}
{% assign t2_savings = t2_compare | minus: t2_price %}
{% assign t3_savings = t3_compare | minus: t3_price %}

{% assign base_price_dollars = t1_price | divided_by: 100.0 %}
{% assign threshold_setting = section.settings.merchandising_threshold | default: 50 %}
{% assign order_setting = section.settings.bundle_order_override | default: 'auto' %}

{% if order_setting == 'ascending' %}
  {% assign is_ascending = true %}
{% elsif order_setting == 'descending' %}
  {% assign is_ascending = false %}
{% else %}
  {% if base_price_dollars >= threshold_setting %}
    {% assign is_ascending = true %}
  {% else %}
    {% assign is_ascending = false %}
  {% endif %}
{% endif %}

<section 
  class="zv-pdp-hero" 
  id="zvBuyBox"
  data-initial-variant-id="{{ t1_id }}"
  data-initial-price="{{ t1_price }}"
  data-initial-compare="{{ t1_compare }}"
>
  <div class="zv-container" style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
    <div class="zv-pdp-grid">

      <!-- LEFT COLUMN: STICKY GALLERY (SHOPSIDEK T01 PROPORTIONS) -->
      <div class="zv-pdp-gallery-col">
        <div class="zv-pdp-main-media">
          <span class="zv-pdp-save-badge">TOP RATED · KIDS &amp; FAMILY</span>

          {% if product.featured_image %}
            <img 
              id="zvMainImg" 
              src="{{ product.featured_image | image_url: width: 1024 }}" 
              alt="{{ prod_title | escape }}" 
              class="zv-pdp-main-img"
              width="600"
              height="600"
              loading="eager"
            >
          {% else %}
            <img 
              id="zvMainImg" 
              src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" 
              alt="{{ prod_title | escape }}" 
              class="zv-pdp-main-img"
              width="600"
              height="600"
              loading="eager"
            >
          {% endif %}
        </div>

        <!-- Thumbnails -->
        <div class="zv-pdp-thumbs">
          {% if product.images.size > 1 %}
            {% for img in product.images limit: 8 %}
              <div class="zv-pdp-thumb {% if forloop.first %}active{% endif %}" data-src="{{ img | image_url: width: 1024 }}">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | escape }}" width="80" height="80" loading="lazy">
              </div>
            {% endfor %}
          {% else %}
            <div class="zv-pdp-thumb active" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" alt="Target Projector and Blasters" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png" alt="Dynamic Target Training" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png" alt="Multiplayer Battle Mode" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_e96c06fafc655ed1c5a79a0092569a05_bad627ce-b9fb-4776-a2d7-d7b05627f978.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_e96c06fafc655ed1c5a79a0092569a05_bad627ce-b9fb-4776-a2d7-d7b05627f978.png" alt="Tactical Blaster Details" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_862c2dbbf724bdf5df0e5e1d41358221_bf119adc-cdd4-4354-9562-5d9331655a01.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_862c2dbbf724bdf5df0e5e1d41358221_bf119adc-cdd4-4354-9562-5d9331655a01.jpg" alt="Indoor Action Arena" width="80" height="80" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_2ea8000740ee44a3bd5efaf5393b4a39_9a3d2c37-afea-4c82-9305-1162ca8663bf.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_2ea8000740ee44a3bd5efaf5393b4a39_9a3d2c37-afea-4c82-9305-1162ca8663bf.jpg" alt="Three Step Setup" width="80" height="80" loading="lazy">
            </div>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT COLUMN: BUY BOX (SHOPSIDEK T01 EDITORIAL FLOW) -->
      <div class="zv-pdp-info-col">

        <!-- 1. Trustpilot Verified Review Rating Row (ABOVE product title) -->
        {% if section.settings.show_rating %}
          <a class="zv-pdp-rating-row zv-trustpilot-row" href="#tmFaqSection" aria-label="Trustpilot Rating">
            <span class="zv-tp-brand">
              <svg class="zv-tp-icon" viewBox="0 0 24 24" fill="#00B67A" width="16" height="16" aria-hidden="true">
                <path d="M12 2l2.9 8.2H23l-6.5 5 2.5 8-7-4.9-7 4.9 2.5-8L1 10.2h8.1z"/>
              </svg>
              <span class="zv-tp-name">Trustpilot</span>
            </span>
            <div class="zv-tp-star-boxes" aria-label="5 out of 5 stars">
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
              <span class="zv-tp-star-box"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.4 6.5H19l-5.3 4 2 6.5-5.7-4.2-5.7 4.2 2-6.5-5.3-4h6.6z"/></svg></span>
            </div>
            <span class="zv-tp-score"><strong>{{ section.settings.rating_score | default: "4.9" }}</strong> / 5.0</span>
            <span class="zv-tp-sep">&middot;</span>
            <span class="zv-tp-count">({{ section.settings.rating_count | default: "2,418" }} {{ section.settings.rating_label | default: "verified reviews" }})</span>
          </a>
        {% endif %}

        <!-- 2. Product Title (Fraunces Serif, Dominant & Elegant) -->
        <h1 class="zv-pdp-title">{{ prod_title }}</h1>

        <!-- 3. Short Description / Promise -->
        <p class="zv-pdp-lead">
          {{ prod_hero_desc }}
        </p>

        <!-- 4. Benefit Bullets with Relevant Icons -->
        <ul class="zv-pdp-benefits">
          <li>
            <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
            <span>Dynamic 180° Wall &amp; Ceiling Target Projection</span>
          </li>
          <li>
            <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>4 Selectable Team Battle Channels &amp; Unlimited Players</span>
          </li>
          <li>
            <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
            <span>Acoustic Blaster Sounds, Hit Vibration &amp; LED Health Bars</span>
          </li>
          <li>
            <svg class="zv-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span>Eye-Safe Class 1 Optical Infrared (Zero Physical Darts)</span>
          </li>
        </ul>

        <!-- 5. Live Viewing Urgency Pill (Merchant Configurable) -->
        {% if section.settings.show_live_viewers %}
          <div class="zv-live-viewers">
            <span class="zv-live-dot"></span>
            <span>{{ section.settings.live_viewers_text | default: "28 families looking at this right now" }}</span>
          </div>
        {% endif %}

        <!-- 6. Bold Price Hero Row -->
        <div class="zv-pdp-price-hero">
          <b class="zv-price-active" id="zvPriceActive">{{ t1_price | money }}</b>
          <s class="zv-price-compare" id="zvPriceCompare">{{ t1_compare | money }}</s>
          <span class="zv-price-save-pill" id="zvPriceSavings">SAVE {{ t1_savings | money }} (50% OFF)</span>
        </div>

        <!-- 7. TIERED BUNDLE SELECTOR (KACHING / SHOPSIDEK T01 STYLE) -->
        <div class="zv-bundle-box">
          <div class="zv-bundle-head">
            <span>CHOOSE YOUR PACKAGE:</span>
            <span class="zv-bundle-guarantee">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              <span>30-Day Returns</span>
            </span>
          </div>

          <div class="zv-bundle-cards">
            {% if is_ascending %}
              <!-- TIER 1: 1 SET (DEFAULT SELECTED) -->
              <div 
                class="zv-bundle-card selected" 
                data-qty="1"
                data-variant-id="{{ t1_id }}"
                data-price-cents="{{ t1_price }}"
                data-compare-cents="{{ t1_compare }}"
                data-tier-level="1"
              >
                <div class="zv-bundle-card-body">
                  <div class="zv-bundle-card-left">
                    <div class="zv-bundle-radio"></div>
                    <div class="zv-bundle-card-info">
                      <div class="zv-bundle-card-name">1 Set <small style="font-weight: 600; color: var(--zv-pdp-muted);">(Starter Pack)</small></div>
                      <div class="zv-bundle-card-sub">2 Blasters + 1 Target Projector &middot; 50% OFF</div>
                    </div>
                  </div>
                  <div class="zv-bundle-card-pricing">
                    <div class="zv-bundle-card-total">{{ t1_price | money }}</div>
                    <div class="zv-bundle-card-unit">{{ t1_price | money }} / set</div>
                  </div>
                </div>
              </div>

              <!-- TIER 2: 2 SETS (MOST POPULAR) -->
              <div 
                class="zv-bundle-card" 
                data-qty="1"
                data-variant-id="{{ t2_id }}"
                data-price-cents="{{ t2_price }}"
                data-compare-cents="{{ t2_compare }}"
                data-tier-level="2"
              >
                <span class="zv-bundle-card-badge">🔥 MOST POPULAR &middot; EXTRA 5% OFF &middot; SAVE {{ t2_savings | money }}</span>
                <div class="zv-bundle-card-body">
                  <div class="zv-bundle-card-left">
                    <div class="zv-bundle-radio"></div>
                    <div class="zv-bundle-card-info">
                      <div class="zv-bundle-card-name">2 Sets <small style="font-weight: 600; color: var(--zv-pdp-muted);">(Arena Pack)</small></div>
                      <div class="zv-bundle-card-sub">4 Blasters + 2 Projectors &middot; Extra 5% OFF &middot; Free US Shipping</div>
                    </div>
                  </div>
                  <div class="zv-bundle-card-pricing">
                    <div class="zv-bundle-card-total">{{ t2_price | money }}</div>
                    <div class="zv-bundle-card-unit">{{ t2_price | divided_by: 2 | money }} / set</div>
                  </div>
                </div>
              </div>

              <!-- TIER 3: 3 SETS (BEST VALUE) -->
              <div 
                class="zv-bundle-card" 
                data-qty="1"
                data-variant-id="{{ t3_id }}"
                data-price-cents="{{ t3_price }}"
                data-compare-cents="{{ t3_compare }}"
                data-tier-level="3"
              >
                <span class="zv-bundle-card-badge alt">👑 BEST VALUE &middot; EXTRA 15% OFF &middot; SAVE {{ t3_savings | money }}</span>
                <div class="zv-bundle-card-body">
                  <div class="zv-bundle-card-left">
                    <div class="zv-bundle-radio"></div>
                    <div class="zv-bundle-card-info">
                      <div class="zv-bundle-card-name">3 Sets <small style="font-weight: 600; color: var(--zv-pdp-muted);">(Tournament Pack)</small></div>
                      <div class="zv-bundle-card-sub">6 Blasters + 3 Projectors &middot; Extra 15% OFF &middot; Free US Shipping</div>
                    </div>
                  </div>
                  <div class="zv-bundle-card-pricing">
                    <div class="zv-bundle-card-total">{{ t3_price | money }}</div>
                    <div class="zv-bundle-card-unit">{{ t3_price | divided_by: 3 | money }} / set</div>
                  </div>
                </div>
                <div class="zv-bundle-bonus-gift">
                  <span>🎟️ VIP Bonus: $20 OFF coupon on next order over $100 + FREE US Shipping</span>
                </div>
              </div>

            {% else %}
              <!-- DESCENDING ORDER -->
              <div 
                class="zv-bundle-card" 
                data-qty="1"
                data-variant-id="{{ t3_id }}"
                data-price-cents="{{ t3_price }}"
                data-compare-cents="{{ t3_compare }}"
                data-tier-level="3"
              >
                <span class="zv-bundle-card-badge alt">👑 BEST VALUE &middot; EXTRA 15% OFF &middot; SAVE {{ t3_savings | money }}</span>
                <div class="zv-bundle-card-body">
                  <div class="zv-bundle-card-left">
                    <div class="zv-bundle-radio"></div>
                    <div class="zv-bundle-card-info">
                      <div class="zv-bundle-card-name">3 Sets</div>
                      <div class="zv-bundle-card-sub">6 Blasters + 3 Projectors &middot; Extra 15% OFF &middot; Free US Shipping</div>
                    </div>
                  </div>
                  <div class="zv-bundle-card-pricing">
                    <div class="zv-bundle-card-total">{{ t3_price | money }}</div>
                    <div class="zv-bundle-card-unit">{{ t3_price | divided_by: 3 | money }} / set</div>
                  </div>
                </div>
                <div class="zv-bundle-bonus-gift">
                  <span>🎟️ VIP Bonus: $20 OFF coupon on next order over $100 + FREE US Shipping</span>
                </div>
              </div>

              <div 
                class="zv-bundle-card" 
                data-qty="1"
                data-variant-id="{{ t2_id }}"
                data-price-cents="{{ t2_price }}"
                data-compare-cents="{{ t2_compare }}"
                data-tier-level="2"
              >
                <span class="zv-bundle-card-badge">🔥 MOST POPULAR &middot; EXTRA 5% OFF &middot; SAVE {{ t2_savings | money }}</span>
                <div class="zv-bundle-card-body">
                  <div class="zv-bundle-card-left">
                    <div class="zv-bundle-radio"></div>
                    <div class="zv-bundle-card-info">
                      <div class="zv-bundle-card-name">2 Sets</div>
                      <div class="zv-bundle-card-sub">4 Blasters + 2 Projectors &middot; Extra 5% OFF &middot; Free US Shipping</div>
                    </div>
                  </div>
                  <div class="zv-bundle-card-pricing">
                    <div class="zv-bundle-card-total">{{ t2_price | money }}</div>
                    <div class="zv-bundle-card-unit">{{ t2_price | divided_by: 2 | money }} / set</div>
                  </div>
                </div>
              </div>

              <div 
                class="zv-bundle-card selected" 
                data-qty="1"
                data-variant-id="{{ t1_id }}"
                data-price-cents="{{ t1_price }}"
                data-compare-cents="{{ t1_compare }}"
                data-tier-level="1"
              >
                <div class="zv-bundle-card-body">
                  <div class="zv-bundle-card-left">
                    <div class="zv-bundle-radio"></div>
                    <div class="zv-bundle-card-info">
                      <div class="zv-bundle-card-name">1 Set</div>
                      <div class="zv-bundle-card-sub">2 Blasters + 1 Target Projector &middot; 50% OFF</div>
                    </div>
                  </div>
                  <div class="zv-bundle-card-pricing">
                    <div class="zv-bundle-card-total">{{ t1_price | money }}</div>
                    <div class="zv-bundle-card-unit">{{ t1_price | money }} / set</div>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- 8. PRIMARY CTA (ADD TO CART · PRICE with Guarantee INSIDE) & BUY NOW -->
        <div class="zv-cta-group">
          <button type="button" class="zv-btn-atc" id="zvBtnClaim">
            <span class="zv-atc-main" id="zvBtnClaimLabel">ADD TO CART &middot; {{ t1_price | money }}</span>
            <span class="zv-atc-sub">30-DAY MONEY-BACK GUARANTEE</span>
          </button>

          <button type="button" class="zv-btn-buynow" id="zvBtnBuyNow">
            <span>BUY NOW</span>
          </button>
        </div>

        <!-- 9. DELIVERY STEPPER (Exactly 3 Steps without Subtitles) -->
        <div class="zv-pdp-delivery">
          <div class="zv-delivery-header">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>Order placed today, dispatched within 24–48 hours</span>
          </div>
          <ol class="zv-dl-steps">
            <li class="zv-dl-step completed">
              <span class="zv-dl-ic">✓</span>
              <span>Order Placed</span>
            </li>
            <li class="zv-dl-step completed">
              <span class="zv-dl-ic">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
              </span>
              <span>24–48h Dispatch</span>
            </li>
            <li class="zv-dl-step">
              <span class="zv-dl-ic">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              </span>
              <span>Delivered</span>
            </li>
          </ol>
        </div>

        <!-- 10. COMPACT CUSTOMER REVIEW MINI CARD (Task 11) -->
        {% if section.settings.show_mini_review %}
          <figure class="zv-pdp-mini-review">
            <div class="zv-mini-avatar">🎯</div>
            <div class="zv-mini-content">
              <div class="zv-stars">★★★★★</div>
              <blockquote>&ldquo;{{ section.settings.mini_review_quote | default: "The kids put down their tablets immediately. Projecting moving targets on the bedroom wall turned our house into an arcade. Best family gift all year!" }}&rdquo;</blockquote>
              <figcaption>
                {{ section.settings.mini_review_author | default: "Marcus & Elena T., Austin TX" }}
                {% if section.settings.mini_review_verified %}
                  &middot; <span class="zv-verified-buyer">✓ {{ section.settings.mini_review_badge | default: "Verified Buyer" }}</span>
                {% endif %}
              </figcaption>
            </div>
          </figure>
        {% endif %}

        <!-- 11. SHOPIFY NATIVE PAYMENT ICONS (Task 9: Clean, No Outer Header) -->
        <div class="zv-payment-methods" aria-label="Accepted Payment Methods">
          {% if shop.enabled_payment_types != empty %}
            {% for type in shop.enabled_payment_types %}
              <span class="zv-payment-icon-item">
                {{ type | payment_type_svg_tag: class: 'zv-payment-svg' }}
              </span>
            {% endfor %}
          {% else %}
            <span class="zv-payment-icon-item">{{ 'visa' | payment_type_svg_tag: class: 'zv-payment-svg' }}</span>
            <span class="zv-payment-icon-item">{{ 'master' | payment_type_svg_tag: class: 'zv-payment-svg' }}</span>
            <span class="zv-payment-icon-item">{{ 'american_express' | payment_type_svg_tag: class: 'zv-payment-svg' }}</span>
            <span class="zv-payment-icon-item">{{ 'discover' | payment_type_svg_tag: class: 'zv-payment-svg' }}</span>
            <span class="zv-payment-icon-item">{{ 'paypal' | payment_type_svg_tag: class: 'zv-payment-svg' }}</span>
          {% endif %}
        </div>

        <!-- 12. MINIMAL PRODUCT ACCORDIONS (Task 12: 4 Rows, Thin Dividers, Rotating Plus) -->
        <div class="zv-acc-group">
          
          <!-- Accordion 1: How to use -->
          <details class="zv-acc-item" open>
            <summary class="zv-acc-summary">
              <span>How to use</span>
              <span class="zv-acc-ic" aria-hidden="true">+</span>
            </summary>
            <div class="zv-acc-body">
              Insert batteries into each blaster and projector, then switch the power on. For solo training, point the projector lens at any wall or ceiling in a slightly dimmed room to blast moving projected targets. For multiplayer battles, select matching team colors on blasters to team up across 4 distinct combat channels.
            </div>
          </details>

          <!-- Accordion 2: What's inside -->
          <details class="zv-acc-item">
            <summary class="zv-acc-summary">
              <span>What's inside</span>
              <span class="zv-acc-ic" aria-hidden="true">+</span>
            </summary>
            <div class="zv-acc-body">
              Each 1 Set includes 2 Tactical Blasters, 1 Dynamic Target Projector, target slide discs, and an illustrated quickstart manual. 2 Sets include 4 Blasters and 2 Projectors. 3 Sets include 6 Blasters and 3 Projectors.
            </div>
          </details>

          <!-- Accordion 3: 30-day guarantee -->
          <details class="zv-acc-item">
            <summary class="zv-acc-summary">
              <span>30-day guarantee</span>
              <span class="zv-acc-ic" aria-hidden="true">+</span>
            </summary>
            <div class="zv-acc-body">
              We stand behind TRYMALORA quality with a 30-day money-back guarantee. If you or your family are not completely satisfied within 30 days of delivery, contact our US customer support team for an effortless return process.
            </div>
          </details>

          <!-- Accordion 4: Shipping -->
          <details class="zv-acc-item">
            <summary class="zv-acc-summary">
              <span>Shipping</span>
              <span class="zv-acc-ic" aria-hidden="true">+</span>
            </summary>
            <div class="zv-acc-body">
              Orders are packaged and dispatched from regional US warehouses within 24–48 business hours. Tracked standard delivery arrives in 3–5 business days. Free shipping is automatically included on all 2-pack and 3-pack bundle orders.
            </div>
          </details>

        </div>

      </div>

    </div>
  </div>
</section>

<!-- STICKY ATC BAR ON SCROLL -->
<div class="zv-sticky-bar" id="zvStickyBar" role="region" aria-label="Quick Add to Cart">
  <div class="zv-sticky-prod-info">
    <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" alt="{{ prod_title | escape }}" class="zv-sticky-thumb" width="44" height="44">
    <div>
      <div class="zv-sticky-name">{{ prod_title }}</div>
      <div class="zv-sticky-price" id="zvStickyPrice">{{ t1_price | money }}</div>
    </div>
  </div>
  <button type="button" class="zv-btn-atc" id="zvStickyBtn" style="min-height: 48px; padding: 8px 24px;">
    <span class="zv-atc-main" id="zvStickyBtnLabel">ADD TO CART &middot; {{ t1_price | money }}</span>
  </button>
</div>

<script src="{{ 'zavelyn-v4-pdp.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Trymalora PDP Buy Box",
  "settings": [
    {
      "type": "header",
      "content": "Social Proof & Customer Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Customer Rating Row",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Rating Count",
      "default": "2,418"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating Label",
      "default": "verified reviews"
    },
    {
      "type": "header",
      "content": "Live Viewing Message"
    },
    {
      "type": "checkbox",
      "id": "show_live_viewers",
      "label": "Show Live Viewers Urgency Pill",
      "default": true
    },
    {
      "type": "text",
      "id": "live_viewers_text",
      "label": "Live Viewers Text",
      "default": "28 families looking at this right now"
    },
    {
      "type": "header",
      "content": "Mini Review Card"
    },
    {
      "type": "checkbox",
      "id": "show_mini_review",
      "label": "Show Mini Review Card",
      "default": true
    },
    {
      "type": "textarea",
      "id": "mini_review_quote",
      "label": "Review Quote",
      "default": "The kids put down their tablets immediately. Projecting moving targets on the bedroom wall turned our house into an arcade. Best family gift all year!"
    },
    {
      "type": "text",
      "id": "mini_review_author",
      "label": "Review Author",
      "default": "Marcus & Elena T., Austin TX"
    },
    {
      "type": "checkbox",
      "id": "mini_review_verified",
      "label": "Show Verified Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "mini_review_badge",
      "label": "Badge Text",
      "default": "Verified Buyer"
    },
    {
      "type": "header",
      "content": "Bundle Merchandising"
    },
    {
      "type": "number",
      "id": "merchandising_threshold",
      "label": "Base Price Threshold for Ascending Order ($)",
      "default": 50
    },
    {
      "type": "select",
      "id": "bundle_order_override",
      "label": "Bundle Order Override",
      "options": [
        { "value": "auto", "label": "Auto (Based on Price Threshold)" },
        { "value": "ascending", "label": "Ascending (1 Set, 2 Sets, 3 Sets)" },
        { "value": "descending", "label": "Descending (3 Sets, 2 Sets, 1 Set)" }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Trymalora PDP Buy Box"
    }
  ]
}
{% endschema %}
