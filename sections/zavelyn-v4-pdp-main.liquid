{% comment %}
  TRYMALORA IMMERSIVE COMMERCE THEME V4.0
  CRO BUY BOX HERO & BUNDLE ENGINE (INSPIRED BY SHOPSIDEK T01)
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}
{{ 'zavelyn-v4-pdp.css' | asset_url | stylesheet_tag }}

{% assign is_bundle_variant_product = false %}
{% assign variant_tier_1 = nil %}
{% assign variant_tier_2 = nil %}
{% assign variant_tier_3 = nil %}

{% if product.variants.size > 0 %}
  {% for v in product.variants %}
    {% assign t_title = v.title | downcase %}
    {% if t_title contains '1 set' or t_title contains 'starter' or t_title contains 'single' %}
      {% assign variant_tier_1 = v %}
      {% assign is_bundle_variant_product = true %}
    {% elsif t_title contains '2 set' or t_title contains 'duo' or t_title contains 'double' %}
      {% assign variant_tier_2 = v %}
      {% assign is_bundle_variant_product = true %}
    {% elsif t_title contains '3 set' or t_title contains 'family' or t_title contains 'triple' or t_title contains 'arena' %}
      {% assign variant_tier_3 = v %}
      {% assign is_bundle_variant_product = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign prod_title = product.title | default: "Kids Infrared Battle Blaster Set with Target Projector" %}
{% assign prod_desc = product.description | default: "Transform any living space into an energetic, screen-free action arena. The Kids Infrared Battle Blaster Set combines interactive wall-target projection with tactical multiplayer team battle modes, featuring responsive sound effects, hit-sensing LED health meters, and safe optical infrared play." %}

{% assign t1_id = variant_tier_1.id | default: "67297621934451" %}
{% assign t1_price = variant_tier_1.price | default: 9999 %}
{% assign t2_id = variant_tier_2.id | default: "67297622131059" %}
{% assign t2_price = variant_tier_2.price | default: 16999 %}
{% assign t3_id = variant_tier_3.id | default: "67297622163827" %}
{% assign t3_price = variant_tier_3.price | default: 22999 %}

{% assign t2_savings = t1_price | times: 2 | minus: t2_price %}
{% assign t3_savings = t1_price | times: 3 | minus: t3_price %}

{% assign current_variant = variant_tier_3 | default: product.selected_or_first_available_variant %}

<section 
  class="zv-pdp-hero" 
  id="zvBuyBox"
  data-initial-variant-id="{{ t3_id }}"
  data-initial-price="{{ t3_price }}"
  data-initial-compare="{{ t1_price | times: 3 }}"
>
  <div class="zv-container">
    <div class="zv-pdp-grid">

      <!-- LEFT COLUMN: STICKY PRODUCT GALLERY -->
      <div class="zv-pdp-gallery-col">
        <div class="zv-pdp-main-media">
          <span class="zv-pdp-save-badge" id="zvPriceSavings">SAVE {{ t3_savings | money }}</span>

          {% if product.featured_image %}
            <img 
              id="zvMainImg" 
              src="{{ product.featured_image | image_url: width: 900 }}" 
              alt="{{ prod_title | escape }}" 
              class="zv-pdp-main-img"
              width="600"
              height="600"
              loading="eager"
            >
          {% else %}
            <img 
              id="zvMainImg" 
              src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" 
              alt="{{ prod_title | escape }}" 
              class="zv-pdp-main-img"
              width="600"
              height="600"
              loading="eager"
            >
          {% endif %}
        </div>

        <!-- Thumbnails -->
        <div class="zv-pdp-thumbs">
          {% if product.images.size > 1 %}
            {% for img in product.images limit: 8 %}
              <div class="zv-pdp-thumb {% if forloop.first %}active{% endif %}" data-src="{{ img | image_url: width: 900 }}">
                <img src="{{ img | image_url: width: 140 }}" alt="{{ img.alt | escape }}" loading="lazy">
              </div>
            {% endfor %}
          {% else %}
            <div class="zv-pdp-thumb active" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" alt="Target Projector and Blasters" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_95469ec9ffbf4d73ac184b9e30d7d3ee_356f56e5-46d7-4421-8be1-d7f82d6241f0.png" alt="Dynamic Target Training" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_94e0edf9f1023e1489161d1b3218329e_57ef72a8-8ded-4354-b4fd-8dfd4995b2d2.png" alt="Multiplayer Battle Mode" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_e96c06fafc655ed1c5a79a0092569a05_bad627ce-b9fb-4776-a2d7-d7b05627f978.png">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_e96c06fafc655ed1c5a79a0092569a05_bad627ce-b9fb-4776-a2d7-d7b05627f978.png" alt="Tactical Blaster Details" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_862c2dbbf724bdf5df0e5e1d41358221_bf119adc-cdd4-4354-9562-5d9331655a01.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_862c2dbbf724bdf5df0e5e1d41358221_bf119adc-cdd4-4354-9562-5d9331655a01.jpg" alt="Indoor Action Arena" loading="lazy">
            </div>
            <div class="zv-pdp-thumb" data-src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_2ea8000740ee44a3bd5efaf5393b4a39_9a3d2c37-afea-4c82-9305-1162ca8663bf.jpg">
              <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173021_2ea8000740ee44a3bd5efaf5393b4a39_9a3d2c37-afea-4c82-9305-1162ca8663bf.jpg" alt="Three Step Setup" loading="lazy">
            </div>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT COLUMN: CRO BUY BOX INFO & BUNDLE ENGINE -->
      <div class="zv-pdp-info-col">
        <div class="zv-pdp-eyebrow">
          <span>🏛️ TRYMALORA INNOVATIONS &middot; US DIRECT DISPATCH</span>
        </div>

        <h1 class="zv-pdp-title">{{ prod_title }}</h1>

        <!-- Star Rating -->
        <div class="zv-pdp-rating-row">
          <span class="zv-stars">★★★★★</span>
          <span>4.9 / 5.0</span>
          <span>&middot;</span>
          <span>Verified Direct Purchase</span>
        </div>

        <!-- Price Hero -->
        <div class="zv-pdp-price-hero">
          <span class="zv-price-active" id="zvPriceActive">{{ t3_price | money }}</span>
          <span class="zv-price-compare" id="zvPriceCompare">{{ t1_price | times: 3 | money }}</span>
        </div>

        <!-- Lead Description -->
        <div class="zv-pdp-lead">
          {{ prod_desc | strip_html | truncatewords: 35 }}
        </div>

        <!-- Key Verified Benefits -->
        <ul class="zv-pdp-benefits">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Safe Invisible Optical Infrared Sensor (Zero Laser Hazard)</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Solo Wall-Target Projection &amp; 4-Team Battle Modes</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Fast 24–48h Dispatch from Regional US Warehouses</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Risk-Free 30-Day Money-Back Guarantee</span>
          </li>
        </ul>

        <!-- TIERED BUNDLE SELECTOR (KACHING / SHOPSIDEK T01 PATTERN) -->
        <div class="zv-bundle-box">
          <div class="zv-bundle-head">
            <span class="zv-bundle-title">CHOOSE YOUR PACKAGE:</span>
            <span class="zv-bundle-guarantee">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              <span>30-Day Returns</span>
            </span>
          </div>

          <div class="zv-bundle-cards">
            <!-- TIER 3: 3 SETS (BEST VALUE - DEFAULT SELECTED) -->
            <div 
              class="zv-bundle-card selected" 
              data-qty="1"
              data-variant-id="{{ t3_id }}"
              data-price-cents="{{ t3_price }}"
              data-compare-cents="{{ t1_price | times: 3 }}"
              data-tier-level="3"
            >
              <span class="zv-bundle-card-badge lime">👑 BEST VALUE &middot; FREE SHIPPING &middot; SAVE {{ t3_savings | money }}</span>
              <div class="zv-bundle-card-body">
                <div class="zv-bundle-card-left">
                  <div class="zv-bundle-radio"></div>
                  <div class="zv-bundle-card-info">
                    <span class="zv-bundle-card-name">3 Sets (Family Arena Pack)</span>
                    <span class="zv-bundle-card-sub">6 Blasters + 3 Projectors &middot; Full Arena</span>
                  </div>
                </div>
                <div class="zv-bundle-card-pricing">
                  <span class="zv-bundle-card-total">{{ t3_price | money }}</span>
                  <span class="zv-bundle-card-unit">{{ t3_price | divided_by: 3 | money }} / set</span>
                </div>
              </div>
            </div>

            <!-- TIER 2: 2 SETS (MOST POPULAR) -->
            <div 
              class="zv-bundle-card" 
              data-qty="1"
              data-variant-id="{{ t2_id }}"
              data-price-cents="{{ t2_price }}"
              data-compare-cents="{{ t1_price | times: 2 }}"
              data-tier-level="2"
            >
              <span class="zv-bundle-card-badge">🔥 MOST POPULAR &middot; SAVE {{ t2_savings | money }}</span>
              <div class="zv-bundle-card-body">
                <div class="zv-bundle-card-left">
                  <div class="zv-bundle-radio"></div>
                  <div class="zv-bundle-card-info">
                    <span class="zv-bundle-card-name">2 Sets (Duo Team Pack)</span>
                    <span class="zv-bundle-card-sub">4 Blasters + 2 Projectors &middot; Free Shipping</span>
                  </div>
                </div>
                <div class="zv-bundle-card-pricing">
                  <span class="zv-bundle-card-total">{{ t2_price | money }}</span>
                  <span class="zv-bundle-card-unit">{{ t2_price | divided_by: 2 | money }} / set</span>
                </div>
              </div>
            </div>

            <!-- TIER 1: 1 SET (STARTER) -->
            <div 
              class="zv-bundle-card" 
              data-qty="1"
              data-variant-id="{{ t1_id }}"
              data-price-cents="{{ t1_price }}"
              data-compare-cents="{{ t1_price }}"
              data-tier-level="1"
            >
              <div class="zv-bundle-card-body">
                <div class="zv-bundle-card-left">
                  <div class="zv-bundle-radio"></div>
                  <div class="zv-bundle-card-info">
                    <span class="zv-bundle-card-name">1 Set (Starter Battle Pack)</span>
                    <span class="zv-bundle-card-sub">2 Blasters + 1 Target Projector</span>
                  </div>
                </div>
                <div class="zv-bundle-card-pricing">
                  <span class="zv-bundle-card-total">{{ t1_price | money }}</span>
                  <span class="zv-bundle-card-unit" style="background: var(--zv-surface-muted); color: var(--zv-muted);">{{ t1_price | money }} / set</span>
                </div>
              </div>
            </div>
          </div>

          <!-- SHIPPING & PERKS PROGRESSION BAR (FACTUAL & VERIFIED) -->
          <div class="zv-gift-unlock unlocked" id="zvGiftUnlock">
            <div class="zv-gift-icon-box" id="zvGiftIcon">⚡</div>
            <div class="zv-gift-text">
              <span class="zv-gift-title" id="zvGiftTitle">⚡ FREE Tracked Shipping &amp; VIP Priority Dispatch</span>
              <span class="zv-gift-sub" id="zvGiftSub">Maximum bundle savings unlocked &middot; Insured US carrier transit</span>
            </div>
            <span class="zv-gift-status-badge" id="zvGiftStatusBadge">UNLOCKED</span>
          </div>
        </div>

        <!-- PRIMARY CTAS -->
        <div class="zv-cta-group">
          <button type="button" class="zv-btn-claim" id="zvBtnClaim">
            <span>CLAIM OFFER ➔</span>
          </button>

          <button type="button" class="zv-btn-buynow" id="zvBtnBuyNow">
            <span>⚡ BUY NOW (1-CLICK CHECKOUT)</span>
          </button>
        </div>

        <!-- DELIVERY PROGRESS STEPPER -->
        <div class="zv-delivery-stepper">
          <div class="zv-stepper-row">
            <div class="zv-step active">
              <div class="zv-step-dot">1</div>
              <span class="zv-step-label">Order Placed</span>
              <span class="zv-step-sub">Instant Confirmation</span>
            </div>
            <div class="zv-step active">
              <div class="zv-step-dot">2</div>
              <span class="zv-step-label">24-48h Dispatch</span>
              <span class="zv-step-sub">US Regional Hub</span>
            </div>
            <div class="zv-step">
              <div class="zv-step-dot">3</div>
              <span class="zv-step-label">Delivered</span>
              <span class="zv-step-sub">Tracked Doorstep</span>
            </div>
          </div>
        </div>

        <!-- TRUST STRIP -->
        <div class="zv-trust-badges-row">
          <div class="zv-trust-badge-item">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
            <span class="zv-trust-badge-title">30-Day Returns</span>
            <span class="zv-trust-badge-desc">Zero risk guarantee</span>
          </div>
          <div class="zv-trust-badge-item">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            <span class="zv-trust-badge-title">Fast US Shipping</span>
            <span class="zv-trust-badge-desc">Insured carrier transit</span>
          </div>
          <div class="zv-trust-badge-item">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <span class="zv-trust-badge-title">256-Bit SSL</span>
            <span class="zv-trust-badge-desc">Encrypted checkout</span>
          </div>
        </div>

        <!-- COLLAPSIBLE ACCORDION GROUP (T01 PATTERN) -->
        <div class="zv-pdp-accordions" style="margin-top: 24px; border-top: 1px solid var(--zv-border);">
          <details style="border-bottom: 1px solid var(--zv-border); padding: 14px 0; cursor: pointer;" open>
            <summary style="font-weight: 800; font-size: 15px; color: var(--zv-heading); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              <span>Product Overview &amp; Key Highlights</span>
              <span style="font-size: 18px;">▾</span>
            </summary>
            <div style="font-size: 14px; line-height: 1.6; color: var(--zv-body); margin-top: 10px;">
              {{ prod_desc }}
            </div>
          </details>

          <details style="border-bottom: 1px solid var(--zv-border); padding: 14px 0; cursor: pointer;">
            <summary style="font-weight: 800; font-size: 15px; color: var(--zv-heading); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              <span>Fast 24-48h US Shipping &amp; Insured Transit</span>
              <span style="font-size: 18px;">▾</span>
            </summary>
            <div style="font-size: 14px; line-height: 1.6; color: var(--zv-body); margin-top: 10px;">
              Every order is packaged in protective heavy-duty boxing and dispatched directly from regional US fulfillment centers within 24–48 business hours. Carrier tracking is provided via email immediately upon shipment.
            </div>
          </details>

          <details style="border-bottom: 1px solid var(--zv-border); padding: 14px 0; cursor: pointer;">
            <summary style="font-weight: 800; font-size: 15px; color: var(--zv-heading); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              <span>Risk-Free 30-Day Money-Back Guarantee</span>
              <span style="font-size: 18px;">▾</span>
            </summary>
            <div style="font-size: 14px; line-height: 1.6; color: var(--zv-body); margin-top: 10px;">
              Try TRYMALORA in your own home for a full 30 days. If you are not completely satisfied with its performance and quality, our US-based support team will assist with a prompt and courteous return.
            </div>
          </details>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- STICKY ATC BAR ON SCROLL -->
<div class="zv-sticky-bar" id="zvStickyBar" role="region" aria-label="Quick Add to Cart">
  <div class="zv-sticky-prod-info">
    <img src="https://ashbtop.com/cdn/shop/files/spp_shopify20261028173020_6c8c1c4cf7d711cdd5a4d6aa91290eb2_e583f568-e0e8-4c22-9785-6dc4d0eb727b.jpg" alt="{{ prod_title | escape }}" class="zv-sticky-thumb">
    <div>
      <div class="zv-sticky-name">{{ prod_title }}</div>
      <div class="zv-sticky-price" id="zvStickyPrice">{{ t3_price | money }}</div>
    </div>
  </div>
  <button type="button" class="zv-btn zv-btn-accent" id="zvStickyBtn" style="padding: 12px 28px;">
    <span>CLAIM OFFER ➔</span>
  </button>
</div>

<script src="{{ 'zavelyn-v4-pdp.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Trymalora PDP Buy Box",
  "settings": [],
  "presets": [
    {
      "name": "Trymalora PDP Buy Box"
    }
  ]
}
{% endschema %}
