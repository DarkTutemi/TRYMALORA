{% comment %} MALORA ORGANICS — 100% DYNAMIC COLLECTION GRID (8SHEEP 1:1 CLONE) {% endcomment %}
<style>
  .malora-col-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    padding: 36px 24px 64px;
    color: #323A31;
  }
  .malora-col-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .malora-col-title {
    font-family: 'Canela', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 500;
    margin: 0 0 12px;
    color: #323A31;
  }
  .malora-col-desc {
    font-size: 16px;
    line-height: 1.6;
    color: #555;
  }
  .malora-col-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 36px;
  }
  .malora-col-pill {
    padding: 8px 18px;
    border-radius: 99px;
    border: 1px solid #D5D5D0;
    font-size: 13px;
    font-weight: 500;
    color: #323A31;
    text-decoration: none;
    transition: all 0.2s;
  }
  .malora-col-pill:hover,
  .malora-col-pill.is-active {
    background: #323A31;
    color: #fff;
    border-color: #323A31;
  }
  .malora-col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  @media (max-width: 900px) {
    .malora-col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 540px) {
    .malora-col-grid {
      grid-template-columns: 1fr;
    }
  }
  .malora-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #ECEAE4;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .malora-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(50, 58, 49, 0.08);
  }
  .malora-card-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #F7F6F3;
    overflow: hidden;
  }
  .malora-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .malora-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #B36A42;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .malora-card-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .malora-card-title {
    font-family: 'Canela', Georgia, serif;
    font-size: 20px;
    font-weight: 500;
    color: #323A31;
    text-decoration: none;
    margin: 0 0 6px;
    display: block;
  }
  .malora-card-price {
    font-size: 16px;
    font-weight: 600;
    color: #323A31;
    margin-bottom: 14px;
  }
  .malora-card-compare {
    font-size: 14px;
    color: #888;
    text-decoration: line-through;
    margin-left: 6px;
    font-weight: 400;
  }
  .malora-card-btn {
    margin-top: auto;
    display: block;
    width: 100%;
    padding: 12px;
    background: #B36A42;
    color: #fff;
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    border-radius: 6px;
    transition: background 0.2s;
  }
  .malora-card-btn:hover {
    background: #965633;
  }
</style>

<div class="malora-col-wrapper">
  <div class="malora-col-header">
    <h1 class="malora-col-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="malora-col-desc rte">{{ collection.description }}</div>
    {% else %}
      <div class="malora-col-desc">100% natural, organic care for pregnancy, sleep, postpartum &amp; baby. Handcrafted in small batches.</div>
    {% endif %}
  </div>

  <div class="malora-col-pills">
    <a href="/collections/our-best-sellers" class="malora-col-pill {% if collection.handle == 'our-best-sellers' %}is-active{% endif %}">Best Sellers</a>
    <a href="/collections/bundle" class="malora-col-pill {% if collection.handle == 'bundle' %}is-active{% endif %}">Bundles &amp; Kits</a>
    <a href="/collections/organic-pregnancy-products" class="malora-col-pill {% if collection.handle == 'organic-pregnancy-products' %}is-active{% endif %}">Pregnancy</a>
    <a href="/collections/sleep-products" class="malora-col-pill {% if collection.handle == 'sleep-products' %}is-active{% endif %}">Sleep</a>
    <a href="/collections/stretch-marks" class="malora-col-pill {% if collection.handle == 'stretch-marks' %}is-active{% endif %}">Stretch Marks</a>
    <a href="/collections/baby" class="malora-col-pill {% if collection.handle == 'baby' %}is-active{% endif %}">Baby &amp; Kids</a>
  </div>

  <div class="malora-col-grid">
    {% for product in collection.products %}
      <div class="malora-card">
        <a href="{{ product.url }}" class="malora-card-img-wrap">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
          {% endif %}
          {% if product.compare_at_price > product.price or product.title contains 'Bundle' or product.title contains 'Kit' %}
            <span class="malora-card-badge">{% if product.title contains 'Bundle' or product.title contains 'Kit' %}Bundle &amp; Save{% else %}Save{% endif %}</span>
          {% endif %}
        </a>
        <div class="malora-card-body">
          <a href="{{ product.url }}" class="malora-card-title">{{ product.title }}</a>
          <div class="malora-card-price">
            {{ product.price | money }}
            {% if product.compare_at_price > product.price %}
              <span class="malora-card-compare">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
          <a href="{{ product.url }}" class="malora-card-btn">Shop Now</a>
        </div>
      </div>
    {% else %}
      <p style="grid-column: 1 / -1; text-align: center; padding: 40px;">No products found in this collection.</p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Malora Collection Main",
  "settings": []
}
{% endschema %}
