<!-- Willa Style Slide-Out Cart Drawer -->
{%- liquid
  assign is_legacy_product = false
  if template.name == 'product' and template.suffix != 'ultra-overnight' and product.handle != 'full-spine-ultra-overnight' and product.handle != 'ultra-overnight'
    assign is_legacy_product = true
  endif
-%}
<script>
  window.__isUltraContext = {% if is_legacy_product %}false{% else %}true{% endif %};
</script>
<div class="willa-cart-drawer-overlay" id="willaCartOverlay" onclick="closeWillaCart()"></div>

<div class="willa-cart-drawer" id="willaCartDrawer">
  <div class="willa-cart-drawer-header">
    <div class="willa-cart-title">
      <span>🛒</span> Your Cart (<span id="willaDrawerCount">{{ cart.item_count }}</span>)
    </div>
    <button type="button" class="willa-cart-close" onclick="closeWillaCart()" aria-label="Close cart">&times;</button>
  </div>

  <!-- Free Shipping Progress Bar -->
  <div class="willa-shipping-bar-wrap">
    <div class="shipping-bar-text" id="willaShippingText">
      {% if is_legacy_product %}
        {% assign threshold = 7000 %}
      {% else %}
        {% assign threshold = 4900 %}
      {% endif %}
      {% if cart.total_price >= threshold %}
        🎉 You unlocked <strong>FREE US SHIPPING</strong>!
      {% else %}
        Add <strong>{{ threshold | minus: cart.total_price | money }}</strong> more to unlock <strong>FREE SHIPPING</strong>!
      {% endif %}
    </div>
    <div class="shipping-progress-bg">
      {% assign percent = cart.total_price | times: 100 | divided_by: threshold %}
      {% if percent > 100 %}{% assign percent = 100 %}{% endif %}
      <div class="shipping-progress-fill" id="willaShippingFill" style="width: {{ percent }}%;"></div>
    </div>
  </div>

  <!-- Cart Items List -->
  <div class="willa-cart-drawer-body" id="willaCartItemsBody">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="willa-cart-item" data-line-key="{{ item.key }}">
          <div class="cart-item-img">
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}">
          </div>
          <div class="cart-item-details">
            <div class="cart-item-title-row">
              <h4>{{ item.product.title }}</h4>
              <button type="button" class="cart-remove-btn" onclick="willaUpdateLineItem('{{ item.key }}', 0)">&times;</button>
            </div>
            {% unless item.product.has_only_default_variant %}
              <div class="cart-item-variant">{{ item.variant.title }}</div>
            {% endunless %}
            {% if item.selling_plan_allocation %}
              <div style="display:inline-block;background:#eff6ff;color:#1d4ed8;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:3px;">
                🔄 Auto-Ship: {{ item.selling_plan_allocation.selling_plan.name }}
              </div>
            {% endif %}
            {% if item.properties.Package %}
              <div style="display:inline-block;background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:3px;">
                {% if item.properties._free_qty %}🎁 {{ item.properties.Package }}{% else %}📦 {{ item.properties.Package }}{% endif %}
              </div>
            {% elsif item.properties._upsell %}
              <div style="display:inline-block;background:#fdf2f8;color:#be185d;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:3px;">
                ✨ Companion: {{ item.properties._upsell }}
              </div>
            {% elsif item.properties._box %}
              <div class="cart-item-prop" style="font-size: 11px; color: #7A6670; margin-top: 2px;">{{ item.properties._box }}</div>
            {% endif %}
            <div class="cart-item-bottom-row">
              <div class="cart-qty-ctrl">
                <button type="button" onclick="willaUpdateLineItem('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
                <span>{{ item.quantity }}</span>
                <button type="button" onclick="willaUpdateLineItem('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
              </div>
              {% assign free_q = item.properties._free_qty | plus: 0 %}
              {% if free_q > 0 and item.product.handle == 'metallic-silver-anti-rust-renovation-coating' %}
                {% assign free_cents = item.price | times: free_q %}
                {% assign payable_line = item.final_line_price | minus: free_cents %}
                <div class="cart-item-price">
                  <span style="color:#047857;font-weight:700;">{{ payable_line | money }}</span>
                  <span style="font-size:12px;color:#858380;text-decoration:line-through;margin-left:4px;">{{ item.final_line_price | money }}</span>
                </div>
              {% else %}
                <div class="cart-item-price">{{ item.final_line_price | money }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="willa-empty-cart">
        <div class="empty-icon">🛒</div>
        <h3>Your cart is empty</h3>
        {% if is_legacy_product %}
          <p>Explore our best-selling smart innovations, wellness gear, and daily essentials.</p>
          <a href="/" class="willa-btn-primary" onclick="closeWillaCart()">
            CONTINUE SHOPPING ➔
          </a>
        {% else %}
          <p>Explore FULL-SPINE ULTRA OVERNIGHT™ for leak-free, restful sleep.</p>
          <a href="/products/full-spine-ultra-overnight" class="willa-btn-primary" style="background-color:var(--uo-plum,#58233D);color:#ffffff !important;" onclick="closeWillaCart()">
            SHOP ULTRA OVERNIGHT ➔
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <!-- Cart Footer / Checkout -->
  <div class="willa-cart-drawer-footer" id="willaCartFooter" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    <div class="willa-cart-subtotal-row">
      <span>Subtotal</span>
      <span class="subtotal-val" id="willaDrawerSubtotal">{{ cart.total_price | money }}</span>
    </div>
    <p class="shipping-subtext">Taxes and shipping calculated at checkout.</p>
    <a href="/checkout" class="willa-checkout-btn">
      🔒 PROCEED TO CHECKOUT ➔
    </a>
    <div class="cart-guarantee-badges">
      <span>🛡️ 30-Day Money-Back Guarantee</span>
      <span>🔒 100% Encrypted</span>
    </div>
  </div>
</div>

<style>
  .willa-cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(35, 31, 32, 0.5);
    backdrop-filter: blur(2px);
    z-index: 999998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .willa-cart-drawer-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .willa-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 90%;
    max-width: 420px;
    height: 100%;
    background-color: #faf7f4;
    z-index: 999999;
    box-shadow: -4px 0 24px rgba(0,0,0,0.15);
    transform: translateX(100%);
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 480px) {
    .willa-cart-drawer {
      width: 100% !important;
      max-width: 100% !important;
    }
    .willa-cart-drawer-body {
      padding: 14px 16px !important;
    }
  }
  .willa-cart-drawer.active {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
  }

  .willa-cart-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    border-bottom: 1px solid #e7e4df;
    background-color: #ffffff;
  }
  .willa-cart-title {
    font-size: 17px;
    font-weight: 800;
    color: #231f20;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .willa-cart-close {
    background: none;
    border: none;
    font-size: 28px;
    color: #231f20;
    cursor: pointer;
    line-height: 1;
  }

  /* Free Shipping Bar */
  .willa-shipping-bar-wrap {
    background-color: #fbeee9;
    padding: 12px 20px;
    border-bottom: 1px solid #e7e4df;
    font-size: 12px;
    color: #231f20;
    text-align: center;
  }
  .shipping-bar-text strong {
    color: #8a2c13;
  }
  .shipping-progress-bg {
    width: 100%;
    height: 6px;
    background: #e7e4df;
    border-radius: 9999px;
    margin-top: 8px;
    overflow: hidden;
  }
  .shipping-progress-fill {
    height: 100%;
    background: #8a2c13;
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  /* Items */
  .willa-cart-drawer-body {
    padding: 16px 20px;
    flex: 1;
    overflow-y: auto;
  }
  .willa-cart-item {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #e7e4df;
  }
  .cart-item-img {
    width: 70px;
    height: 70px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e7e4df;
    background: #ffffff;
    flex-shrink: 0;
  }
  .cart-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-item-details {
    flex: 1;
  }
  .cart-item-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  .cart-item-title-row h4 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #231f20;
    line-height: 1.3;
  }
  .cart-remove-btn {
    background: none;
    border: none;
    color: #8e847f;
    font-size: 18px;
    cursor: pointer;
    line-height: 1;
    padding: 0 4px;
  }
  .cart-remove-btn:hover {
    color: #8a2c13;
  }
  .cart-item-variant {
    font-size: 11px;
    color: #645a55;
    margin-bottom: 8px;
  }
  .cart-item-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cart-qty-ctrl {
    display: flex;
    align-items: center;
    border: 1px solid #e7e4df;
    border-radius: 6px;
    background: #ffffff;
    overflow: hidden;
  }
  .cart-qty-ctrl button {
    background: #faf7f4;
    border: none;
    width: 26px;
    height: 26px;
    font-weight: 700;
    cursor: pointer;
    color: #231f20;
  }
  .cart-qty-ctrl span {
    width: 28px;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
  }
  .cart-item-price {
    font-size: 14px;
    font-weight: 800;
    color: #8a2c13;
  }

  /* Empty Cart */
  .willa-empty-cart {
    text-align: center;
    padding: 60px 20px;
  }
  .empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
  }
  .willa-empty-cart h3 {
    margin: 0 0 8px 0;
    font-size: 18px;
    color: #231f20;
  }
  .willa-empty-cart p {
    font-size: 13px;
    color: #59514f;
    margin: 0 0 20px 0;
  }

  /* Footer */
  .willa-cart-drawer-footer {
    padding: 20px;
    background-color: #ffffff;
    border-top: 1px solid #e7e4df;
  }
  .willa-cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 16px;
    font-weight: 800;
    color: #231f20;
    margin-bottom: 4px;
  }
  .subtotal-val {
    font-size: 20px;
    color: #8a2c13;
  }
  .shipping-subtext {
    font-size: 11px;
    color: #8e847f;
    margin: 0 0 14px 0;
  }
  .willa-checkout-btn {
    display: block;
    width: 100%;
    background-color: #8a2c13;
    color: #ffffff;
    text-align: center;
    padding: 15px 20px;
    border-radius: 9999px;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 14px rgba(138, 44, 19, 0.3);
    box-sizing: border-box;
    transition: all 0.2s;
  }
  .willa-checkout-btn:hover {
    background-color: #71230e;
    transform: translateY(-2px);
  }
  .cart-guarantee-badges {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #645a55;
    margin-top: 12px;
  }
</style>

<script>
  window.willaOpenCartDrawer = function() {
    const drawer = document.getElementById('willaCartDrawer');
    const overlay = document.getElementById('willaCartOverlay');
    if (drawer) drawer.classList.add('active');
    if (overlay) overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  };
  window.openWillaCart = window.willaOpenCartDrawer;

  window.closeWillaCart = function() {
    const drawer = document.getElementById('willaCartDrawer');
    const overlay = document.getElementById('willaCartOverlay');
    if (drawer) drawer.classList.remove('active');
    if (overlay) overlay.classList.remove('active');
    document.body.style.overflow = '';
  };

  window.willaQuickAddToCart = async function(variantId, btn) {
    let originalText = 'Add to cart';
    if (btn) {
      originalText = btn.innerText;
      btn.disabled = true;
      btn.innerText = 'ADDING...';
    }

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ id: variantId, quantity: 1 }]
        })
      });

      if (res.ok) {
        await window.willaRefreshCart();
        window.willaOpenCartDrawer();
        if (btn) {
          btn.disabled = false;
          btn.innerText = originalText;
        }
      } else {
        window.location.href = '/cart/' + variantId + ':1';
      }
    } catch (e) {
      window.location.href = '/cart/' + variantId + ':1';
    }
  };

  window.willaRefreshCart = async function() {
    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();
      
      // Update count
      const headerCount = document.getElementById('willaCartCount');
      if (headerCount) headerCount.innerText = cart.item_count;
      const drawerCount = document.getElementById('willaDrawerCount');
      if (drawerCount) drawerCount.innerText = cart.item_count;

      // Calculate payable subtotal accounting for discounts
      let bundleDeductionCents = 0;
      let appliedDiscount = window._activeBundleDiscount || '';

      if (cart.items) {
        cart.items.forEach(item => {
          if (item.properties && item.properties._bundle) {
            const b = item.properties._bundle;
            if (b.includes('15%')) {
              if (!appliedDiscount) appliedDiscount = 'TILE15';
            } else if (b.includes('5%')) {
              if (!appliedDiscount) appliedDiscount = 'TILE5';
            }
          }
        });
      }

      const payableTotalCents = Math.max(0, cart.total_price - bundleDeductionCents);

      // Update free shipping bar (Dynamic context: $49 for Ultra, $70 for Legacy)
      const isUltra = typeof window.__isUltraContext !== 'undefined'
        ? window.__isUltraContext
        : (!window.location.pathname.includes('/products/ear-cleaner') && !window.location.pathname.includes('/products/eyvelle') && !window.location.pathname.includes('/products/metallic-silver'));
      const threshold = isUltra ? 4900 : 7000;
      const textElem = document.getElementById('willaShippingText');
      const fillElem = document.getElementById('willaShippingFill');
      const percent = Math.min(100, Math.max(0, Math.round((payableTotalCents / threshold) * 100)));
      if (fillElem) fillElem.style.width = percent + '%';

      if (textElem) {
        if (payableTotalCents >= threshold) {
          textElem.innerHTML = '🎉 You unlocked <strong>FREE US SHIPPING</strong>!';
        } else {
          const remaining = (Math.max(0, threshold - payableTotalCents) / 100).toFixed(2);
          textElem.innerHTML = 'Add <strong>$' + remaining + '</strong> more to unlock <strong>FREE SHIPPING</strong>!';
        }
      }

      // Update Subtotal & Footer
      const subtotalElem = document.getElementById('willaDrawerSubtotal');
      if (subtotalElem) {
        if (bundleDeductionCents > 0) {
          subtotalElem.innerHTML = '$' + (payableTotalCents / 100).toFixed(2) + ' <span style="font-size:12px;color:#858380;text-decoration:line-through;margin-left:4px;">$' + (cart.total_price / 100).toFixed(2) + '</span>';
        } else {
          subtotalElem.innerText = '$' + (payableTotalCents / 100).toFixed(2);
        }
      }
      const footerElem = document.getElementById('willaCartFooter');
      if (footerElem) footerElem.style.display = cart.item_count > 0 ? 'block' : 'none';

      // Update checkout URL with bundle discount if applicable
      const checkoutBtn = document.querySelector('.willa-checkout-btn');
      if (checkoutBtn) {
        if (appliedDiscount) {
          checkoutBtn.href = '/checkout?discount=' + encodeURIComponent(appliedDiscount);
        } else {
          checkoutBtn.href = '/checkout';
        }
        if (!checkoutBtn._hasFbqTrack) {
          checkoutBtn._hasFbqTrack = true;
          checkoutBtn.addEventListener('click', function() {
            if (window.fbq) {
              try {
                window.fbq('track', 'InitiateCheckout', {
                  num_items: cart.item_count || 1,
                  value: (payableTotalCents || cart.total_price || 0) / 100,
                  currency: 'USD'
                });
              } catch(e) {}
            }
          });
        }
      }

      // Re-render items
      const bodyElem = document.getElementById('willaCartItemsBody');
      if (bodyElem) {
        if (cart.item_count === 0) {
          const emptyCtaUrl = isUltra ? '/products/full-spine-ultra-overnight' : '/';
          const emptyCtaText = isUltra ? 'SHOP ULTRA OVERNIGHT ➔' : 'CONTINUE SHOPPING ➔';
          const emptyDesc = isUltra ? 'Explore FULL-SPINE ULTRA OVERNIGHT™ for leak-free, restful sleep.' : 'Explore our best-selling smart innovations, wellness gear, and daily essentials.';
          const btnStyle = isUltra ? 'style="background-color:var(--uo-plum,#58233D);color:#ffffff !important;"' : '';
          bodyElem.innerHTML = `
            <div class="willa-empty-cart">
              <div class="empty-icon">🛒</div>
              <h3>Your cart is empty</h3>
              <p>${emptyDesc}</p>
              <a href="${emptyCtaUrl}" class="willa-btn-primary" ${btnStyle} onclick="closeWillaCart()">
                ${emptyCtaText}
              </a>
            </div>`;
        } else {
          let html = '';
          cart.items.forEach(item => {
            let payableLineCents = item.final_line_price;
            let bundleBadgeHtml = '';

            if (item.properties && item.properties._bundle) {
              const b = item.properties._bundle;
              if (b.includes('Buy 5 Get 3') || b === 'Buy 5 Get 3 FREE') {
                bundleBadgeHtml = `<div style="display:inline-block;background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px;">🎁 FREE 3 CANS · Pay for 5 · Receive 8 Cans (50g)</div>`;
              } else if (b.includes('Buy 3 Get 1') || b === 'Buy 3 Get 1 FREE') {
                bundleBadgeHtml = `<div style="display:inline-block;background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px;">🎁 FREE 1 CAN · Pay for 3 · Receive 4 Cans (50g)</div>`;
              } else if (b.includes('Buy 2 Get 2') || b === 'Buy 2 Get 2 FREE') {
                bundleBadgeHtml = `<div style="display:inline-block;background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px;">🎁 BUY 2 GET 2 FREE · Extra 10% OFF · 4 Bottles</div>`;
              } else if (b.includes('Buy 4 Get 4') || b === 'Buy 4 Get 4 FREE') {
                bundleBadgeHtml = `<div style="display:inline-block;background:#ecfdf5;color:#047857;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px;">👑 BUY 4 GET 4 FREE · Extra 20% OFF · 8 Bottles</div>`;
              } else if (item.properties.Package) {
                bundleBadgeHtml = `<div style="display:inline-block;background:#f3f4f6;color:#374151;font-size:11px;font-weight:600;padding:2px 6px;border-radius:4px;margin-top:4px;">📦 ${item.properties.Package}</div>`;
              }
            } else if (item.properties && item.properties._upsell) {
              bundleBadgeHtml = `<div style="display:inline-block;background:#fdf2f8;color:#be185d;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px;">✨ Companion: ${item.properties._upsell}</div>`;
            }

            if (item.selling_plan_allocation) {
              bundleBadgeHtml += `<div style="display:inline-block;background:#eff6ff;color:#1d4ed8;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px;margin-left:4px;">🔄 Auto-Ship: Every 30 Days</div>`;
            }

            const itemPrice = payableLineCents < item.final_line_price
              ? `<div><span style="color:#047857;font-weight:700;">$${(payableLineCents / 100).toFixed(2)}</span> <span style="font-size:12px;color:#858380;text-decoration:line-through;margin-left:4px;">$${(item.final_line_price / 100).toFixed(2)}</span></div>`
              : `$${(payableLineCents / 100).toFixed(2)}`;

            const variantText = item.variant_title ? `<div class="cart-item-variant">${item.variant_title}</div>` : '';
            const propText = (item.properties && item.properties._box) 
              ? `<div class="cart-item-prop" style="font-size: 11px; color: #7A6670; margin-top: 2px;">${item.properties._box}</div>` 
              : '';
            html += `
              <div class="willa-cart-item" data-line-key="${item.key}">
                <div class="cart-item-img">
                  <img src="${item.featured_image?.url || item.image}" alt="${item.title}">
                </div>
                <div class="cart-item-details">
                  <div class="cart-item-title-row">
                    <h4>${item.product_title}</h4>
                    <button type="button" class="cart-remove-btn" onclick="willaUpdateLineItem('${item.key}', 0)">&times;</button>
                  </div>
                  ${variantText}
                  ${propText}
                  ${bundleBadgeHtml}
                  <div class="cart-item-bottom-row">
                    <div class="cart-qty-ctrl">
                      <button type="button" onclick="willaUpdateLineItem('${item.key}', ${item.quantity - 1})">-</button>
                      <span>${item.quantity}</span>
                      <button type="button" onclick="willaUpdateLineItem('${item.key}', ${item.quantity + 1})">+</button>
                    </div>
                    <div class="cart-item-price">${itemPrice}</div>
                  </div>
                </div>
              </div>`;
          });
          bodyElem.innerHTML = html;
        }
      }
    } catch (e) {
      console.error('Cart refresh error:', e);
    }
  };

  window.willaUpdateLineItem = async function(key, qty) {
    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: qty })
      });
      await window.willaRefreshCart();
    } catch (e) {
      console.error('Update line item error:', e);
    }
  };

  // Intercept any cart links/buttons across the store to open slide-out drawer
  function initWillaCartInterceptors() {
    document.querySelectorAll('a[href="/cart"], a[href="' + (window.Sakerplus?.routes?.cart_url || '/cart') + '"], .header__icon--cart, .cart-icon-bubble').forEach(el => {
      if (!el.dataset.willaCartBound) {
        el.dataset.willaCartBound = 'true';
        el.addEventListener('click', (e) => {
          e.preventDefault();
          if (typeof window.willaOpenCartDrawer === 'function') {
            window.willaOpenCartDrawer();
          }
        });
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWillaCartInterceptors);
  } else {
    initWillaCartInterceptors();
  }
  window.willaCartGlobalListener = true;

</script>

